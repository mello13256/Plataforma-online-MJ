rules_version = '2';

// Regras de segurança da base de dados.
//
// Permissões de cada autor (campo «permissoes» em /autores/{uid}):
//   publicar        publicar jogos e editar/eliminar os próprios
//   editar_todos    editar jogos de qualquer autor
//   eliminar_todos  eliminar jogos de qualquer autor
//   admin           tudo o que está acima + gerir utilizadores e permissões
// O dono da plataforma (UID abaixo) é sempre administrador e não pode ser removido.
// Visitantes (convidados) veem os jogos publicados e só podem somar +1 ao contador de jogadas.
// Jogos privados só são vistos por administradores e pelo próprio autor.
service cloud.firestore {
  match /databases/{database}/documents {

    function uidDono() {
      return 'PIgsxFjHYDc32oIqh5yD4g7uDmF3';
    }

    function eDono() {
      return request.auth != null && request.auth.uid == uidDono();
    }

    function caminhoPerfil() {
      return /databases/$(database)/documents/autores/$(request.auth.uid);
    }

    function temPerfil() {
      return request.auth != null && exists(caminhoPerfil());
    }

    function permissoes() {
      return get(caminhoPerfil()).data.get('permissoes', {'publicar': true});
    }

    function pode(permissao) {
      return eDono() || (temPerfil()
        && (permissoes().get('admin', false) == true || permissoes().get(permissao, false) == true));
    }

    function textoAte(valor, maximo) {
      return valor is string && valor.size() <= maximo;
    }

    function textoEntre(valor, minimo, maximo) {
      return valor is string && valor.size() >= minimo && valor.size() <= maximo;
    }

    function permissoesValidas(p) {
      return p is map
        && p.keys().hasOnly(['publicar', 'editar_todos', 'eliminar_todos', 'admin'])
        && p.get('publicar', false) is bool
        && p.get('editar_todos', false) is bool
        && p.get('eliminar_todos', false) is bool
        && p.get('admin', false) is bool;
    }

    function perfilValido(a) {
      return a.keys().hasOnly(['nome', 'utilizador', 'permissoes'])
        && textoEntre(a.nome, 1, 40)
        && a.utilizador is string && a.utilizador.matches('^[a-z0-9_.-]{2,30}$')
        && permissoesValidas(a.permissoes);
    }

    // ---------------------------------------------------------------- autores
    match /autores/{uid} {
      allow read: if true;

      // Os perfis são criados pelo administrador (página Administração → Utilizadores).
      // Uma conta sem perfil não tem acesso a nada além do que um convidado vê.
      allow create: if pode('admin') && perfilValido(request.resource.data);

      allow update: if (
          // cada um pode mudar o próprio nome
          request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome'])
          && textoEntre(request.resource.data.nome, 1, 40)
        ) || (
          // o administrador gere nomes e permissões (o dono continua sempre administrador)
          pode('admin') && perfilValido(request.resource.data)
          && (uid != uidDono() || request.resource.data.permissoes.get('admin', false) == true)
        );

      allow delete: if pode('admin') && uid != uidDono();
    }

    // ------------------------------------------------------------------ jogos
    function transferenciaValida(t) {
      return t is map && t.keys().hasOnly(['rotulo', 'url'])
        && textoEntre(t.rotulo, 1, 60)
        && textoAte(t.url, 1000)
        && (t.url.matches('^https?://.+') || t.url.matches('^/transferir/[A-Za-z0-9_-]{8,40}/[^/?#]{1,120}$'));
    }

    function transferenciasValidas(lista) {
      return lista is list && lista.size() <= 5
        && (lista.size() < 1 || transferenciaValida(lista[0]))
        && (lista.size() < 2 || transferenciaValida(lista[1]))
        && (lista.size() < 3 || transferenciaValida(lista[2]))
        && (lista.size() < 4 || transferenciaValida(lista[3]))
        && (lista.size() < 5 || transferenciaValida(lista[4]));
    }

    function caminhoSeguro(valor, padrao) {
      return textoAte(valor, 300) && valor.matches(padrao) && !valor.matches('.*\\.\\..*');
    }

    function jogoValido(j) {
      return j.keys().hasOnly(['titulo', 'descricao', 'instrucoes', 'categoria', 'tipo', 'caminho',
                               'url_externo', 'pacote', 'capa', 'capa_imagem', 'transferencias', 'publicado', 'privado',
                               'jogadas', 'gostos', 'autor_uid', 'criado_em', 'atualizado_em'])
        && textoEntre(j.titulo, 1, 80)
        && textoAte(j.descricao, 5000)
        && textoAte(j.instrucoes, 2000)
        && textoEntre(j.categoria, 1, 40)
        && j.publicado is bool
        && j.get('privado', false) is bool
        && !(j.publicado == true && j.get('privado', false) == true)
        && j.jogadas is int
        && (j.get('capa', null) == null || caminhoSeguro(j.capa, '^(jogos|capas)/[^?#:\\\\]+$'))
        && (j.get('capa_imagem', null) == null || (j.capa_imagem is string && j.capa_imagem.size() <= 600000
              && j.capa_imagem.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$')))
        && transferenciasValidas(j.get('transferencias', []))
        && (
          (j.tipo == 'pacote' && j.caminho == null && j.url_externo == null
            && j.pacote is map && j.pacote.keys().hasOnly(['id', 'entrada'])
            && j.pacote.id is string && j.pacote.id.matches('^[A-Za-z0-9_-]{8,40}$')
            && textoEntre(j.pacote.entrada, 1, 300) && !j.pacote.entrada.matches('.*\\.\\..*'))
          || (j.tipo == 'repositorio' && j.url_externo == null
            && caminhoSeguro(j.caminho, '^jogos/[a-z0-9-]+/[^?#:\\\\]+$'))
          || (j.tipo == 'ligacao' && j.caminho == null && textoAte(j.url_externo, 1000)
            && j.url_externo.matches('^https?://.+'))
          || (j.tipo == 'nenhum' && j.caminho == null && j.url_externo == null
            && j.get('transferencias', []).size() > 0)
        );
    }

    // ---------------------------------------------------------------- pacotes
    // Ficheiros carregados no site (jogos .zip e transferências), partidos em blocos
    // de até 1 MB em /pacotes/{id}/partes/{000..}. Qualquer pessoa os pode ler.
    function caminhoPacote(id) {
      return /databases/$(database)/documents/pacotes/$(id);
    }

    function podeApagarPacote(id) {
      return request.auth != null
        && (get(caminhoPacote(id)).data.dono == request.auth.uid || pode('editar_todos') || pode('eliminar_todos'));
    }

    match /pacotes/{id} {
      allow read: if true;
      allow create: if pode('publicar')
        && id.matches('^[A-Za-z0-9_-]{8,40}$')
        && request.resource.data.keys().hasOnly(['dono', 'partes', 'tamanho', 'nome', 'criado_em'])
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.partes is int && request.resource.data.partes >= 1 && request.resource.data.partes <= 60
        && request.resource.data.tamanho is int && request.resource.data.tamanho <= 52428800
        && textoEntre(request.resource.data.nome, 1, 120)
        && request.resource.data.criado_em == request.time;
      allow delete: if podeApagarPacote(id);

      match /partes/{parte} {
        allow read: if true;
        allow create: if request.auth != null
          && parte.matches('^[0-9]{3}$')
          && get(caminhoPacote(id)).data.dono == request.auth.uid
          && request.resource.data.keys().hasOnly(['dados'])
          && request.resource.data.dados is bytes
          && request.resource.data.dados.size() <= 1000000;
        allow delete: if podeApagarPacote(id);
      }
    }

    // Público: todos. Rascunho: autores. Privado: administradores e o próprio autor.
    // Nota: não usar j.get('privado', false) aqui — nas listagens, o valor por omissão
    // faria passar jogos privados. Só se aceita quando privado é explicitamente false.
    function podeVerDados(j) {
      return j.publicado == true
        || eDono()
        || pode('admin')
        || (temPerfil() && (j.autor_uid == request.auth.uid || j.privado == false));
    }

    function podeVerJogo(slug) {
      return !exists(/databases/$(database)/documents/jogos/$(slug))
        || podeVerDados(get(/databases/$(database)/documents/jogos/$(slug)).data);
    }

    match /jogos/{slug} {
      // resource == null: confirmar que um endereço ainda está livre ao criar um jogo.
      allow read: if resource == null || podeVerDados(resource.data);

      allow create: if pode('publicar')
        && slug.matches('^[a-z0-9-]{1,70}$')
        && jogoValido(request.resource.data)
        && request.resource.data.autor_uid == request.auth.uid
        && request.resource.data.jogadas == 0
        && request.resource.data.get('gostos', 0) == 0
        && request.resource.data.criado_em == request.time
        && request.resource.data.atualizado_em == request.time;

      allow update: if (
          ((pode('publicar') && resource.data.autor_uid == request.auth.uid) || pode('editar_todos'))
          && jogoValido(request.resource.data)
          && request.resource.data.autor_uid == resource.data.autor_uid
          && request.resource.data.criado_em == resource.data.criado_em
          && request.resource.data.jogadas == resource.data.jogadas
          && request.resource.data.get('gostos', 0) == resource.data.get('gostos', 0)
          && request.resource.data.atualizado_em == request.time
        ) || (
          resource.data.publicado == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jogadas'])
          && request.resource.data.jogadas == resource.data.jogadas + 1
        ) || (
          resource.data.publicado == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gostos'])
          && request.resource.data.gostos is int
          && (request.resource.data.gostos == resource.data.get('gostos', 0) + 1
              || (request.resource.data.gostos == resource.data.get('gostos', 0) - 1 && request.resource.data.gostos >= 0))
        );

      allow delete: if (pode('publicar') && resource.data.autor_uid == request.auth.uid)
        || pode('eliminar_todos');

      // Comentários: qualquer pessoa comenta jogos publicados; o autor do jogo e
      // os administradores/moderadores apagam.
      match /comentarios/{comentario} {
        allow read: if podeVerJogo(slug);
        allow create: if get(/databases/$(database)/documents/jogos/$(slug)).data.publicado == true
          && request.resource.data.keys().hasOnly(['nome', 'texto', 'uid', 'criado_em'])
          && textoEntre(request.resource.data.nome, 1, 40)
          && textoEntre(request.resource.data.texto, 1, 1000)
          && request.resource.data.criado_em == request.time
          && (request.resource.data.get('uid', null) == null
              || (request.auth != null && request.resource.data.uid == request.auth.uid));
        allow delete: if pode('eliminar_todos')
          || (pode('publicar') && get(/databases/$(database)/documents/jogos/$(slug)).data.autor_uid == request.auth.uid);
      }
    }

    // ---------------------------------------------------------------- galerias
    // Imagens extra de cada jogo (até 4), editadas por quem pode editar o jogo.
    function imagemValida(lista, i) {
      return lista.size() <= i || (lista[i] is string && lista[i].size() <= 300000
        && lista[i].matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$'));
    }

    function podeEditarJogo(slug) {
      return (pode('publicar') && get(/databases/$(database)/documents/jogos/$(slug)).data.autor_uid == request.auth.uid)
        || pode('editar_todos');
    }

    match /galerias/{slug} {
      allow read: if podeVerJogo(slug);
      allow create, update: if podeEditarJogo(slug)
        && request.resource.data.keys().hasOnly(['imagens'])
        && request.resource.data.imagens is list && request.resource.data.imagens.size() <= 4
        && imagemValida(request.resource.data.imagens, 0) && imagemValida(request.resource.data.imagens, 1)
        && imagemValida(request.resource.data.imagens, 2) && imagemValida(request.resource.data.imagens, 3);
      allow delete: if podeEditarJogo(slug) || pode('eliminar_todos');
    }
  }
}
