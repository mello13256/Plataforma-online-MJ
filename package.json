{
  "name": "plataforma-online-mj",
  "version": "1.0.0",
  "description": "Plataforma de jogos online em português de Portugal, alojada no Firebase.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preparar": "node scripts/preparar-site.mjs",
    "local": "npm run preparar && firebase emulators:start --project demo-jogos-mj",
    "test": "firebase emulators:exec --only firestore --project demo-jogos-mj \"node --test test/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "adm-zip": "^0.6.1",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1"
  }
}
