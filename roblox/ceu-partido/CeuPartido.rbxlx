			A("leve2", 1.4, 0.68, 0.8, { alcance = 19, arco = 140, mult = 0.9, peso = 0, avanco = { 0.4, 0.6, 11 }, combo = "forte", probCombo = 0.5 }),
			A("forte", 2.0, 1.12, 1.24, { alcance = 19, arco = 60, mult = 1.5, equil = 60, tipo = "derrubar", area = { dist = 15, raio = 10 } }),
