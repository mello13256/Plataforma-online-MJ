      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Dados</string>
          <string name="Source"><![CDATA[--!strict
-- Gravação do progresso de cada jogador (DataStore). Sem acesso à API (ex.: Studio sem permissão),
-- o jogo continua a funcionar, mas o progresso só dura a sessão.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Compartilhado"):WaitForChild("Config"))

export type Progresso = {
	versao: number,
	nivel: number,
	vigor: number,
	folego: number,
	forca: number,
	eter: number,
	orvalhoMax: number,
	armas: { string },
	arma: string,
	farois: { string },
	ultimoFarol: string?,
	relicarios: { string },
	chefes: { string },
	eco: { x: number, y: number, z: number, qtd: number }?,
}

local Dados = {}

local loja: DataStore? = nil
local okLoja, erroLoja = pcall(function()
	loja = DataStoreService:GetDataStore("CeuPartido_v1")
end)
if not okLoja then
	warn("[Céu Partido] DataStore indisponível; o progresso não será guardado:", erroLoja)
end

function Dados.novo(): Progresso
	return {
		versao = Config.VERSAO,
		nivel = 1,
		vigor = 10,
		folego = 10,
		forca = 10,
		eter = 0,
		orvalhoMax = Config.JOGADOR.orvalhoInicial,
		armas = { Config.ARMA_INICIAL },
		arma = Config.ARMA_INICIAL,
		farois = {},
		ultimoFarol = nil,
		relicarios = {},
		chefes = {},
		eco = nil,
	}
end

local function chave(userId: number): string
	return "J_" .. tostring(userId)
end

function Dados.carregar(userId: number): Progresso
	local base = Dados.novo()
	local l = loja
	if not l then
		return base
	end
	for tentativa = 1, 3 do
		local ok, valor = pcall(function()
			return l:GetAsync(chave(userId))
		end)
		if ok then
			if type(valor) == "table" then
				for k, v in valor do
					(base :: any)[k] = v
				end
			end
			return base
		end
		warn("[Céu Partido] falha ao carregar (tentativa " .. tentativa .. "):", valor)
		task.wait(1)
	end
	return base
end

function Dados.guardar(userId: number, p: Progresso)
	local l = loja
	if not l then
		return
	end
	local ok, erro = pcall(function()
		l:SetAsync(chave(userId), p)
	end)
	if not ok then
		warn("[Céu Partido] falha ao guardar:", erro)
	end
end

return Dados
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Inimigos</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Inimigos e chefes: criação, inteligência (perseguir, rondar, atacar), golpes, áreas, projéteis,
-- raios, equilíbrio, morte, regresso ao descansar e arenas com barreira de vento.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Compartilhado"):WaitForChild("Config"))
local Mundo = require(script.Parent:WaitForChild("Mundo"))
local Personagens = require(script.Parent:WaitForChild("Personagens"))

local Inimigos = {}
local ctx
local lista = {}
Inimigos.lista = lista
local pasta
local arenas = {}
local efeitosAtivos: { any } = {} -- ondas de choque e projéteis em curso

local GRAUS = math.pi / 180
local RAIO_JOGADOR = 1.5

local function agora()
	return os.clock()
end

local function plano(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function angDif(a, b)
	local d = b - a
	while d > math.pi do
		d -= math.pi * 2
	end
	while d < -math.pi do
		d += math.pi * 2
	end
	return d
end

local function anguloDe(v)
	return math.atan2(-v.X, -v.Z) -- ângulo de rotação Y para olhar na direção v (Roblox olha para -Z)
end

local function efeito(...)
	ctx.remotos.Efeito:FireAllClients(...)
end

-- ---------------------------------------------------------------- criação

local function definirAcao(ini, nome, dur, manter)
	local m = ini.modelo
	if not m then
		return
	end
	m:SetAttribute("AcaoDur", dur)
	m:SetAttribute("AcaoManter", manter == true)
	m:SetAttribute("AcaoT0", workspace:GetServerTimeNow())
	m:SetAttribute("Acao", nome)
end

local function mudar(ini, estado, dur)
	ini.estado = estado
	ini.inicio = agora()
	ini.estadoAte = agora() + (dur or math.huge)
end

local function construir(ini)
	local d = ini.def
	local modelo = Personagens.criarInimigo(d.tipo)
	local raiz = modelo:FindFirstChild("HumanoidRootPart")
	local hum = modelo:FindFirstChildOfClass("Humanoid")
	modelo.PrimaryPart = raiz
	local chao = Mundo.chaoOuIlha(d.x, d.z)
	local altura = hum.HipHeight + raiz.Size.Y / 2
	modelo:PivotTo(CFrame.new(chao + Vector3.new(0, altura + 0.2, 0)) * CFrame.Angles(0, math.rad(d.rot or 0), 0))
	local anexo = Instance.new("Attachment")
	anexo.Name = "Alinhar"
	anexo.Parent = raiz
	local alinhar = Instance.new("AlignOrientation")
	alinhar.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alinhar.Attachment0 = anexo
	alinhar.RigidityEnabled = false
	alinhar.MaxTorque = math.huge
	alinhar.Responsiveness = 25
	alinhar.CFrame = CFrame.Angles(0, math.rad(d.rot or 0), 0)
	alinhar.Parent = raiz
	modelo:SetAttribute("VidaMax", ini.vidaMax)
	modelo:SetAttribute("Vida", ini.vidaMax)
	modelo:SetAttribute("Chefe", ini.chefe ~= nil)
	modelo.Parent = pasta
	pcall(function()
		raiz:SetNetworkOwner(nil)
	end)
	ini.modelo = modelo
	ini.raiz = raiz
	ini.hum = hum
	ini.alinhar = alinhar
	ini.casa = chao
	ini.ilha = Mundo.ilhaEm(chao)
end

local function repor(ini)
	if ini.modelo then
		ini.modelo:Destroy()
	end
	ini.vidaMax = ini.cfg.vida
	ini.vida = ini.cfg.vida
	ini.equil = ini.cfg.equilMax
	ini.tSemDano = 0
	ini.vivo = true
	ini.fase = 1
	ini.alvo = nil
	ini.ataque = nil
	ini.espera = 0
	ini.golpeadores = {}
	ini.ultimoAtaque = nil
	ini.morteT = nil
	construir(ini)
	if ini.chefe then
		mudar(ini, "aguardar")
		definirAcao(ini, "sentado", 2, true)
	elseif ini.def.sentado then
		mudar(ini, "sentado")
		definirAcao(ini, "sentado", 2, true)
	else
		mudar(ini, "ocioso")
	end
end

-- ---------------------------------------------------------------- utilitários de alvo

local function jogadorVivo(plr)
	local c = plr.Character
	if not c then
		return nil
	end
	local hum = c:FindFirstChildOfClass("Humanoid")
	local raiz = c:FindFirstChild("HumanoidRootPart")
	if not hum or not raiz or hum.Health <= 0 then
		return nil
	end
	return raiz
end

local function candidatos(ini)
	-- os chefes só lutam com quem está na arena
	if ini.chefe then
		local r = {}
		for plr in arenas[ini.chefe].participantes do
			table.insert(r, plr)
		end
		return r
	end
	return game:GetService("Players"):GetPlayers()
end

local function escolherAlvo(ini)
	local melhor, md = nil, math.huge
	for _, plr in candidatos(ini) do
		local raiz = jogadorVivo(plr)
		local est = ctx.jogadores.estados[plr]
		if raiz and est and est.estado ~= "sentado" then
			local delta = raiz.Position - ini.raiz.Position
			local d = plano(delta).Magnitude
			if math.abs(delta.Y) < 40 + ini.cfg.escala * 5 and d < md then
				-- só vê o jogador à frente, ou muito perto, ou se já estiver alerta
				local ang = math.abs(angDif(anguloDe(ini.raiz.CFrame.LookVector), anguloDe(delta)))
				if ini.alvo == plr or ini.chefe or d < 18 or (d < ini.cfg.visao and ang < 80 * GRAUS) then
					melhor, md = plr, d
				end
			end
		end
	end
	return melhor, md
end

local function olharPara(ini, pos)
	local v = plano(pos - ini.raiz.Position)
	if v.Magnitude > 0.05 then
		ini.alinhar.CFrame = CFrame.lookAt(Vector3.zero, v.Unit)
	end
end

local function limitarIlha(ini, p)
	local ilha = ini.ilha
	if not ilha then
		return p
	end
	local c = Vector3.new(ilha.centro.X, p.Y, ilha.centro.Z)
	local v = p - c
	local max = ilha.raio * 0.82
	if ini.chefe then
		local a = Config.ARENAS[ini.chefe]
		c = Vector3.new(a.centro.X, p.Y, a.centro.Z)
		v = p - c
		max = a.raio - 6
	end
	if v.Magnitude > max then
		return c + v.Unit * max
	end
	return p
end

local function moverPara(ini, pos, vel)
	ini.hum.WalkSpeed = vel
	ini.hum:MoveTo(limitarIlha(ini, pos))
end

local function parar(ini)
	ini.hum.WalkSpeed = 0
	ini.hum:Move(Vector3.zero)
end

-- ---------------------------------------------------------------- ataques

local function escolherAtaque(ini, dist)
	local validos = {}
	local total = 0
	for _, a in ini.cfg.ataques do
		local maxD = math.max(a.distMax or 0, a.alcance + ini.cfg.raio * 0.5)
		if a.peso > 0 and dist >= (a.distMin or 0) and dist <= maxD then
			local p = a.peso * (if a == ini.ultimoAtaque then 0.4 else 1)
			table.insert(validos, { a, p })
			total += p
		end
	end
	if #validos == 0 then
		return nil
	end
	local r = math.random() * total
	for _, v in validos do
		r -= v[2]
		if r <= 0 then
			return v[1]
		end
	end
	return validos[1][1]
end

local function iniciarAtaque(ini, def)
	local vel = if ini.fase == 2 then 1.18 else 1
	ini.ultimoAtaque = def
	ini.ataque = { def = def, dur = def.dur / vel, ini = def.ini / vel, fim = def.fim / vel, golpeados = {}, areaFeita = false, salto = false, avisos = nil }
	mudar(ini, "atacar")
	definirAcao(ini, def.anim, ini.ataque.dur)
	-- raios: marca o chão por baixo de cada alvo antes de cair
	if def.raio then
		local posicoes = {}
		for _, plr in candidatos(ini) do
			local raiz = jogadorVivo(plr)
			if raiz then
				local p = Mundo.chaoOuIlha(raiz.Position.X, raiz.Position.Z)
				table.insert(posicoes, p)
				efeito("aviso", p, 9, ini.ataque.ini)
				if ini.fase == 2 then
					local extra = p + Vector3.new(math.random(-14, 14), 0, math.random(-14, 14))
					extra = Mundo.chaoOuIlha(extra.X, extra.Z)
					table.insert(posicoes, extra)
					efeito("aviso", extra, 9, ini.ataque.ini)
				end
			end
		end
		ini.ataque.avisos = posicoes
	end
end

local function danoA(ini, plr, mult, tipo, origem, elemento)
	local d = ini.ataque and ini.ataque.def
	local dano = ini.cfg.dano * mult * (if ini.fase == 2 then 1.15 else 1)
	return ctx.jogadores.receberDano(plr, dano, origem, { equil = d and d.equil or 30, tipo = tipo, elemento = elemento })
end

local function ondaDeChoque(ini, centro, raioMax, dur, mult, elemento)
	table.insert(efeitosAtivos, { tipo = "onda", ini = ini, centro = centro, raioMax = raioMax, dur = dur, t0 = agora(), atingidos = {}, mult = mult, elemento = elemento })
	efeito("anel", centro, raioMax, dur, elemento)
end

local function lancarProjetil(ini, alvoPos)
	local mao = ini.modelo:FindFirstChild("RightHand")
	local origem = if mao then mao.Position else ini.raiz.Position + Vector3.new(0, 8, 0)
	local pedra = Instance.new("Part")
	pedra.Shape = Enum.PartType.Ball
	pedra.Size = Vector3.new(5, 5, 5)
	pedra.Material = Enum.Material.Slate
	pedra.Color = Color3.fromRGB(110, 104, 96)
	pedra.Anchored = true
	pedra.CanCollide = false
	pedra.Position = origem
	pedra.Parent = workspace
	table.insert(efeitosAtivos, { tipo = "projetil", ini = ini, parte = pedra, de = origem, para = alvoPos, dur = 0.95, t0 = agora() })
end

local function verificarGolpe(ini)
	local at = ini.ataque
	local d = at.def
	local frente = plano(ini.raiz.CFrame.LookVector).Unit
	-- ataques de área (impacto no chão)
	if d.area and not at.areaFeita then
		at.areaFeita = true
		local centro = ini.raiz.Position + frente * d.area.dist
		centro = Mundo.chaoOuIlha(centro.X, centro.Z)
		efeito("onda", centro, d.area.raio, "pedra")
		efeito("tremor", centro, if ini.chefe then 0.8 else 0.4)
		for _, plr in candidatos(ini) do
			local raiz = jogadorVivo(plr)
			if raiz and plano(raiz.Position - centro).Magnitude < d.area.raio + RAIO_JOGADOR and math.abs(raiz.Position.Y - centro.Y) < 12 then
				danoA(ini, plr, d.mult, d.tipo or "normal", centro)
			end
		end
		if ini.fase == 2 and ini.cfg.estilo == "tempestor" then
			ondaDeChoque(ini, centro, 34, 1.0, 0.45, "raio")
		end
		return
	end
	if d.projetil and not at.areaFeita then
		at.areaFeita = true
		if ini.alvo then
			local raiz = jogadorVivo(ini.alvo)
			if raiz then
				lancarProjetil(ini, raiz.Position + plano(raiz.AssemblyLinearVelocity) * 0.5)
			end
		end
		return
	end
	if d.raio and not at.areaFeita then
		at.areaFeita = true
		for _, p in at.avisos or {} do
			efeito("raio", p)
			for _, plr in candidatos(ini) do
				local raiz = jogadorVivo(plr)
				if raiz and plano(raiz.Position - p).Magnitude < 9 + RAIO_JOGADOR then
					danoA(ini, plr, d.mult, "normal", p + Vector3.new(0, 30, 0), "raio")
				end
			end
		end
		return
	end
	for _, plr in candidatos(ini) do
		if not at.golpeados[plr] then
			local raiz = jogadorVivo(plr)
			if raiz then
				local delta = plano(raiz.Position - ini.raiz.Position)
				local dist = delta.Magnitude
				if dist - RAIO_JOGADOR <= d.alcance and math.abs(raiz.Position.Y - ini.raiz.Position.Y) < 8 + ini.cfg.escala * 3 then
					local ang = if dist > 0.01 then math.acos(math.clamp(delta.Unit:Dot(frente), -1, 1)) else 0
					if d.arco >= 360 or ang <= d.arco / 2 * GRAUS or dist < ini.cfg.raio + 1 then
						local r = danoA(ini, plr, d.mult, d.tipo or "normal", ini.raiz.Position, if ini.fase == 2 then "raio" else nil)
						if r ~= "esquivou" then
							at.golpeados[plr] = true
						end
					end
				end
			end
		end
	end
end

-- ---------------------------------------------------------------- ciclo de cada inimigo

local function despertar(ini)
	if ini.estado == "aguardar" or ini.estado == "sentado" then
		mudar(ini, "levantar", if ini.chefe then 2.2 else 1.1)
		definirAcao(ini, if ini.chefe then "rugido" else "levantar", if ini.chefe then 2.2 else 1.1)
	end
end
Inimigos.despertar = despertar

local function atualizarInimigo(ini, dt)
	local t = agora()
	local cfg = ini.cfg
	if not ini.vivo then
		return
	end
	ini.tSemDano += dt
	if ini.tSemDano > 3 then
		ini.equil = math.min(cfg.equilMax, ini.equil + dt * cfg.equilMax * 0.3)
	end
	-- caiu da ilha: volta a casa
	if ini.raiz.Position.Y < Config.ALTURA_QUEDA then
		repor(ini)
		return
	end
	local alvo, dist = escolherAlvo(ini)
	local raizAlvo = alvo and jogadorVivo(alvo)
	local longeCasa = plano(ini.raiz.Position - ini.casa).Magnitude
	local estado = ini.estado

	if estado == "aguardar" then
		parar(ini)
	elseif estado == "sentado" then
		parar(ini)
		if raizAlvo and dist < 18 then
			despertar(ini)
		end
	elseif estado == "levantar" then
		parar(ini)
		if t >= ini.estadoAte then
			ini.alvo = alvo
			mudar(ini, "perseguir")
		end
	elseif estado == "ocioso" then
		if raizAlvo then
			ini.alvo = alvo
			mudar(ini, "perseguir")
			ini.espera = 0.4 + math.random() * 0.6
			efeito("grito", ini.raiz.Position, cfg.estilo)
			-- os vizinhos também acordam
			for _, o in lista do
				if o ~= ini and o.vivo and not o.chefe and (o.estado == "ocioso" or o.estado == "sentado") and plano(o.raiz.Position - ini.raiz.Position).Magnitude < 40 then
					o.alvo = alvo
					if o.estado == "sentado" then
						despertar(o)
					else
						mudar(o, "perseguir")
					end
				end
			end
		else
			ini.espera -= dt
			if ini.espera <= 0 then
				ini.espera = 3 + math.random() * 4
				if math.random() < 0.5 then
					ini.ronda = ini.casa + Vector3.new(math.random(-20, 20), 0, math.random(-20, 20))
				else
					ini.ronda = nil
				end
			end
			if ini.ronda and plano(ini.ronda - ini.raiz.Position).Magnitude > 3 then
				moverPara(ini, ini.ronda, cfg.vel * 0.6)
				olharPara(ini, ini.ronda)
			else
				parar(ini)
			end
		end
	elseif estado == "perseguir" or estado == "rondar" then
		if not raizAlvo or (not ini.chefe and longeCasa > 160) then
			ini.alvo = nil
			mudar(ini, "regressar")
		else
			ini.alvo = alvo
			olharPara(ini, raizAlvo.Position)
			ini.espera -= dt
			if estado == "perseguir" then
				local at = escolherAtaque(ini, dist)
				local frente = plano(ini.raiz.CFrame.LookVector).Unit
				local paraAlvo = plano(raizAlvo.Position - ini.raiz.Position).Unit
				if at and ini.espera <= 0 and frente:Dot(paraAlvo) > 0.8 then
					iniciarAtaque(ini, at)
				else
					local ideal = cfg.raio + 6
					if dist > ideal then
						moverPara(ini, raizAlvo.Position, if dist > 30 then cfg.corrida else cfg.vel * 1.4)
					else
						parar(ini)
					end
				end
			else -- rondar: andar de lado à volta do alvo
				local ideal = cfg.raio + 12
				local radial = plano(ini.raiz.Position - raizAlvo.Position).Unit
				local lado = Vector3.new(-radial.Z, 0, radial.X) * ini.ladoRonda
				local desejo = raizAlvo.Position + radial * ideal + lado * 10
				moverPara(ini, desejo, cfg.vel * 0.8)
				if t >= ini.estadoAte then
					mudar(ini, "perseguir")
				end
			end
		end
	elseif estado == "atacar" then
		local at = ini.ataque
		local d = at.def
		local tt = t - ini.inicio
		local tn = tt / at.dur
		if raizAlvo and tt < at.ini * 0.8 then
			olharPara(ini, raizAlvo.Position)
		end
		-- avanço durante o golpe
		local av = d.avanco
		if av and tn >= av[1] and tn <= av[2] then
			local frente = plano(ini.raiz.CFrame.LookVector).Unit
			if d.avancoAlvo then
				if not at.salto then
					at.salto = true
					local janela = (av[2] - av[1]) * at.dur
					local destino = if raizAlvo then raizAlvo.Position else ini.raiz.Position + frente * 20
					local distH = math.max(0, plano(destino - ini.raiz.Position).Magnitude - cfg.raio - (if d.area then d.area.dist * 0.5 else 2))
					local vh = math.min(90, distH / janela)
					local vy = workspace.Gravity * janela / 2
					ini.hum.WalkSpeed = 0
					ini.raiz.AssemblyLinearVelocity = frente * vh + Vector3.new(0, vy, 0)
				end
			else
				local perto = raizAlvo and plano(raizAlvo.Position - ini.raiz.Position).Magnitude < cfg.raio + 2
				ini.hum.WalkSpeed = if perto then 0 else av[3]
				ini.hum:Move(frente)
			end
		else
			parar(ini)
		end
		if tt >= at.ini and tt <= at.fim then
			verificarGolpe(ini)
		end
		if tt >= at.dur then
			local proximo = nil
			if d.combo and math.random() < (d.probCombo or 0) * (if ini.fase == 2 then 1.4 else 1) and dist and dist < 30 then
				for _, a in cfg.ataques do
					if a.anim == d.combo then
						proximo = a
					end
				end
			end
			if proximo then
				iniciarAtaque(ini, proximo)
			else
				ini.ataque = nil
				ini.ladoRonda = if math.random() < 0.5 then -1 else 1
				ini.espera = (0.3 + math.random() * 0.9) * (if ini.fase == 2 then 0.6 else 1)
				if ini.chefe and math.random() < 0.5 then
					mudar(ini, "perseguir")
				else
					mudar(ini, "rondar", 0.6 + math.random() * 1.2)
				end
			end
		end
	elseif estado == "atordoado" or estado == "golpeado" then
		parar(ini)
		if t >= ini.estadoAte then
			mudar(ini, "perseguir")
		end
	elseif estado == "transformar" then
		parar(ini)
		if not ini.ondaFase and t - ini.inicio > 0.9 then
			ini.ondaFase = true
			efeito("tremor", ini.raiz.Position, 1)
			ondaDeChoque(ini, Mundo.chaoOuIlha(ini.raiz.Position.X, ini.raiz.Position.Z), 40, 0.9, 0.4, "raio")
			local gume = ini.modelo:FindFirstChild("Gume", true)
			if gume and gume:IsA("BasePart") then
				gume.Color = Color3.fromRGB(200, 240, 255)
				gume.Size = gume.Size * Vector3.new(2.2, 1.5, 1)
			end
			local f = ini.modelo:FindFirstChild("Faiscas", true)
			if f and f:IsA("ParticleEmitter") then
				f.Rate = 60
			end
		end
		if t >= ini.estadoAte then
			mudar(ini, "perseguir")
		end
	elseif estado == "regressar" then
		if raizAlvo and dist < 25 and longeCasa < 100 then
			ini.alvo = alvo
			mudar(ini, "perseguir")
		elseif longeCasa < 4 then
			ini.vida = ini.vidaMax
			ini.modelo:SetAttribute("Vida", ini.vida)
			mudar(ini, "ocioso")
		else
			moverPara(ini, ini.casa, cfg.vel * 1.3)
			olharPara(ini, ini.casa)
			ini.vida = math.min(ini.vidaMax, ini.vida + ini.vidaMax * 0.15 * dt)
			ini.modelo:SetAttribute("Vida", ini.vida)
		end
	end
end

-- ---------------------------------------------------------------- dano recebido e morte

local function morrer(ini)
	ini.vivo = false
	ini.morteT = agora()
	mudar(ini, "morto")
	definirAcao(ini, "morrer", 1.4, true)
	parar(ini)
	ini.modelo:SetAttribute("Vida", 0)
	local pos = ini.raiz.Position
	efeito("morte", pos, ini.cfg.estilo)
	-- todos os que ajudaram (e estão perto) recebem o Éter
	for plr in ini.golpeadores do
		local raiz = jogadorVivo(plr)
		if raiz and (raiz.Position - pos).Magnitude < 200 then
			ctx.jogadores.darEter(plr, ini.cfg.eter, pos)
		end
	end
	if ini.chefe then
		local arena = arenas[ini.chefe]
		arena.derrotado = true
		arena.ativa = false
		Mundo.abrirBarreira(ini.chefe, true)
		local final = ini.chefe == "tempestor"
		for plr in arena.participantes do
			ctx.jogadores.registarChefe(plr, ini.chefe)
			ctx.remotos.Chefe:FireClient(plr, nil)
			ctx.jogadores.aviso(plr, if final then "final" else "chefe", ini.cfg.nome)
		end
		arena.participantes = {}
	end
	-- desfaz-se em vento
	local modelo = ini.modelo
	task.delay(1.8, function()
		if not modelo.Parent then
			return
		end
		for _, p in modelo:GetDescendants() do
			if p:IsA("BasePart") and p.Transparency < 1 then
				TweenService:Create(p, TweenInfo.new(1.2), { Transparency = 1 }):Play()
			end
		end
	end)
	task.delay(3.2, function()
		if modelo.Parent then
			modelo:Destroy()
		end
		if ini.modelo == modelo then
			ini.modelo = nil
		end
	end)
end

function Inimigos.receberDano(ini, dano, equilDano, plr, forte)
	if not ini.vivo then
		return
	end
	local cfg = ini.cfg
	ini.golpeadores[plr] = true
	if not ini.alvo then
		ini.alvo = plr
	end
	if ini.estado == "sentado" or ini.estado == "ocioso" or ini.estado == "regressar" then
		mudar(ini, "perseguir")
	end
	local pos = ini.raiz.Position + Vector3.new(0, 2 * cfg.escala, 0)
	-- as sentinelas bloqueiam golpes de frente quando não estão a atacar
	local bloqueou = false
	if cfg.escudo and (ini.estado == "rondar" or ini.estado == "perseguir") and math.random() < 0.45 then
		local raizJ = jogadorVivo(plr)
		if raizJ then
			local v = plano(raizJ.Position - ini.raiz.Position).Unit
			if v:Dot(plano(ini.raiz.CFrame.LookVector).Unit) > 0.5 then
				bloqueou = true
				dano *= 0.18
				equilDano *= 0.4
				ctx.jogadores.gastarEnergia(plr, 10)
				efeito("faisca", pos)
			end
		end
	end
	if not bloqueou then
		efeito("golpe", pos, if cfg.estilo == "sentinela" or cfg.estilo == "guardiao" then "pedra" elseif cfg.estilo == "espectro" then "vento" else "eter")
	end
	ini.vida -= dano
	ini.tSemDano = 0
	ini.modelo:SetAttribute("Vida", math.max(0, ini.vida))
	ini.modelo:SetAttribute("UltimoDano", workspace:GetServerTimeNow())
	ini.modelo:SetAttribute("DanoRecente", math.floor(dano + 0.5))
	if ini.vida <= 0 then
		morrer(ini)
		return
	end
	-- segunda fase do Tempestor
	if cfg.estilo == "tempestor" and ini.fase == 1 and ini.vida < ini.vidaMax * 0.5 then
		ini.fase = 2
		ini.ondaFase = false
		ini.ataque = nil
		mudar(ini, "transformar", 2.4)
		definirAcao(ini, "rugido", 2.4)
		for p in arenas[ini.chefe].participantes do
			ctx.jogadores.aviso(p, "texto", "O Coração Partido desperta a tempestade")
		end
		return
	end
	if bloqueou then
		return
	end
	ini.equil -= equilDano
	local emGolpe = ini.estado == "atacar" and ini.ataque and agora() - ini.inicio >= ini.ataque.ini * 0.7
	if ini.equil <= 0 then
		ini.equil = cfg.equilMax
		ini.ataque = nil
		local dur = if ini.chefe then 2.2 else 1.3
		mudar(ini, "atordoado", dur)
		definirAcao(ini, "atordoado", dur)
	elseif not cfg.hiperArmadura and not emGolpe then
		ini.ataque = nil
		mudar(ini, "golpeado", 0.4)
		definirAcao(ini, "golpeado", 0.4)
	end
end

-- algum inimigo vivo está a perseguir alguém perto deste ponto?
function Inimigos.ameacaPerto(pos, raio)
	for _, ini in lista do
		if ini.vivo and ini.raiz and ini.alvo and (ini.estado == "perseguir" or ini.estado == "rondar" or ini.estado == "atacar")
			and (ini.raiz.Position - pos).Magnitude < raio then
			return true
		end
	end
	return false
end

-- ao descansar: os mortos regressam e os que não estão a combater voltam ao seu posto
function Inimigos.reporMortos()
	for _, ini in lista do
		if not ini.chefe then
			local emCombate = ini.vivo and ini.alvo ~= nil and (ini.estado == "perseguir" or ini.estado == "rondar" or ini.estado == "atacar")
			if not emCombate then
				repor(ini)
			end
		end
	end
end

-- ---------------------------------------------------------------- arenas

local function escalarChefe(arena)
	local ini = arena.chefe
	if not ini or not ini.vivo then
		return
	end
	local n = 0
	for _ in arena.participantes do
		n += 1
	end
	local novoMax = ini.cfg.vida * (1 + 0.6 * math.max(0, n - 1))
	if novoMax > ini.vidaMax then
		local prop = ini.vida / ini.vidaMax
		ini.vidaMax = novoMax
		ini.vida = novoMax * prop
		ini.modelo:SetAttribute("VidaMax", novoMax)
		ini.modelo:SetAttribute("Vida", ini.vida)
	end
end

function Inimigos.entrarArena(plr, id)
	local arena = arenas[id]
	local b = Mundo.barreiras[id]
	if not arena or not b or arena.derrotado then
		return
	end
	local c = plr.Character
	if not c then
		return
	end
	local n = 0
	for _ in arena.participantes do
		n += 1
	end
	if n >= Config.MAX_JOGADORES_CHEFE then
		ctx.jogadores.aviso(plr, "texto", "A arena já está cheia")
		return
	end
	c:PivotTo(CFrame.lookAt(b.dentro, b.dentro - Config.ARENAS[id].normal))
	ctx.remotos.Efeito:FireAllClients("nevoeiro", b.dentro)
	arena.participantes[plr] = true
	local chefe = arena.chefe
	if chefe and chefe.vivo then
		if not arena.ativa then
			arena.ativa = true
			despertar(chefe)
		end
		escalarChefe(arena)
		ctx.remotos.Chefe:FireClient(plr, chefe.modelo)
	end
end

function Inimigos.sairArena(plr)
	for _, arena in arenas do
		if arena.participantes[plr] then
			arena.participantes[plr] = nil
			ctx.remotos.Chefe:FireClient(plr, nil)
		end
	end
end

local function atualizarArenas()
	for id, arena in arenas do
		local a = Config.ARENAS[id]
		for plr in arena.participantes do
			local raiz = jogadorVivo(plr)
			if not raiz or plano(raiz.Position - a.centro).Magnitude > a.raio + 20 then
				arena.participantes[plr] = nil
				if plr.Parent then
					ctx.remotos.Chefe:FireClient(plr, nil)
				end
			end
		end
		if arena.ativa and next(arena.participantes) == nil then
			-- toda a gente morreu ou saiu: o chefe recompõe-se
			arena.ativa = false
			if arena.chefe then
				repor(arena.chefe)
			end
		end
	end
end

-- ---------------------------------------------------------------- efeitos em curso (ondas e projéteis)

local function atualizarEfeitos()
	local t = agora()
	for i = #efeitosAtivos, 1, -1 do
		local e = efeitosAtivos[i]
		local k = math.min(1, (t - e.t0) / e.dur)
		if e.tipo == "onda" then
			local r = e.raioMax * (1 - (1 - k) ^ 2)
			for _, plr in candidatos(e.ini) do
				if not e.atingidos[plr] then
					local raiz = jogadorVivo(plr)
					if raiz then
						local d = plano(raiz.Position - e.centro).Magnitude
						if math.abs(d - r) < 2.5 and r > 3 and math.abs(raiz.Position.Y - e.centro.Y) < 6 then
							e.atingidos[plr] = true
							local dano = e.ini.cfg.dano * e.mult
							ctx.jogadores.receberDano(plr, dano, e.centro, { equil = 40, tipo = "normal", elemento = e.elemento })
						end
					end
				end
			end
		elseif e.tipo == "projetil" then
			local p = e.de:Lerp(e.para, k) + Vector3.new(0, math.sin(k * math.pi) * 25, 0)
			e.parte.Position = p
			if k >= 1 then
				e.parte:Destroy()
				efeito("onda", e.para, 8, "pedra")
				efeito("tremor", e.para, 0.5)
				for _, plr in candidatos(e.ini) do
					local raiz = jogadorVivo(plr)
					if raiz and (raiz.Position - e.para).Magnitude < 8 + RAIO_JOGADOR then
						ctx.jogadores.receberDano(plr, e.ini.cfg.dano * 1.1, e.para, { equil = 50, tipo = "derrubar" })
					end
				end
			end
		end
		if k >= 1 then
			table.remove(efeitosAtivos, i)
		end
	end
end

-- ---------------------------------------------------------------- ciclo geral

local tReaparecer = 0

function Inimigos.atualizar(dt)
	for _, ini in lista do
		if ini.vivo and ini.raiz and ini.raiz.Parent then
			-- só pensa quem tem jogadores por perto
			local perto = ini.chefe ~= nil and arenas[ini.chefe].ativa
			if not perto then
				for _, plr in game:GetService("Players"):GetPlayers() do
					local raiz = jogadorVivo(plr)
					if raiz and (raiz.Position - ini.raiz.Position).Magnitude < 260 then
						perto = true
						break
					end
				end
			end
			if perto or ini.estado ~= "ocioso" then
				atualizarInimigo(ini, dt)
			end
		end
	end
	atualizarEfeitos()
	atualizarArenas()
	-- os mortos regressam ao fim de algum tempo, se ninguém estiver a olhar
	tReaparecer -= dt
	if tReaparecer <= 0 then
		tReaparecer = 10
		for _, ini in lista do
			if not ini.vivo and not ini.chefe and ini.morteT and agora() - ini.morteT > 240 then
				local alguem = false
				for _, plr in game:GetService("Players"):GetPlayers() do
					local raiz = jogadorVivo(plr)
					if raiz and plano(raiz.Position - ini.casa).Magnitude < 90 then
						alguem = true
					end
				end
				if not alguem then
					repor(ini)
				end
			end
		end
	end
end

function Inimigos.iniciar(contexto)
	ctx = contexto
	pasta = Instance.new("Folder")
	pasta.Name = "Inimigos"
	pasta.Parent = workspace
	for id in Config.ARENAS do
		arenas[id] = { participantes = {}, ativa = false, derrotado = false, chefe = nil }
	end
	for _, def in Config.ESPAWNS do
		local ini = { def = def, cfg = Config.INIMIGOS[def.tipo], chefe = def.chefe, ladoRonda = 1 }
		local ok, erro = pcall(repor, ini)
		if ok then
			table.insert(lista, ini)
			if ini.chefe then
				arenas[ini.chefe].chefe = ini
			end
		else
			warn("[Céu Partido] não foi possível criar", def.tipo, erro)
		end
	end
end

return Inimigos
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Jogadores</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Estado dos jogadores no servidor: energia, ações de combate, dano recebido, morte e Eco de Éter,
-- faróis (acender, descansar, subir de nível, viajar), relicários e gravação.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Compartilhado"):WaitForChild("Config"))
local Dados = require(script.Parent:WaitForChild("Dados"))
local Mundo = require(script.Parent:WaitForChild("Mundo"))
local Personagens = require(script.Parent:WaitForChild("Personagens"))

local Jogadores = {}

local ctx -- contexto partilhado (remotos, inimigos), definido em iniciar()
local estados = {}
Jogadores.estados = estados

local J = Config.JOGADOR
local GRAUS = math.pi / 180

local function agora()
	return os.clock()
end

local function tempoServidor()
	return workspace:GetServerTimeNow()
end

local function contem(lista, v)
	return table.find(lista, v) ~= nil
end

-- ---------------------------------------------------------------- atributos

function Jogadores.vidaMax(d)
	return J.vidaBase + (d.vigor - 10) * J.vidaPorNivel
end

function Jogadores.energiaMax(d)
	return J.energiaBase + (d.folego - 10) * J.energiaPorNivel
end

local function sincronizar(est)
	local p = est.jogador
	local d = est.dados
	p:SetAttribute("Nivel", d.nivel)
	p:SetAttribute("Vigor", d.vigor)
	p:SetAttribute("Folego", d.folego)
	p:SetAttribute("Forca", d.forca)
	p:SetAttribute("Eter", d.eter)
	p:SetAttribute("OrvalhoMax", d.orvalhoMax)
	p:SetAttribute("Orvalho", est.orvalho)
	p:SetAttribute("Arma", d.arma)
	p:SetAttribute("Armas", table.concat(d.armas, ","))
	p:SetAttribute("Farois", table.concat(d.farois, ","))
	p:SetAttribute("Relicarios", table.concat(d.relicarios, ","))
	p:SetAttribute("Chefes", table.concat(d.chefes, ","))
	p:SetAttribute("EnergiaMax", Jogadores.energiaMax(d))
	p:SetAttribute("Energia", math.floor(est.energia + 0.5))
	p:SetAttribute("CustoNivel", Config.custoNivel(d.nivel))
end

local function personagemValida(est)
	local c = est.jogador.Character
	if not c then
		return nil
	end
	local hum = c:FindFirstChildOfClass("Humanoid")
	local raiz = c:FindFirstChild("HumanoidRootPart")
	if not hum or not raiz or hum.Health <= 0 then
		return nil
	end
	return c, hum, raiz
end

local function definirAcao(est, nome, dur, manter)
	local c = est.jogador.Character
	if not c then
		return
	end
	c:SetAttribute("AcaoDur", dur)
	c:SetAttribute("AcaoManter", manter == true)
	c:SetAttribute("AcaoT0", tempoServidor())
	c:SetAttribute("Acao", nome)
end

local function som(raiz, id, volume, tom)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.PlaybackSpeed = tom or 1
	s.RollOffMaxDistance = 120
	s.Parent = raiz
	s:Play()
	game:GetService("Debris"):AddItem(s, 3)
end
Jogadores.som = som

local function aviso(plr, tipo, texto)
	ctx.remotos.Aviso:FireClient(plr, tipo, texto)
end
Jogadores.aviso = aviso

local function gastar(est, quanto, atraso)
	est.energia -= quanto
	est.atrasoAte = agora() + (atraso or J.atrasoEnergia)
end

function Jogadores.gastarEnergia(plr, quanto)
	local est = estados[plr]
	if est then
		gastar(est, quanto)
	end
end

local function mudar(est, estado, dur)
	est.estado = estado
	est.inicio = agora()
	est.estadoAte = agora() + (dur or math.huge)
end

-- ---------------------------------------------------------------- ações

local function emRecuperacao(est)
	-- pode encadear outra ação no fim de um ataque ou de um rolamento
	local t = agora()
	if est.estado == "ataque" and est.ataque then
		return t >= est.inicio + est.ataque.def.fim
	end
	if est.estado == "rolar" then
		return t >= est.estadoAte - 0.15
	end
	return false
end

local function tentarAtacar(est, forte)
	local c = personagemValida(est)
	if not c then
		return
	end
	if est.energia <= 0 then
		return
	end
	if not (est.estado == "livre" or emRecuperacao(est)) then
		return
	end
	local arma = Config.ARMAS[est.dados.arma] or Config.ARMAS[Config.ARMA_INICIAL]
	if est.estado ~= "ataque" and agora() - (est.fimUltimoAtaque or 0) > 0.6 then
		est.combo = 0
	end
	local def
	if forte then
		def = arma.forte
	else
		def = arma.leve[(est.combo % #arma.leve) + 1]
	end
	est.combo += 1
	gastar(est, def.energia)
	mudar(est, "ataque", def.dur)
	est.ataque = { def = def, arma = arma, forte = forte, golpeados = {} }
	est.fimUltimoAtaque = agora() + def.dur
	definirAcao(est, def.anim, def.dur)
	local raiz = c:FindFirstChild("HumanoidRootPart")
	task.delay(math.max(0, def.ini - 0.12), function()
		if raiz and raiz.Parent then
			som(raiz, if forte then "rbxasset://sounds/swordlunge.wav" else "rbxasset://sounds/swordslash.wav", 0.5, if arma.modelo == "martelo" then 0.75 else 1)
		end
	end)
end

local function tentarRolar(est, tras)
	if not personagemValida(est) then
		return
	end
	if est.energia <= 0 then
		return
	end
	if not (est.estado == "livre" or emRecuperacao(est)) then
		return
	end
	gastar(est, J.custoRolar)
	mudar(est, "rolar", J.durRolar)
	est.invulDe = agora() + J.invulIni
	est.invulAte = agora() + J.invulFim
	definirAcao(est, if tras then "recuar" else "rolar", J.durRolar)
end

local function tentarBeber(est)
	if not personagemValida(est) or est.estado ~= "livre" then
		return
	end
	if est.orvalho <= 0 then
		aviso(est.jogador, "texto", "O Orvalho Celeste acabou")
		return
	end
	mudar(est, "beber", 1.35)
	est.curou = false
	definirAcao(est, "beber", 1.35)
end

local function trocarArma(est)
	if est.estado ~= "livre" or #est.dados.armas < 2 then
		return
	end
	local i = table.find(est.dados.armas, est.dados.arma) or 0
	est.dados.arma = est.dados.armas[(i % #est.dados.armas) + 1]
	local c = est.jogador.Character
	if c then
		Personagens.equiparJogador(c, est.dados.arma)
		local raiz = c:FindFirstChild("HumanoidRootPart")
		if raiz then
			som(raiz, "rbxasset://sounds/unsheath.wav", 0.5)
		end
	end
	sincronizar(est)
	aviso(est.jogador, "texto", Config.ARMAS[est.dados.arma].nome)
end

-- ---------------------------------------------------------------- golpes dos jogadores

local function verificarGolpe(est)
	local c, _, raiz = personagemValida(est)
	if not c then
		return
	end
	local at = est.ataque
	local arma = at.arma
	local frente = raiz.CFrame.LookVector * Vector3.new(1, 0, 1)
	if frente.Magnitude < 0.01 then
		return
	end
	frente = frente.Unit
	local mult = 1 + (est.dados.forca - 10) * arma.escala
	for _, ini in ctx.inimigos.lista do
		if ini.vivo and ini.raiz and not at.golpeados[ini] then
			local delta = (ini.raiz.Position - raiz.Position) * Vector3.new(1, 0, 1)
			local d = delta.Magnitude
			local dy = math.abs(ini.raiz.Position.Y - raiz.Position.Y)
			if d - ini.cfg.raio <= arma.alcance and dy < 10 + ini.cfg.escala * 3 then
				local ang = if d > 0.01 then math.acos(math.clamp(delta.Unit:Dot(frente), -1, 1)) else 0
				if ang <= arma.arco / 2 * GRAUS or d < ini.cfg.raio + 2 then
					at.golpeados[ini] = true
					local dano = arma.dano * at.def.mult * mult * (0.95 + math.random() * 0.1)
					ctx.inimigos.receberDano(ini, dano, at.def.equil, est.jogador, at.forte)
				end
			end
		end
	end
end

-- ---------------------------------------------------------------- dano recebido

local function atordoar(est, dur, anim)
	mudar(est, "atordoado", dur)
	definirAcao(est, anim or (if dur > 0.8 then "atordoado" else "golpeado"), dur)
	local c = est.jogador.Character
	if c then
		c:SetAttribute("AtordoadoAte", tempoServidor() + dur)
	end
end

-- opcoes: { equil, tipo = "normal" | "derrubar", elemento = "raio" | nil }
function Jogadores.receberDano(plr, dano, origem, opcoes)
	opcoes = opcoes or {}
	local est = estados[plr]
	if not est or not est.vivo then
		return "nada"
	end
	local c, hum, raiz = personagemValida(est)
	if not c then
		return "nada"
	end
	local t = agora()
	if (est.invulDe and t >= est.invulDe and t <= (est.invulAte or 0)) or est.estado == "sentado" or est.estado == "acender" then
		return "esquivou"
	end
	if est.estado == "derrubado" and t > est.inicio + 0.35 then
		return "esquivou"
	end
	local equil = opcoes.equil or 20
	local delta = (origem - raiz.Position) * Vector3.new(1, 0, 1)
	local dir = if delta.Magnitude > 0.01 then delta.Unit else -raiz.CFrame.LookVector
	local frente = (raiz.CFrame.LookVector * Vector3.new(1, 0, 1)).Unit
	local ang = math.acos(math.clamp(frente:Dot(dir), -1, 1))
	-- bloqueio
	if est.bloqueando and est.estado == "livre" and ang < J.bloqueioAngulo * GRAUS then
		gastar(est, equil * 1.1 + dano * 0.12, 0.9)
		local chip = if opcoes.elemento == "raio" then 0.35 elseif opcoes.tipo == "derrubar" then 0.15 else 0
		ctx.remotos.Efeito:FireAllClients("faisca", raiz.Position + frente * 2 + Vector3.new(0, 1, 0))
		som(raiz, "rbxasset://sounds/unsheath.wav", 0.7, 0.6)
		if est.energia < 0 then
			est.energia = 0
			hum.Health -= dano * 0.4
			atordoar(est, 1.1, "atordoado")
			aviso(plr, "texto", "Guarda quebrada!")
			ctx.remotos.Impacto:FireClient(plr, -dir, 30, 0.4)
		else
			hum.Health -= dano * chip
			ctx.remotos.Impacto:FireClient(plr, -dir, 14, 0.2)
		end
		return "bloqueou"
	end
	hum.Health -= dano
	ctx.remotos.Efeito:FireAllClients("golpe", raiz.Position + Vector3.new(0, 1, 0), "carne")
	if hum.Health <= 0 then
		ctx.remotos.Impacto:FireClient(plr, -dir, 20, 0.6)
		return "acertou"
	end
	local superArmadura = est.estado == "ataque" and est.ataque and est.ataque.forte
		and t > est.inicio + est.ataque.def.ini * 0.5 and t < est.inicio + est.ataque.def.fim and equil < 45
	if opcoes.tipo == "derrubar" then
		mudar(est, "derrubado", 1.7)
		definirAcao(est, "derrubado", 1.7)
		c:SetAttribute("AtordoadoAte", tempoServidor() + 1.5)
		ctx.remotos.Impacto:FireClient(plr, -dir, 55, 0.7)
	elseif not superArmadura then
		atordoar(est, 0.42, "golpeado")
		ctx.remotos.Impacto:FireClient(plr, -dir, 22, math.min(0.6, 0.15 + dano / 300))
	else
		ctx.remotos.Impacto:FireClient(plr, -dir, 0, 0.2)
	end
	return "acertou"
end

function Jogadores.invulneravel(plr)
	local est = estados[plr]
	if not est then
		return true
	end
	local t = agora()
	return (est.invulDe and t >= est.invulDe and t <= (est.invulAte or 0)) or est.estado == "sentado"
end

function Jogadores.darEter(plr, qtd, origem)
	local est = estados[plr]
	if not est or not est.vivo then
		return
	end
	est.dados.eter += qtd
	sincronizar(est)
	ctx.remotos.Efeito:FireAllClients("eter", origem, plr.UserId)
	aviso(plr, "eter", tostring(qtd))
end

function Jogadores.registarChefe(plr, id)
	local est = estados[plr]
	if est and not contem(est.dados.chefes, id) then
		table.insert(est.dados.chefes, id)
		sincronizar(est)
		task.spawn(Dados.guardar, plr.UserId, est.dados)
	end
end

-- ---------------------------------------------------------------- Eco de Éter (o que fica ao morrer)

local pastaEcos

local function criarEco(plr, eco)
	local antigo = pastaEcos:FindFirstChild("Eco_" .. plr.UserId)
	if antigo then
		antigo:Destroy()
	end
	if not eco then
		return
	end
	local p = Instance.new("Part")
	p.Name = "Eco_" .. plr.UserId
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(1.6, 1.6, 1.6)
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(150, 255, 210)
	p.Transparency = 0.2
	p.Anchored = true
	p.CanCollide = false
	p.Position = Vector3.new(eco.x, eco.y, eco.z)
	local luz = Instance.new("PointLight")
	luz.Color = p.Color
	luz.Range = 14
	luz.Brightness = 1.5
	luz.Parent = p
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(p.Color)
	e.LightEmission = 1
	e.Size = NumberSequence.new(0.5)
	e.Lifetime = NumberRange.new(1, 2)
	e.Speed = NumberRange.new(1, 3)
	e.Rate = 14
	e.SpreadAngle = Vector2.new(180, 180)
	e.Parent = p
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Eco"
	prompt.ActionText = "Recuperar Éter"
	prompt.ObjectText = "Eco de " .. plr.DisplayName .. " (" .. eco.qtd .. ")"
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt:SetAttribute("Dono", plr.UserId)
	prompt.Parent = p
	p:SetAttribute("Dono", plr.UserId)
	p.Parent = pastaEcos
end

local function recuperarEco(plr, prompt)
	local est = estados[plr]
	if not est or prompt:GetAttribute("Dono") ~= plr.UserId then
		if est then
			aviso(plr, "texto", "Este Eco pertence a outro andarilho")
		end
		return
	end
	local eco = est.dados.eco
	if not eco then
		return
	end
	est.dados.eter += eco.qtd
	est.dados.eco = nil
	criarEco(plr, nil)
	sincronizar(est)
	ctx.remotos.Efeito:FireAllClients("eter", Vector3.new(eco.x, eco.y, eco.z), plr.UserId)
	aviso(plr, "banner", "ÉTER RECUPERADO")
	task.spawn(Dados.guardar, plr.UserId, est.dados)
end

-- ---------------------------------------------------------------- faróis

local function posFarol(id)
	local f = Mundo.farois[id]
	if not f then
		return nil
	end
	return f.pos
end

local function colocarJuntoAoFarol(personagem, id)
	local p = posFarol(id)
	if not p then
		return
	end
	local alvo = p + Vector3.new(5, 4, 5)
	personagem:PivotTo(CFrame.lookAt(alvo, Vector3.new(p.X, alvo.Y, p.Z)))
end

local function descansar(est, id)
	local c, hum = personagemValida(est)
	if not c then
		return
	end
	est.sentado = id
	mudar(est, "sentado")
	definirAcao(est, "sentado", 2, true)
	hum.Health = hum.MaxHealth
	est.orvalho = est.dados.orvalhoMax
	est.energia = Jogadores.energiaMax(est.dados)
	est.dados.ultimoFarol = id
	ctx.inimigos.reporMortos()
	sincronizar(est)
	task.spawn(Dados.guardar, est.jogador.UserId, est.dados)
	ctx.remotos.Farol:FireClient(est.jogador, id)
end

local function usarFarol(plr, id)
	local est = estados[plr]
	if not est or est.estado ~= "livre" then
		return
	end
	local c, _, raiz = personagemValida(est)
	if not c then
		return
	end
	if ctx.inimigos.ameacaPerto(raiz.Position, 45) then
		aviso(plr, "texto", "Não podes descansar com inimigos por perto")
		return
	end
	local def
	for _, f in Config.FAROIS do
		if f.id == id then
			def = f
		end
	end
	if not def then
		return
	end
	if not contem(est.dados.farois, id) then
		table.insert(est.dados.farois, id)
		Mundo.acenderFarolVisual(id)
		mudar(est, "acender", 1.7)
		definirAcao(est, "acender", 1.6)
		som(raiz, "rbxasset://sounds/electronicpingshort.wav", 0.6, 0.5)
		aviso(plr, "farol", def.nome)
		task.delay(1.6, function()
			if est.vivo and (est.estado :: string) == "acender" then
				descansar(est, id)
			end
		end)
	else
		descansar(est, id)
	end
end

local function partir(est)
	if est.estado ~= "sentado" then
		return
	end
	est.sentado = nil
	mudar(est, "levantar", 1.1)
	definirAcao(est, "levantar", 1.1)
end

local function subirNivel(est, atributo)
	if est.estado ~= "sentado" then
		return
	end
	local valido = false
	for _, a in Config.ATRIBUTOS do
		if a.id == atributo then
			valido = true
		end
	end
	if not valido then
		return
	end
	local d = est.dados
	local custo = Config.custoNivel(d.nivel)
	if d.eter < custo or d[atributo] >= 60 then
		return
	end
	d.eter -= custo
	d.nivel += 1
	d[atributo] += 1
	local c, hum = personagemValida(est)
	if c then
		hum.MaxHealth = Jogadores.vidaMax(d)
		hum.Health = hum.MaxHealth
	end
	est.energia = Jogadores.energiaMax(d)
	sincronizar(est)
	task.spawn(Dados.guardar, est.jogador.UserId, d)
end

local function viajar(est, id)
	if est.estado ~= "sentado" or est.sentado == id or not contem(est.dados.farois, id) then
		return
	end
	local c = personagemValida(est)
	if not c then
		return
	end
	colocarJuntoAoFarol(c, id)
	est.sentado = id
	est.dados.ultimoFarol = id
	definirAcao(est, "sentado", 2, true)
	task.spawn(Dados.guardar, est.jogador.UserId, est.dados)
	ctx.remotos.Farol:FireClient(est.jogador, id)
end

-- ---------------------------------------------------------------- relicários

local function abrirRelicario(plr, id)
	local est = estados[plr]
	if not est or est.estado ~= "livre" then
		return
	end
	if contem(est.dados.relicarios, id) then
		aviso(plr, "texto", "Já abriste este relicário")
		return
	end
	local def
	for _, r in Config.RELICARIOS do
		if r.id == id then
			def = r
		end
	end
	if not def then
		return
	end
	table.insert(est.dados.relicarios, id)
	local c, _, raiz = personagemValida(est)
	if raiz then
		som(raiz, "rbxasset://sounds/electronicpingshort.wav", 0.6, 1.2)
	end
	mudar(est, "acender", 0.9)
	definirAcao(est, "acender", 0.9)
	if def.tipo == "orvalho" then
		est.dados.orvalhoMax += 1
		est.orvalho += 1
		aviso(plr, "item", "Fragmento de Orvalho — o frasco tem agora " .. est.dados.orvalhoMax .. " cargas")
	elseif def.tipo == "arma" then
		if not contem(est.dados.armas, def.arma) then
			table.insert(est.dados.armas, def.arma)
		end
		est.dados.arma = def.arma
		if c then
			Personagens.equiparJogador(c, def.arma)
		end
		aviso(plr, "item", Config.ARMAS[def.arma].nome .. " (X para trocar de arma)")
	elseif def.tipo == "eter" then
		est.dados.eter += def.qtd
		aviso(plr, "item", "Éter cristalizado (" .. def.qtd .. ")")
	end
	sincronizar(est)
	task.spawn(Dados.guardar, plr.UserId, est.dados)
end

-- ---------------------------------------------------------------- personagem e morte

local filtroChao = RaycastParams.new()
filtroChao.FilterType = Enum.RaycastFilterType.Exclude

local function aoMorrer(est)
	if not est.vivo then
		return
	end
	est.vivo = false
	mudar(est, "morto")
	definirAcao(est, "morrer", 1.6, true)
	local plr = est.jogador
	local d = est.dados
	if d.eter > 0 then
		local p = est.ultimoChao or Vector3.new(0, 200, 0)
		d.eco = { x = p.X, y = p.Y, z = p.Z, qtd = d.eter }
		d.eter = 0
		criarEco(plr, d.eco)
	end
	sincronizar(est)
	aviso(plr, "morte", "")
	ctx.inimigos.sairArena(plr)
	task.spawn(Dados.guardar, plr.UserId, d)
	task.delay(5.5, function()
		if plr.Parent then
			plr:LoadCharacter()
		end
	end)
end

local function prepararPersonagem(est, personagem)
	local hum = personagem:WaitForChild("Humanoid", 10)
	local raiz = personagem:WaitForChild("HumanoidRootPart", 10)
	if not hum or not raiz then
		return
	end
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.MaxHealth = Jogadores.vidaMax(est.dados)
	hum.Health = hum.MaxHealth
	est.vivo = true
	est.energia = Jogadores.energiaMax(est.dados)
	est.orvalho = est.dados.orvalhoMax
	est.bloqueando = false
	est.correndo = false
	est.invulDe = nil
	est.invulAte = nil
	est.sentado = nil
	est.ultimoChao = nil
	mudar(est, "levantar", 1.6)
	personagem:SetAttribute("Jogador", true)
	Personagens.equiparJogador(personagem, est.dados.arma)
	-- posição inicial: último farol ou o despertar
	local id = est.dados.ultimoFarol
	if id and Mundo.farois[id] then
		colocarJuntoAoFarol(personagem, id)
	else
		local chao = Mundo.chaoOuIlha(Config.INICIO.X, Config.INICIO.Z, "despertar")
		personagem:PivotTo(CFrame.new(chao + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.rad(200), 0))
	end
	definirAcao(est, "levantar", 1.6)
	hum.Died:Connect(function()
		aoMorrer(est)
	end)
	sincronizar(est)
end

-- ---------------------------------------------------------------- ciclo

local tAtributos = 0
local tChao = 0
local tGravar = 0

function Jogadores.atualizar(dt)
	local t = agora()
	tAtributos -= dt
	tChao -= dt
	tGravar -= dt
	for plr, est in estados do
		local c, hum, raiz = personagemValida(est)
		if c and est.vivo then
			-- fim de estados temporários
			if est.estado ~= "livre" and est.estado ~= "sentado" and est.estado ~= "morto" and t >= est.estadoAte then
				if est.estado == "ataque" then
					est.ataque = nil
				end
				mudar(est, "livre")
			end
			-- golpes ativos
			if est.estado == "ataque" and est.ataque then
				local dt0 = t - est.inicio
				if dt0 >= est.ataque.def.ini and dt0 <= est.ataque.def.fim then
					verificarGolpe(est)
				end
			end
			-- beber
			if est.estado == "beber" and not est.curou and t - est.inicio > 0.6 then
				est.curou = true
				est.orvalho -= 1
				hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * J.curaOrvalho)
				ctx.remotos.Efeito:FireAllClients("cura", raiz.Position)
				sincronizar(est)
			end
			-- energia
			local velH = (raiz.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude
			if est.correndo and est.estado == "livre" and velH > 16 and est.energia > 0 then
				est.energia -= J.custoCorrer * dt
				est.atrasoAte = t + 0.4
			elseif t >= est.atrasoAte and est.estado ~= "ataque" and est.estado ~= "rolar" then
				local ritmo = J.recuperacaoEnergia * (if est.bloqueando then 0.4 else 1)
				est.energia = math.min(Jogadores.energiaMax(est.dados), est.energia + ritmo * dt)
			end
			local bloq = est.bloqueando and est.estado == "livre"
			if c:GetAttribute("Bloqueando") ~= bloq then
				c:SetAttribute("Bloqueando", bloq)
			end
			-- queda nas nuvens
			if raiz.Position.Y < Config.ALTURA_QUEDA then
				hum.Health = 0
			end
			-- último chão firme (onde fica o Eco)
			if tChao <= 0 and est.estado ~= "rolar" then
				filtroChao.FilterDescendantsInstances = { c, workspace:FindFirstChild("Inimigos") }
				local r = workspace:Raycast(raiz.Position, Vector3.new(0, -9, 0), filtroChao)
				if r then
					est.ultimoChao = r.Position + Vector3.new(0, 2.5, 0)
				end
			end
		end
		if tAtributos <= 0 then
			plr:SetAttribute("Energia", math.floor(est.energia + 0.5))
			plr:SetAttribute("Orvalho", est.orvalho)
		end
		if tGravar <= 0 then
			task.spawn(Dados.guardar, plr.UserId, est.dados)
		end
	end
	if tAtributos <= 0 then
		tAtributos = 0.08
	end
	if tChao <= 0 then
		tChao = 0.4
	end
	if tGravar <= 0 then
		tGravar = 120
	end
end

-- ---------------------------------------------------------------- arranque

local function entrou(plr)
	local dados = Dados.carregar(plr.UserId)
	if not plr.Parent then
		return
	end
	local est: any = {
		jogador = plr, dados = dados, energia = 0, atrasoAte = 0, estado = "morto", inicio = agora(), estadoAte = math.huge,
		combo = 0, orvalho = dados.orvalhoMax, vivo = false, bloqueando = false, correndo = false,
	}
	estados[plr] = est
	-- faróis já acesos por este jogador também ficam acesos no mundo
	for _, id in dados.farois do
		Mundo.acenderFarolVisual(id)
	end
	if dados.eco then
		criarEco(plr, dados.eco)
	end
	sincronizar(est)
	plr.CharacterAdded:Connect(function(personagem)
		prepararPersonagem(est, personagem)
	end)
	plr:LoadCharacter()
end

function Jogadores.iniciar(contexto)
	ctx = contexto
	pastaEcos = Instance.new("Folder")
	pastaEcos.Name = "Ecos"
	pastaEcos.Parent = workspace

	local R = ctx.remotos
	R.Acao.OnServerEvent:Connect(function(plr, tipo, arg)
		local est = estados[plr]
		if not est or not est.vivo or type(tipo) ~= "string" then
			return
		end
		if tipo == "leve" then
			tentarAtacar(est, false)
		elseif tipo == "forte" then
			tentarAtacar(est, true)
		elseif tipo == "rolar" then
			tentarRolar(est, arg == "tras")
		elseif tipo == "bloquear" then
			est.bloqueando = arg == true
		elseif tipo == "correr" then
			est.correndo = arg == true
		elseif tipo == "beber" then
			tentarBeber(est)
		elseif tipo == "trocarArma" then
			trocarArma(est)
		elseif tipo == "planar" then
			local c = plr.Character
			if c then
				c:SetAttribute("Planando", arg == true)
			end
		end
	end)
	R.Menu.OnServerEvent:Connect(function(plr, tipo, arg)
		local est = estados[plr]
		if not est or not est.vivo or type(tipo) ~= "string" then
			return
		end
		if tipo == "partir" then
			partir(est)
		elseif tipo == "subir" and type(arg) == "string" then
			subirNivel(est, arg)
		elseif tipo == "viajar" and type(arg) == "string" then
			viajar(est, arg)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, plr)
		if prompt.Name == "Farol" then
			usarFarol(plr, prompt:GetAttribute("Farol"))
		elseif prompt.Name == "Relicario" then
			abrirRelicario(plr, prompt:GetAttribute("Relicario"))
		elseif prompt.Name == "Eco" then
			recuperarEco(plr, prompt)
		elseif prompt.Name == "Barreira" then
			local est = estados[plr]
			if est and est.vivo and est.estado == "livre" then
				ctx.inimigos.entrarArena(plr, prompt:GetAttribute("Arena"))
			end
		end
	end)

	Players.PlayerAdded:Connect(entrou)
	for _, plr in Players:GetPlayers() do
		task.spawn(entrou, plr)
	end
	Players.PlayerRemoving:Connect(function(plr)
		local est = estados[plr]
		if est then
			Dados.guardar(plr.UserId, est.dados)
			criarEco(plr, nil)
			ctx.inimigos.sairArena(plr)
		end
		estados[plr] = nil
	end)
	game:BindToClose(function()
		for plr, est in estados do
			Dados.guardar(plr.UserId, est.dados)
		end
	end)
end

return Jogadores
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Céu Partido — arranque do servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

Players.CharacterAutoLoads = false

-- remotos partilhados com os clientes
local remotos = Instance.new("Folder")
remotos.Name = "Remotos"
local nomes = { "Acao", "Menu", "Aviso", "Farol", "Chefe", "Impacto", "Efeito" }
local R: { [string]: RemoteEvent } = {}
for _, nome in nomes do
	local r = Instance.new("RemoteEvent")
	r.Name = nome
	r.Parent = remotos
	R[nome] = r
end

local Mundo = require(script.Parent:WaitForChild("Mundo"))
local Jogadores = require(script.Parent:WaitForChild("Jogadores"))
local Inimigos = require(script.Parent:WaitForChild("Inimigos"))

local inicio = os.clock()
Mundo.gerar()
print(string.format("[Céu Partido] mundo gerado em %.1f s", os.clock() - inicio))

local ctx = { remotos = R, jogadores = Jogadores, inimigos = Inimigos, mundo = Mundo }
Inimigos.iniciar(ctx)
remotos.Parent = ReplicatedStorage
Jogadores.iniciar(ctx)

-- o mundo está pronto: os clientes podem começar
ReplicatedStorage:SetAttribute("MundoPronto", true)

RunService.Heartbeat:Connect(function(dt)
	Jogadores.atualizar(dt)
	Inimigos.atualizar(dt)
end)

-- a interface padrão de mochila e lista de jogadores não é usada neste jogo
StarterGui.ResetPlayerGuiOnSpawn = false
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Mundo</string>
          <string name="Source"><![CDATA[--!strict
-- Gera o mundo de Céu Partido quando o servidor arranca: ilhas de terreno, vegetação,
-- ruínas, pontes, correntes de vento, faróis, relicários, inscrições, nuvens e iluminação.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Compartilhado"):WaitForChild("Config"))

local Mundo = {}

local terreno = workspace.Terrain
local pasta: Folder
local ilhasPorId: { [string]: Config.Ilha } = {}
for _, ilha in Config.ILHAS do
	ilhasPorId[ilha.id] = ilha
end
Mundo.ilhasPorId = ilhasPorId

-- ---------------------------------------------------------------- utilitários

local function semente(texto: string): number
	local h = 7
	for i = 1, #texto do
		h = (h * 31 + string.byte(texto, i)) % 2147483647
	end
	return h
end

local function parte(props: { [string]: any }, pai: Instance?): BasePart
	local classe = props.Classe or "Part"
	local p = Instance.new(classe) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		if k ~= "Classe" then
			(p :: any)[k] = v
		end
	end
	p.Parent = pai or pasta
	return p
end

local filtroTerreno = RaycastParams.new()
filtroTerreno.FilterType = Enum.RaycastFilterType.Include
filtroTerreno.FilterDescendantsInstances = { terreno }

-- altura do chão (terreno) em x, z; nil se não houver chão
function Mundo.chao(x: number, z: number): Vector3?
	local r = workspace:Raycast(Vector3.new(x, 900, z), Vector3.new(0, -1000, 0), filtroTerreno)
	return if r then r.Position else nil
end

function Mundo.chaoOuIlha(x: number, z: number, ilhaId: string?): Vector3
	local p = Mundo.chao(x, z)
	if p then
		return p
	end
	local y = 200
	if ilhaId and ilhasPorId[ilhaId] then
		y = ilhasPorId[ilhaId].centro.Y
	end
	return Vector3.new(x, y, z)
end

-- a que ilha pertence um ponto (a mais próxima no plano)
function Mundo.ilhaEm(pos: Vector3): Config.Ilha?
	local melhor: Config.Ilha? = nil
	local md = math.huge
	for _, ilha in Config.ILHAS do
		local d = Vector2.new(pos.X - ilha.centro.X, pos.Z - ilha.centro.Z).Magnitude
		if d < ilha.raio * 1.1 and d < md then
			md = d
			melhor = ilha
		end
	end
	return melhor
end

-- ---------------------------------------------------------------- ilhas (terreno)

local function gerarIlha(ilha: Config.Ilha)
	local c = ilha.centro
	local r = ilha.raio
	local rnd = Random.new(semente(ilha.id))
	-- corpo de rocha em camadas, a afunilar para baixo (cone invertido irregular)
	local profundidade = r * 1.15 + 20
	local camadas = math.ceil(profundidade / 6)
	for k = 0, camadas do
		local f = k / camadas
		local raio = r * (1 - f) ^ 1.35 * (0.93 + rnd:NextNumber() * 0.12) + 3
		local desvio = Vector3.new(rnd:NextNumber(-1, 1), 0, rnd:NextNumber(-1, 1)) * r * 0.06 * f
		local y = c.Y - 4 - k * 6
		local mat = if k < 2 then Enum.Material.Ground else ilha.rocha
		terreno:FillCylinder(CFrame.new(c + desvio + Vector3.new(0, y - c.Y, 0)), 7, raio, mat)
		-- saliências rochosas na borda
		local n = math.max(3, math.floor(raio / 14))
		for j = 1, n do
			local a = rnd:NextNumber(0, math.pi * 2)
			local d = raio * rnd:NextNumber(0.75, 0.95)
			local rb = raio * rnd:NextNumber(0.12, 0.26) + 2
			terreno:FillBall(Vector3.new(c.X + math.cos(a) * d, y - rb * 0.3, c.Z + math.sin(a) * d), rb, ilha.rocha)
		end
	end
	-- estalactites pendentes
	for _ = 1, math.floor(r / 18) do
		local a = rnd:NextNumber(0, math.pi * 2)
		local d = rnd:NextNumber(0, r * 0.45)
		local base = Vector3.new(c.X + math.cos(a) * d, c.Y - profundidade * rnd:NextNumber(0.5, 0.85), c.Z + math.sin(a) * d)
		local rb = rnd:NextNumber(6, 12)
		for k = 0, 4 do
			terreno:FillBall(base - Vector3.new(0, k * rb * 0.8, 0), rb * (1 - k * 0.18), ilha.rocha)
		end
	end
	-- superfície com relva e colinas suaves
	terreno:FillCylinder(CFrame.new(c.X, c.Y - 2, c.Z), 4, r, ilha.relva)
	for _ = 1, math.floor(r / 14) do
		local a = rnd:NextNumber(0, math.pi * 2)
		local d = rnd:NextNumber(0, r * 0.7)
		local hr = rnd:NextNumber(10, 24)
		terreno:FillBall(Vector3.new(c.X + math.cos(a) * d, c.Y - hr * 0.82, c.Z + math.sin(a) * d), hr, ilha.relva)
	end
	-- borda arredondada e irregular
	local nb = math.floor(r / 6)
	for j = 1, nb do
		local a = (j / nb) * math.pi * 2 + rnd:NextNumber(-0.1, 0.1)
		local rb = rnd:NextNumber(r * 0.07, r * 0.13) + 2
		local d = r - rb * 0.4
		terreno:FillBall(Vector3.new(c.X + math.cos(a) * d, c.Y - rb * 0.65, c.Z + math.sin(a) * d), rb, if rnd:NextNumber() < 0.6 then ilha.relva else ilha.rocha)
	end
	-- pequenos lagos nas ilhas grandes
	if r > 120 and not ilha.tempestade then
		local a = rnd:NextNumber(0, math.pi * 2)
		local p = Vector3.new(c.X + math.cos(a) * r * 0.45, c.Y, c.Z + math.sin(a) * r * 0.45)
		terreno:FillCylinder(CFrame.new(p + Vector3.new(0, -1, 0)), 6, 14, Enum.Material.Air)
		terreno:FillCylinder(CFrame.new(p + Vector3.new(0, -2.5, 0)), 3, 14, Enum.Material.Water)
		terreno:FillCylinder(CFrame.new(p + Vector3.new(0, -5, 0)), 2, 15, Enum.Material.Mud)
	end
end

-- rochas soltas a flutuar entre as ilhas (decoração)
local function gerarRochasFlutuantes()
	local rnd = Random.new(99)
	for _ = 1, 26 do
		local p = Vector3.new(rnd:NextNumber(-600, 600), rnd:NextNumber(120, 420), rnd:NextNumber(-750, 350))
		local longe = true
		for _, ilha in Config.ILHAS do
			if (Vector2.new(p.X, p.Z) - Vector2.new(ilha.centro.X, ilha.centro.Z)).Magnitude < ilha.raio + 40 then
				longe = false
				break
			end
		end
		if longe then
			local r = rnd:NextNumber(6, 16)
			terreno:FillBall(p, r, Enum.Material.Rock)
			terreno:FillBall(p - Vector3.new(0, r * 0.8, 0), r * 0.7, Enum.Material.Slate)
			terreno:FillBall(p + Vector3.new(0, r * 0.55, 0), r * 0.6, Enum.Material.Grass)
		end
	end
end

-- ---------------------------------------------------------------- vegetação e ruínas (peças)

local CORES_FLOR = {
	Color3.fromRGB(255, 182, 206), Color3.fromRGB(250, 214, 230), Color3.fromRGB(255, 236, 190),
	Color3.fromRGB(196, 230, 160), Color3.fromRGB(255, 200, 150),
}

local function arvore(tipo: string, base: Vector3, rnd: Random, pai: Instance)
	local m = Instance.new("Model")
	m.Name = "Arvore"
	local escala = rnd:NextNumber(0.8, 1.35)
	if tipo == "flor" then
		local h = 14 * escala
		parte({ Size = Vector3.new(h, 1.8 * escala, 1.8 * escala), Shape = Enum.PartType.Cylinder, Material = Enum.Material.Wood,
			Color = Color3.fromRGB(110, 82, 62), CFrame = CFrame.new(base + Vector3.new(0, h / 2 - 1, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, m)
		local cor = CORES_FLOR[rnd:NextInteger(1, #CORES_FLOR)]
		for i = 1, 5 do
			local a = i * 1.3 + rnd:NextNumber()
			local d = if i == 1 then 0 else rnd:NextNumber(3, 5.5) * escala
			local s = rnd:NextNumber(8, 12) * escala
			parte({ Size = Vector3.new(s, s * 0.8, s), Shape = Enum.PartType.Ball, Material = Enum.Material.LeafyGrass, Color = cor,
				CFrame = CFrame.new(base + Vector3.new(math.cos(a) * d, h + rnd:NextNumber(-1.5, 2.5) * escala, math.sin(a) * d)), CastShadow = true }, m)
		end
	elseif tipo == "pinheiro" then
		local h = 20 * escala
		parte({ Size = Vector3.new(h, 1.4 * escala, 1.4 * escala), Shape = Enum.PartType.Cylinder, Material = Enum.Material.Wood,
			Color = Color3.fromRGB(92, 70, 52), CFrame = CFrame.new(base + Vector3.new(0, h / 2 - 1, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, m)
		for k = 0, 3 do
			local raio = (9 - k * 2) * escala
			parte({ Size = Vector3.new(3.2 * escala, raio * 2, raio * 2), Shape = Enum.PartType.Cylinder, Material = Enum.Material.LeafyGrass,
				Color = Color3.fromRGB(58, 98, 66), CFrame = CFrame.new(base + Vector3.new(0, h * 0.35 + k * 4.2 * escala, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, m)
		end
	elseif tipo == "cristal" then
		local cor = if rnd:NextNumber() < 0.5 then Color3.fromRGB(120, 200, 255) else Color3.fromRGB(190, 140, 255)
		for i = 1, rnd:NextInteger(3, 5) do
			local h = rnd:NextNumber(6, 14) * escala
			local w = h * 0.28
			parte({ Size = Vector3.new(w, h, w), Material = Enum.Material.Glass, Color = cor, Transparency = 0.15,
				CFrame = CFrame.new(base + Vector3.new(rnd:NextNumber(-2, 2), h * 0.4, rnd:NextNumber(-2, 2)))
					* CFrame.Angles(rnd:NextNumber(-0.4, 0.4), rnd:NextNumber(0, 3), rnd:NextNumber(-0.4, 0.4)) }, m)
			if i == 1 then
				local luz = Instance.new("PointLight")
				luz.Color = cor
				luz.Range = 16
				luz.Brightness = 1.2
				luz.Parent = m:FindFirstChildWhichIsA("BasePart")
			end
		end
	else -- morta
		local h = 12 * escala
		parte({ Size = Vector3.new(h, 1.5 * escala, 1.5 * escala), Shape = Enum.PartType.Cylinder, Material = Enum.Material.Wood,
			Color = Color3.fromRGB(60, 56, 54), CFrame = CFrame.new(base + Vector3.new(0, h / 2 - 1, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, m)
		for _ = 1, 4 do
			local len = rnd:NextNumber(5, 8) * escala
			local cf = CFrame.new(base + Vector3.new(0, h * rnd:NextNumber(0.55, 0.95), 0))
				* CFrame.Angles(0, rnd:NextNumber(0, math.pi * 2), math.rad(rnd:NextNumber(30, 60)))
			parte({ Size = Vector3.new(len, 0.7 * escala, 0.7 * escala), Shape = Enum.PartType.Cylinder, Material = Enum.Material.Wood,
				Color = Color3.fromRGB(60, 56, 54), CFrame = cf * CFrame.new(len / 2, 0, 0) }, m)
		end
	end
	m.Parent = pai
end

local PEDRA = Color3.fromRGB(196, 190, 176)

local function pilar(pos: Vector3, altura: number, partido: boolean, rnd: Random, pai: Instance)
	local h = if partido then altura * rnd:NextNumber(0.35, 0.8) else altura
	parte({ Size = Vector3.new(6, 1.6, 6), Material = Enum.Material.Marble, Color = PEDRA, CFrame = CFrame.new(pos + Vector3.new(0, 0.6, 0)) }, pai)
	parte({ Size = Vector3.new(h, 3.6, 3.6), Shape = Enum.PartType.Cylinder, Material = Enum.Material.Marble, Color = PEDRA,
		CFrame = CFrame.new(pos + Vector3.new(0, 1.4 + h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, pai)
	if not partido then
		parte({ Size = Vector3.new(5.5, 1.4, 5.5), Material = Enum.Material.Marble, Color = PEDRA, CFrame = CFrame.new(pos + Vector3.new(0, 1.4 + h + 0.7, 0)) }, pai)
	else
		local a = rnd:NextNumber(0, math.pi * 2)
		parte({ Size = Vector3.new(4.5, 3.4, 3.4), Shape = Enum.PartType.Cylinder, Material = Enum.Material.Marble, Color = PEDRA,
			CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 5, 1.6, math.sin(a) * 5)) * CFrame.Angles(0, a, 0) }, pai)
	end
end

-- anel de muro em ruínas (arenas)
local function anelMuro(centro: Vector3, raio: number, altura: number, abertura: Vector3, larguraAbertura: number, mat: Enum.Material, cor: Color3, pai: Instance)
	local rnd = Random.new(semente(tostring(centro)))
	local segmentos = math.floor(raio * 2 * math.pi / 9)
	local angAbertura = math.atan2(abertura.Z, abertura.X)
	for i = 0, segmentos - 1 do
		local a = (i + 0.5) / segmentos * math.pi * 2
		local dif = math.abs(math.atan2(math.sin(a - angAbertura), math.cos(a - angAbertura)))
		if dif * raio > larguraAbertura / 2 + 4 then
			local x = centro.X + math.cos(a) * raio
			local z = centro.Z + math.sin(a) * raio
			local chao = Mundo.chaoOuIlha(x, z)
			local h = altura * rnd:NextNumber(0.75, 1.15)
			parte({ Size = Vector3.new(4, h + 6, 9.6), Material = mat, Color = cor,
				CFrame = CFrame.new(x, chao.Y + h / 2 - 3, z) * CFrame.Angles(0, -a, 0) }, pai)
		end
	end
end

-- ponte de tábuas entre duas ilhas
local function ponte(a: Config.Ilha, b: Config.Ilha, pai: Instance)
	local dir = Vector3.new(b.centro.X - a.centro.X, 0, b.centro.Z - a.centro.Z).Unit
	local p0 = Mundo.chaoOuIlha(a.centro.X + dir.X * (a.raio - 8), a.centro.Z + dir.Z * (a.raio - 8), a.id)
	local p1 = Mundo.chaoOuIlha(b.centro.X - dir.X * (b.raio - 8), b.centro.Z - dir.Z * (b.raio - 8), b.id)
	local total = (p1 - p0).Magnitude
	local n = math.ceil(total / 6)
	for i = 0, n - 1 do
		local t0 = i / n
		local t1 = (i + 1) / n
		-- pequena curvatura para baixo a meio
		local s0 = math.sin(t0 * math.pi) * 4
		local s1 = math.sin(t1 * math.pi) * 4
		local q0 = p0:Lerp(p1, t0) - Vector3.new(0, s0 + 0.6, 0)
		local q1 = p0:Lerp(p1, t1) - Vector3.new(0, s1 + 0.6, 0)
		local meio = (q0 + q1) / 2
		local cf = CFrame.lookAt(meio, q1)
		parte({ Size = Vector3.new(12, 1.2, (q1 - q0).Magnitude + 0.3), Material = Enum.Material.WoodPlanks,
			Color = Color3.fromRGB(150, 112, 80), CFrame = cf }, pai)
		if i % 2 == 0 then
			for _, lado in { -1, 1 } do
				parte({ Size = Vector3.new(0.8, 5, 0.8), Material = Enum.Material.Wood, Color = Color3.fromRGB(110, 82, 62),
					CFrame = cf * CFrame.new(lado * 5.8, 2.6, 0) }, pai)
			end
		end
		-- corrimão (impede quedas acidentais)
		for _, lado in { -1, 1 } do
			parte({ Size = Vector3.new(0.4, 0.4, (q1 - q0).Magnitude + 0.3), Material = Enum.Material.Fabric, Color = Color3.fromRGB(200, 180, 140),
				CFrame = cf * CFrame.new(lado * 5.8, 4.6, 0) }, pai)
			parte({ Size = Vector3.new(0.4, 6, (q1 - q0).Magnitude + 0.3), Transparency = 1, CanCollide = true,
				CFrame = cf * CFrame.new(lado * 6.2, 3, 0) }, pai)
		end
	end
	return p0, p1
end

-- ---------------------------------------------------------------- correntes de vento

local function corrente(def: { pos: Vector3, raio: number, topo: number }, pai: Instance)
	local base = Mundo.chaoOuIlha(def.pos.X, def.pos.Z)
	local altura = def.topo - base.Y
	local zona = parte({ Name = "Corrente", Size = Vector3.new(altura, def.raio * 2, def.raio * 2), Shape = Enum.PartType.Cylinder,
		Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false,
		CFrame = CFrame.new(base + Vector3.new(0, altura / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, pai)
	zona:SetAttribute("Raio", def.raio)
	zona:SetAttribute("Base", base.Y)
	zona:SetAttribute("Topo", def.topo)
	-- partículas a subir
	local emissor = Instance.new("ParticleEmitter")
	emissor.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emissor.Color = ColorSequence.new(Color3.fromRGB(220, 245, 255))
	emissor.LightEmission = 0.7
	emissor.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0.2) })
	emissor.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emissor.Lifetime = NumberRange.new(altura / 60, altura / 45)
	emissor.Speed = NumberRange.new(45, 60)
	emissor.Rate = 40
	emissor.EmissionDirection = Enum.NormalId.Top
	emissor.SpreadAngle = Vector2.new(4, 4)
	emissor.Shape = Enum.ParticleEmitterShape.Disc
	emissor.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	local anexo = Instance.new("Attachment")
	anexo.Parent = zona
	anexo.WorldCFrame = CFrame.new(base + Vector3.new(0, 1, 0))
	emissor.Parent = anexo
	-- círculo luminoso na base e anéis a flutuar
	parte({ Size = Vector3.new(0.4, def.raio * 2, def.raio * 2), Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon,
		Color = Color3.fromRGB(190, 235, 255), Transparency = 0.55, CanCollide = false, CanQuery = false,
		CFrame = CFrame.new(base + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, pai)
	for k = 1, 3 do
		parte({ Size = Vector3.new(0.3, def.raio * 2.1, def.raio * 2.1), Shape = Enum.PartType.Cylinder, Material = Enum.Material.ForceField,
			Color = Color3.fromRGB(200, 240, 255), Transparency = 0.2, CanCollide = false, CanQuery = false,
			CFrame = CFrame.new(base + Vector3.new(0, altura * k / 4, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, pai)
	end
end

-- ---------------------------------------------------------------- faróis, relicários, inscrições, barreiras

Mundo.farois = {} :: { [string]: { modelo: Model, prompt: ProximityPrompt, pos: Vector3, cristal: BasePart, luz: PointLight, aceso: boolean } }

local function farol(def: { id: string, nome: string, ilha: string, pos: Vector3 }, pai: Instance)
	local chao = Mundo.chaoOuIlha(def.pos.X, def.pos.Z, def.ilha)
	local m = Instance.new("Model")
	m.Name = "Farol_" .. def.id
	parte({ Size = Vector3.new(2, 10, 10), Shape = Enum.PartType.Cylinder, Material = Enum.Material.Cobblestone, Color = Color3.fromRGB(150, 146, 138),
		CFrame = CFrame.new(chao + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, m)
	parte({ Size = Vector3.new(7, 2.4, 2.4), Shape = Enum.PartType.Cylinder, Material = Enum.Material.Marble, Color = PEDRA,
		CFrame = CFrame.new(chao + Vector3.new(0, 5, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, m)
	parte({ Size = Vector3.new(1.4, 5, 5), Shape = Enum.PartType.Cylinder, Material = Enum.Material.Metal, Color = Color3.fromRGB(120, 100, 70),
		CFrame = CFrame.new(chao + Vector3.new(0, 8.8, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, m)
	for k = 0, 3 do
		local a = k * math.pi / 2
		parte({ Size = Vector3.new(0.5, 4, 0.5), Material = Enum.Material.Metal, Color = Color3.fromRGB(120, 100, 70),
			CFrame = CFrame.new(chao + Vector3.new(math.cos(a) * 2.2, 10.6, math.sin(a) * 2.2)) }, m)
	end
	local cristal = parte({ Name = "Cristal", Size = Vector3.new(1.8, 3.2, 1.8), Material = Enum.Material.Glass, Color = Color3.fromRGB(120, 120, 130),
		CFrame = CFrame.new(chao + Vector3.new(0, 11.2, 0)) * CFrame.Angles(0, math.rad(45), 0), CanCollide = false }, m)
	local luz = Instance.new("PointLight")
	luz.Color = Color3.fromRGB(255, 200, 120)
	luz.Range = 28
	luz.Brightness = 0
	luz.Shadows = true
	luz.Parent = cristal
	local brilho = Instance.new("ParticleEmitter")
	brilho.Name = "Brilho"
	brilho.Texture = "rbxasset://textures/particles/fire_main.dds"
	brilho.Color = ColorSequence.new(Color3.fromRGB(255, 190, 110), Color3.fromRGB(255, 110, 40))
	brilho.LightEmission = 1
	brilho.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0.2) })
	brilho.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	brilho.Lifetime = NumberRange.new(0.6, 1.1)
	brilho.Speed = NumberRange.new(2, 4)
	brilho.Rate = 30
	brilho.Enabled = false
	brilho.Parent = cristal
	local base = m:FindFirstChildWhichIsA("BasePart") :: BasePart
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Farol"
	prompt.ActionText = "Acender"
	prompt.ObjectText = def.nome
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt:SetAttribute("Farol", def.id)
	prompt.Parent = base
	m:SetAttribute("Farol", def.id)
	m.Parent = pai
	Mundo.farois[def.id] = { modelo = m, prompt = prompt, pos = chao, cristal = cristal, luz = luz, aceso = false }
end

function Mundo.acenderFarolVisual(id: string)
	local f = Mundo.farois[id]
	if not f or f.aceso then
		return
	end
	f.aceso = true
	f.cristal.Material = Enum.Material.Neon
	f.cristal.Color = Color3.fromRGB(255, 196, 120)
	f.luz.Brightness = 2.2
	local b = f.cristal:FindFirstChild("Brilho")
	if b and b:IsA("ParticleEmitter") then
		b.Enabled = true
	end
end

Mundo.relicarios = {} :: { [string]: { modelo: Model, prompt: ProximityPrompt } }

local function relicario(def: { id: string, x: number, z: number }, pai: Instance)
	local chao = Mundo.chaoOuIlha(def.x, def.z)
	local m = Instance.new("Model")
	m.Name = "Relicario_" .. def.id
	local caixa = parte({ Size = Vector3.new(4.5, 2.6, 3), Material = Enum.Material.Wood, Color = Color3.fromRGB(120, 86, 56),
		CFrame = CFrame.new(chao + Vector3.new(0, 1.3, 0)) * CFrame.Angles(0, math.rad(def.x % 360), 0) }, m)
	local tampa = parte({ Name = "Tampa", Size = Vector3.new(4.7, 1, 3.2), Material = Enum.Material.Wood, Color = Color3.fromRGB(140, 100, 64),
		CFrame = caixa.CFrame * CFrame.new(0, 1.8, 0) }, m)
	for _, x in { -1.6, 1.6 } do
		parte({ Size = Vector3.new(0.4, 3.8, 3.3), Material = Enum.Material.Metal, Color = Color3.fromRGB(200, 170, 90),
			CFrame = caixa.CFrame * CFrame.new(x, 0.5, 0), CanCollide = false }, m)
	end
	local brilho = Instance.new("ParticleEmitter")
	brilho.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	brilho.Color = ColorSequence.new(Color3.fromRGB(255, 230, 160))
	brilho.LightEmission = 1
	brilho.Size = NumberSequence.new(0.35)
	brilho.Lifetime = NumberRange.new(1, 2)
	brilho.Speed = NumberRange.new(1, 2)
	brilho.Rate = 6
	brilho.SpreadAngle = Vector2.new(60, 60)
	brilho.Parent = tampa
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Relicario"
	prompt.ActionText = "Abrir"
	prompt.ObjectText = "Relicário"
	prompt.HoldDuration = 0.6
	prompt.MaxActivationDistance = 9
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt:SetAttribute("Relicario", def.id)
	prompt.Parent = caixa
	m:SetAttribute("Relicario", def.id)
	m.Parent = pai
	Mundo.relicarios[def.id] = { modelo = m, prompt = prompt }
end

local function inscricao(def: { x: number, z: number, texto: string }, pai: Instance)
	local chao = Mundo.chaoOuIlha(def.x, def.z)
	local pedra = parte({ Name = "Inscricao", Size = Vector3.new(4, 5, 1.2), Material = Enum.Material.Slate, Color = Color3.fromRGB(120, 124, 132),
		CFrame = CFrame.new(chao + Vector3.new(0, 2, 0)) * CFrame.Angles(math.rad(-8), math.rad((def.x * 7) % 360), 0) }, pai)
	parte({ Size = Vector3.new(2.6, 0.25, 0.1), Material = Enum.Material.Neon, Color = Color3.fromRGB(140, 220, 255), CanCollide = false,
		CFrame = pedra.CFrame * CFrame.new(0, 1, -0.62) }, pai)
	parte({ Size = Vector3.new(1.8, 0.25, 0.1), Material = Enum.Material.Neon, Color = Color3.fromRGB(140, 220, 255), CanCollide = false,
		CFrame = pedra.CFrame * CFrame.new(0, 0.3, -0.62) }, pai)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Inscricao"
	prompt.ActionText = "Ler"
	prompt.ObjectText = "Inscrição"
	prompt.MaxActivationDistance = 8
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt:SetAttribute("Texto", def.texto)
	prompt.Parent = pedra
end

Mundo.barreiras = {} :: { [string]: { parte: BasePart, prompt: ProximityPrompt, dentro: Vector3, fora: Vector3 } }

local function barreira(id: string, arena: { ilha: string, centro: Vector3, raio: number, normal: Vector3 }, pai: Instance)
	local entrada = arena.centro + arena.normal * arena.raio
	local chao = Mundo.chaoOuIlha(entrada.X, entrada.Z, arena.ilha)
	local cf = CFrame.lookAt(chao + Vector3.new(0, 9, 0), chao + Vector3.new(0, 9, 0) + arena.normal)
	local p = parte({ Name = "Barreira_" .. id, Size = Vector3.new(18, 22, 1), Material = Enum.Material.ForceField,
		Color = Color3.fromRGB(170, 225, 255), Transparency = 0.1, CFrame = cf }, pai)
	local vento = Instance.new("ParticleEmitter")
	vento.Texture = "rbxasset://textures/particles/smoke_main.dds"
	vento.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255))
	vento.Size = NumberSequence.new(3)
	vento.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
	vento.Lifetime = NumberRange.new(1, 2)
	vento.Speed = NumberRange.new(6, 10)
	vento.Rate = 25
	vento.EmissionDirection = Enum.NormalId.Top
	vento.Parent = p
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Barreira"
	prompt.ActionText = "Atravessar"
	prompt.ObjectText = "Barreira de Vento"
	prompt.HoldDuration = 0.8
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt:SetAttribute("Arena", id)
	prompt.Parent = p
	Mundo.barreiras[id] = {
		parte = p, prompt = prompt,
		dentro = chao - arena.normal * 7 + Vector3.new(0, 3, 0),
		fora = chao + arena.normal * 7 + Vector3.new(0, 3, 0),
	}
end

function Mundo.abrirBarreira(id: string, aberta: boolean)
	local b = Mundo.barreiras[id]
	if not b then
		return
	end
	b.parte.CanCollide = not aberta
	b.parte.Transparency = if aberta then 1 else 0.1
	b.prompt.Enabled = not aberta
	local e = b.parte:FindFirstChildWhichIsA("ParticleEmitter")
	if e then
		e.Enabled = not aberta
	end
end

-- ---------------------------------------------------------------- céu, nuvens e luz

local function ambiente()
	Lighting.ClockTime = 16.3
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 3
	Lighting.Ambient = Color3.fromRGB(70, 70, 82)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 156)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.ShadowSoftness = 0.3
	Lighting.GlobalShadows = true
	for _, filho in Lighting:GetChildren() do
		if filho:IsA("PostEffect") or filho:IsA("Atmosphere") or filho:IsA("Sky") then
			filho:Destroy()
		end
	end
	local atm = Instance.new("Atmosphere")
	atm.Density = 0.32
	atm.Offset = 0.15
	atm.Color = Color3.fromRGB(214, 222, 236)
	atm.Decay = Color3.fromRGB(150, 140, 170)
	atm.Glare = 0.35
	atm.Haze = 1.4
	atm.Parent = Lighting
	local ceu = Instance.new("Sky")
	ceu.SunAngularSize = 14
	ceu.MoonAngularSize = 8
	ceu.StarCount = 1500
	ceu.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.7
	bloom.Size = 30
	bloom.Threshold = 1.2
	bloom.Parent = Lighting
	local raios = Instance.new("SunRaysEffect")
	raios.Intensity = 0.06
	raios.Spread = 0.6
	raios.Parent = Lighting
	local cor = Instance.new("ColorCorrectionEffect")
	cor.Name = "Cor"
	cor.Saturation = 0.08
	cor.Contrast = 0.06
	cor.TintColor = Color3.fromRGB(255, 249, 242)
	cor.Parent = Lighting

	-- nuvens do céu (camada alta)
	local nuvens = terreno:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	nuvens.Cover = 0.5
	nuvens.Density = 0.6
	nuvens.Color = Color3.fromRGB(255, 250, 245)
	nuvens.Parent = terreno

	-- mar de nuvens por baixo das ilhas
	local mar = parte({ Name = "MarDeNuvens", Size = Vector3.new(2048, 2, 2048), Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(236, 238, 246), Transparency = 0.15, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
		CFrame = CFrame.new(-50, 15, -200) })
	mar.Name = "MarDeNuvens"
	local rnd = Random.new(5)
	for i = 1, 12 do
		local emissor = parte({ Name = "Nuvem", Size = Vector3.new(380, 1, 380), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false,
			CFrame = CFrame.new(rnd:NextNumber(-800, 700), rnd:NextNumber(40, 90), rnd:NextNumber(-950, 500)) })
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/smoke_main.dds"
		e.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(225, 228, 240))
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 90), NumberSequenceKeypoint.new(1, 150) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.35), NumberSequenceKeypoint.new(0.7, 0.35), NumberSequenceKeypoint.new(1, 1) })
		e.Lifetime = NumberRange.new(40, 60)
		e.Speed = NumberRange.new(1, 3)
		e.Rate = 0.35
		e.RotSpeed = NumberRange.new(-2, 2)
		e.Rotation = NumberRange.new(0, 360)
		e.EmissionDirection = Enum.NormalId.Top
		e.SpreadAngle = Vector2.new(80, 80)
		e.Shape = Enum.ParticleEmitterShape.Box
		e.LightInfluence = 1
		e.Parent = emissor
		if i <= 6 then
			-- já começam com algumas nuvens visíveis
			e:Emit(4)
		end
	end
end

-- tempestade permanente sobre o Olho
local function tempestade(ilha: Config.Ilha, pai: Instance)
	local nuvem = parte({ Name = "Tempestade", Size = Vector3.new(260, 1, 260), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false,
		CFrame = CFrame.new(ilha.centro + Vector3.new(0, 90, 0)) }, pai)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(70, 72, 92), Color3.fromRGB(40, 40, 56))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 50), NumberSequenceKeypoint.new(1, 90) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.25), NumberSequenceKeypoint.new(0.8, 0.3), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(14, 22)
	e.Speed = NumberRange.new(2, 4)
	e.Rate = 2.5
	e.RotSpeed = NumberRange.new(-8, 8)
	e.Shape = Enum.ParticleEmitterShape.Box
	e.Parent = nuvem
	e:Emit(20)
	local chuva = Instance.new("ParticleEmitter")
	chuva.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	chuva.Color = ColorSequence.new(Color3.fromRGB(180, 200, 230))
	chuva.Size = NumberSequence.new(0.25)
	chuva.Lifetime = NumberRange.new(1.5, 2)
	chuva.Speed = NumberRange.new(70, 80)
	chuva.Rate = 160
	chuva.EmissionDirection = Enum.NormalId.Bottom
	chuva.Shape = Enum.ParticleEmitterShape.Box
	chuva.Parent = nuvem
end

-- ---------------------------------------------------------------- geração completa

function Mundo.gerar()
	pasta = Instance.new("Folder")
	pasta.Name = "Mundo"
	pasta.Parent = workspace
	workspace.FallenPartsDestroyHeight = -500
	terreno.Decoration = true
	terreno.WaterColor = Color3.fromRGB(70, 150, 170)
	terreno.WaterTransparency = 0.6
	terreno.WaterWaveSize = 0.08
	terreno:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(106, 150, 80))
	terreno:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(120, 160, 86))
	terreno:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(110, 92, 72))

	ambiente()
	for _, ilha in Config.ILHAS do
		gerarIlha(ilha)
	end
	gerarRochasFlutuantes()

	-- ponto de exclusão para vegetação
	local livres: { { p: Vector3, r: number } } = {}
	local function excluir(p: Vector3, r: number)
		table.insert(livres, { p = p, r = r })
	end
	for _, f in Config.FAROIS do
		excluir(f.pos, 14)
	end
	for _, r in Config.RELICARIOS do
		excluir(Vector3.new(r.x, 0, r.z), 7)
	end
	for _, c in Config.CORRENTES do
		excluir(c.pos, c.raio + 6)
	end
	for _, i in Config.INSCRICOES do
		excluir(Vector3.new(i.x, 0, i.z), 5)
	end
	for _, a in Config.ARENAS do
		excluir(a.centro, a.raio + 8)
	end
	excluir(Config.INICIO, 10)

	local estruturas = Instance.new("Folder")
	estruturas.Name = "Estruturas"
	estruturas.Parent = pasta

	-- pontes
	for _, par in Config.PONTES do
		local a, b = ilhasPorId[par[1]], ilhasPorId[par[2]]
		if a and b then
			local p0, p1 = ponte(a, b, estruturas)
			excluir(p0, 16)
			excluir(p1, 16)
		end
	end

	-- ruínas por ilha
	local rnd = Random.new(1234)
	-- círculo de menires no Despertar
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local p = Mundo.chaoOuIlha(-60 + math.cos(a) * 18, 10 + math.sin(a) * 18)
		local h = rnd:NextNumber(7, 12)
		parte({ Size = Vector3.new(3.4, h, 2.2), Material = Enum.Material.Slate, Color = Color3.fromRGB(120, 126, 134),
			CFrame = CFrame.new(p + Vector3.new(0, h / 2 - 1, 0)) * CFrame.Angles(rnd:NextNumber(-0.08, 0.08), -a, rnd:NextNumber(-0.08, 0.08)) }, estruturas)
	end
	excluir(Vector3.new(-60, 0, 10), 22)
	-- colunatas dos Jardins
	for i = 0, 9 do
		local p = Mundo.chaoOuIlha(300 + (i % 5) * 14, -95 + math.floor(i / 5) * 40)
		pilar(p, 16, i % 3 == 1, rnd, estruturas)
	end
	local arco = Mundo.chaoOuIlha(355, -75)
	parte({ Size = Vector3.new(62, 2.4, 6), Material = Enum.Material.Marble, Color = PEDRA, CFrame = CFrame.new(arco + Vector3.new(-27, 19, -20)) }, estruturas)
	excluir(Vector3.new(328, 0, -75), 38)
	-- observatório: muro circular da arena e telescópio caído
	local ag = Config.ARENAS.guardiao
	anelMuro(ag.centro, ag.raio, 18, ag.normal, 18, Enum.Material.Marble, PEDRA, estruturas)
	local tel = Mundo.chaoOuIlha(80, -560)
	parte({ Size = Vector3.new(40, 7, 7), Shape = Enum.PartType.Cylinder, Material = Enum.Material.Metal, Color = Color3.fromRGB(150, 120, 80),
		CFrame = CFrame.new(tel + Vector3.new(0, 8, 0)) * CFrame.Angles(0, math.rad(30), math.rad(25)) }, estruturas)
	excluir(Vector3.new(80, 0, -560), 22)
	-- olho da tempestade: anel de rochas negras
	local at = Config.ARENAS.tempestor
	anelMuro(at.centro, at.raio, 22, at.normal, 18, Enum.Material.Basalt, Color3.fromRGB(60, 60, 70), estruturas)

	-- vegetação
	local veg = Instance.new("Folder")
	veg.Name = "Vegetacao"
	veg.Parent = pasta
	for _, ilha in Config.ILHAS do
		local r2 = Random.new(semente(ilha.id .. "veg"))
		local colocadas = 0
		local tentativas = 0
		while colocadas < ilha.arvores and tentativas < ilha.arvores * 12 do
			tentativas += 1
			local a = r2:NextNumber(0, math.pi * 2)
			local d = math.sqrt(r2:NextNumber()) * ilha.raio * 0.85
			local x = ilha.centro.X + math.cos(a) * d
			local z = ilha.centro.Z + math.sin(a) * d
			local ok = true
			for _, e in livres do
				if (Vector2.new(x, z) - Vector2.new(e.p.X, e.p.Z)).Magnitude < e.r then
					ok = false
					break
				end
			end
			local chao = if ok then Mundo.chao(x, z) else nil
			if chao and math.abs(chao.Y - ilha.centro.Y) < 14 then
				arvore(ilha.tipoArvore, chao, r2, veg)
				colocadas += 1
			end
		end
	end

	-- correntes, faróis, relicários, inscrições, barreiras
	local interativos = Instance.new("Folder")
	interativos.Name = "Interativos"
	interativos.Parent = pasta
	local correntes = Instance.new("Folder")
	correntes.Name = "Correntes"
	correntes.Parent = workspace
	for _, c in Config.CORRENTES do
		corrente(c, correntes)
	end
	for _, f in Config.FAROIS do
		farol(f, interativos)
	end
	for _, r in Config.RELICARIOS do
		relicario(r, interativos)
	end
	for _, i in Config.INSCRICOES do
		inscricao(i, interativos)
	end
	for id, a in Config.ARENAS do
		barreira(id, a, interativos)
	end
	for _, ilha in Config.ILHAS do
		if ilha.tempestade then
			tempestade(ilha, estruturas)
		end
	end
end

return Mundo
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Personagens</string>
          <string name="Source"><![CDATA[--!strict
-- Constrói os corpos dos inimigos (esqueleto R15, para partilharem as animações dos jogadores),
-- as armas, o escudo e o planador.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Compartilhado"):WaitForChild("Config"))

local Personagens = {}

local function peca(props: { [string]: any }, pai: Instance?): BasePart
	local p = Instance.new(props.Classe or "Part") :: BasePart
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		if k ~= "Classe" then
			(p :: any)[k] = v
		end
	end
	if pai then
		p.Parent = pai
	end
	return p
end

local function soldar(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

-- Cria um modelo de arma com uma peça "Punho" na origem; a lâmina aponta para -Z do punho.
function Personagens.criarArma(tipo: string): Model
	local m = Instance.new("Model")
	m.Name = "Arma"
	local couro = Color3.fromRGB(70, 48, 34)
	local metal = Color3.fromRGB(196, 200, 206)
	local punho = peca({ Name = "Punho", Size = Vector3.new(0.35, 0.35, 1.3), Material = Enum.Material.Fabric, Color = couro, CFrame = CFrame.new() }, m)
	m.PrimaryPart = punho
	local function junta(p: BasePart)
		p.Parent = m
		soldar(punho, p)
	end
	if tipo == "espada" or tipo == "espadaPartida" or tipo == "espadaRei" then
		local comp = if tipo == "espadaPartida" then 2.2 elseif tipo == "espadaRei" then 5 else 4
		local larg = if tipo == "espadaRei" then 0.9 else 0.55
		local corL = if tipo == "espadaPartida" then Color3.fromRGB(110, 104, 100) elseif tipo == "espadaRei" then Color3.fromRGB(60, 66, 90) else metal
		junta(peca({ Size = Vector3.new(larg * 3.2, 0.25, 0.4), Material = Enum.Material.Metal, Color = Color3.fromRGB(150, 130, 80), CFrame = CFrame.new(0, 0, -0.8) }))
		junta(peca({ Size = Vector3.new(larg, 0.16, comp), Material = Enum.Material.Metal, Color = corL, CFrame = CFrame.new(0, 0, -0.95 - comp / 2) }))
		junta(peca({ Classe = "WedgePart", Size = Vector3.new(0.16, larg / 2, larg * 1.2), Material = Enum.Material.Metal, Color = corL,
			CFrame = CFrame.new(0, 0, -0.95 - comp - larg * 0.6) * CFrame.Angles(0, math.rad(-90), math.rad(90)) }))
		if tipo == "espadaRei" then
			junta(peca({ Name = "Gume", Size = Vector3.new(larg * 0.3, 0.2, comp), Material = Enum.Material.Neon, Color = Color3.fromRGB(120, 200, 255), CFrame = CFrame.new(0, 0, -0.95 - comp / 2) }))
		end
		junta(peca({ Classe = "Part", Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5), Material = Enum.Material.Metal, Color = Color3.fromRGB(150, 130, 80), CFrame = CFrame.new(0, 0, 0.75) }))
	elseif tipo == "martelo" then
		punho.Size = Vector3.new(0.35, 0.35, 5)
		punho.CFrame = CFrame.new(0, 0, -1.6)
		punho.Material = Enum.Material.Wood
		punho.Color = Color3.fromRGB(110, 80, 56)
		-- o "punho" fica deslocado: a origem da arma é onde a mão segura
		local agarre = peca({ Name = "Agarre", Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, CFrame = CFrame.new() }, m)
		soldar(punho, agarre)
		junta(peca({ Size = Vector3.new(2.6, 1.7, 1.7), Material = Enum.Material.Slate, Color = Color3.fromRGB(150, 160, 180), CFrame = CFrame.new(0, 0, -4.1) }))
		junta(peca({ Size = Vector3.new(2.8, 0.4, 1.9), Material = Enum.Material.Neon, Color = Color3.fromRGB(150, 220, 255), CFrame = CFrame.new(0, 0, -4.1) }))
		m.PrimaryPart = agarre
	elseif tipo == "lanca" then
		punho.Size = Vector3.new(0.3, 0.3, 9)
		punho.CFrame = CFrame.new(0, 0, -2.2)
		punho.Material = Enum.Material.Wood
		punho.Color = Color3.fromRGB(130, 96, 64)
		local agarre = peca({ Name = "Agarre", Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, CFrame = CFrame.new() }, m)
		soldar(punho, agarre)
		junta(peca({ Classe = "WedgePart", Size = Vector3.new(0.2, 0.55, 1.6), Material = Enum.Material.Metal, Color = metal,
			CFrame = CFrame.new(0, 0.27, -7.5) * CFrame.Angles(0, math.rad(180), 0) }))
		junta(peca({ Classe = "WedgePart", Size = Vector3.new(0.2, 0.55, 1.6), Material = Enum.Material.Metal, Color = metal,
			CFrame = CFrame.new(0, -0.27, -7.5) * CFrame.Angles(math.rad(180), 0, 0) }))
		junta(peca({ Size = Vector3.new(0.9, 0.12, 0.5), Material = Enum.Material.Fabric, Color = Color3.fromRGB(80, 140, 200), CFrame = CFrame.new(0, 0, -6.4) }))
		m.PrimaryPart = agarre
	elseif tipo == "punhos" then
		punho.Transparency = 1
	end
	return m
end

local function equiparArma(personagem: Model, tipo: string)
	local mao = personagem:FindFirstChild("RightHand") :: BasePart?
	if not mao then
		return
	end
	local antiga = personagem:FindFirstChild("Arma")
	if antiga then
		antiga:Destroy()
	end
	local arma = Personagens.criarArma(tipo)
	local agarre = arma.PrimaryPart :: BasePart
	arma:PivotTo(mao.CFrame)
	local w = Instance.new("Weld")
	w.Part0 = mao
	w.Part1 = agarre
	w.C0 = CFrame.new(0, -mao.Size.Y * 0.35, 0)
	w.Parent = agarre
	arma.Parent = personagem
end
Personagens.equiparArma = equiparArma

-- escudo preso ao antebraço esquerdo; a face fica para -X do antebraço (virado para fora)
local function equiparEscudo(personagem: Model, cor: Color3)
	local braco = personagem:FindFirstChild("LeftLowerArm") :: BasePart?
	if not braco then
		return
	end
	local m = Instance.new("Model")
	m.Name = "Escudo"
	local face = peca({ Name = "Face", Size = Vector3.new(0.3, 3.2, 2.4), Material = Enum.Material.Metal, Color = cor }, m)
	local orla = peca({ Size = Vector3.new(0.2, 3.4, 2.6), Material = Enum.Material.Metal, Color = Color3.fromRGB(170, 140, 80) }, m)
	local bossa = peca({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 0.8), Material = Enum.Material.Metal, Color = Color3.fromRGB(170, 140, 80) }, m)
	face.CFrame = CFrame.new()
	orla.CFrame = CFrame.new(0.1, 0, 0)
	bossa.CFrame = CFrame.new(-0.25, 0, 0)
	soldar(face, orla)
	soldar(face, bossa)
	-- o "cima" do escudo fica para -Z do antebraço, para que o bloqueio o ponha vertical à frente do peito
	local w = Instance.new("Weld")
	w.Part0 = braco
	w.Part1 = face
	w.C0 = CFrame.new(-braco.Size.X / 2 - 0.25, -braco.Size.Y * 0.15, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	w.Parent = face
	m.PrimaryPart = face
	m.Parent = personagem
end

-- planador (asa de tecido) às costas; fica invisível até se planar
local function equiparPlanador(personagem: Model)
	local tronco = personagem:FindFirstChild("UpperTorso") :: BasePart?
	if not tronco then
		return
	end
	local m = Instance.new("Model")
	m.Name = "Planador"
	local barra = peca({ Name = "Barra", Size = Vector3.new(9, 0.25, 0.25), Material = Enum.Material.Wood, Color = Color3.fromRGB(120, 90, 60), Transparency = 1 }, m)
	barra.CFrame = CFrame.new()
	for _, lado in { -1, 1 } do
		local asa = peca({ Name = "Asa", Size = Vector3.new(4.6, 0.12, 2.6), Material = Enum.Material.Fabric,
			Color = Color3.fromRGB(230, 236, 245), Transparency = 1 }, m)
		asa.CFrame = CFrame.new(lado * 2.3, -0.2, 1.0) * CFrame.Angles(0, 0, math.rad(lado * -10))
		soldar(barra, asa)
	end
	local w = Instance.new("Weld")
	w.Part0 = tronco
	w.Part1 = barra
	w.C0 = CFrame.new(0, tronco.Size.Y * 0.5 + 1.6, 0.6)
	w.Parent = barra
	m.Parent = personagem
end

function Personagens.equiparJogador(personagem: Model, arma: string)
	local def = Config.ARMAS[arma] or Config.ARMAS[Config.ARMA_INICIAL]
	equiparArma(personagem, def.modelo)
	if not personagem:FindFirstChild("Escudo") then
		equiparEscudo(personagem, Color3.fromRGB(70, 110, 170))
	end
	if not personagem:FindFirstChild("Planador") then
		equiparPlanador(personagem)
	end
end

-- ---------------------------------------------------------------- inimigos

local ESTILOS = {
	corrompido = { pele = Color3.fromRGB(92, 84, 104), roupa = Color3.fromRGB(52, 44, 62), olhos = Color3.fromRGB(190, 120, 255), arma = "espadaPartida", material = Enum.Material.SmoothPlastic },
	sentinela = { pele = Color3.fromRGB(140, 138, 128), roupa = Color3.fromRGB(100, 98, 92), olhos = Color3.fromRGB(110, 230, 255), arma = "espada", material = Enum.Material.Slate, escudo = true },
	espectro = { pele = Color3.fromRGB(200, 225, 245), roupa = Color3.fromRGB(170, 205, 235), olhos = Color3.fromRGB(255, 255, 255), arma = "punhos", material = Enum.Material.Glass },
	guardiao = { pele = Color3.fromRGB(116, 110, 98), roupa = Color3.fromRGB(96, 92, 84), olhos = Color3.fromRGB(255, 160, 60), arma = "punhos", material = Enum.Material.Slate },
	tempestor = { pele = Color3.fromRGB(46, 48, 66), roupa = Color3.fromRGB(30, 32, 46), olhos = Color3.fromRGB(120, 210, 255), arma = "espadaRei", material = Enum.Material.Metal },
}

local function corpo(desc: HumanoidDescription): Model
	local ok, modelo = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and modelo then
		return modelo
	end
	error("Não foi possível criar o corpo R15: " .. tostring(modelo))
end

function Personagens.criarInimigo(tipo: string): Model
	local cfg = Config.INIMIGOS[tipo]
	local est = ESTILOS[cfg.estilo]
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = est.pele
	desc.LeftArmColor = est.pele
	desc.RightArmColor = est.pele
	desc.LeftLegColor = est.roupa
	desc.RightLegColor = est.roupa
	desc.TorsoColor = est.roupa
	desc.Face = 0
	local modelo = corpo(desc)
	modelo.Name = cfg.nome
	for _, filho in modelo:GetDescendants() do
		if filho:IsA("Script") or filho:IsA("LocalScript") then
			filho:Destroy()
		elseif filho:IsA("Decal") and filho.Name == "face" then
			filho:Destroy()
		elseif filho:IsA("BasePart") and filho.Name ~= "HumanoidRootPart" then
			filho.Material = est.material
			if cfg.estilo == "espectro" then
				filho.Transparency = 0.35
			end
		end
	end
	local hum = modelo:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.MaxHealth = 1e6
	hum.Health = 1e6
	hum.AutoRotate = false
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

	local cabeca = modelo:FindFirstChild("Head") :: BasePart
	local tronco = modelo:FindFirstChild("UpperTorso") :: BasePart
	-- olhos luminosos
	for _, lado in { -1, 1 } do
		local olho = peca({ Size = Vector3.new(0.22, 0.12, 0.1), Material = Enum.Material.Neon, Color = est.olhos }, modelo)
		olho.CFrame = cabeca.CFrame * CFrame.new(lado * 0.22, 0.12, -cabeca.Size.Z / 2)
		soldar(cabeca, olho)
	end
	-- adereços por estilo
	if cfg.estilo == "corrompido" then
		local capuz = peca({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Material = Enum.Material.Fabric, Color = est.roupa }, modelo)
		capuz.CFrame = cabeca.CFrame * CFrame.new(0, 0.25, 0.22)
		soldar(cabeca, capuz)
		local manto = peca({ Size = Vector3.new(2.2, 3.2, 0.15), Material = Enum.Material.Fabric, Color = est.roupa }, modelo)
		manto.CFrame = tronco.CFrame * CFrame.new(0, -0.9, tronco.Size.Z / 2 + 0.1) * CFrame.Angles(math.rad(-8), 0, 0)
		soldar(tronco, manto)
	elseif cfg.estilo == "sentinela" or cfg.estilo == "guardiao" then
		local elmo = peca({ Size = Vector3.new(1.5, 1.4, 1.5), Material = Enum.Material.Slate, Color = est.pele }, modelo)
		elmo.CFrame = cabeca.CFrame * CFrame.new(0, 0.15, 0)
		soldar(cabeca, elmo)
		for _, lado in { -1, 1 } do
			local ombro = peca({ Size = Vector3.new(1.4, 1, 1.6), Material = Enum.Material.Slate, Color = est.pele }, modelo)
			ombro.CFrame = tronco.CFrame * CFrame.new(lado * 1.3, 0.75, 0)
			soldar(tronco, ombro)
			if cfg.estilo == "guardiao" then
				local musgo = peca({ Size = Vector3.new(1.45, 0.3, 1.65), Material = Enum.Material.Grass, Color = Color3.fromRGB(96, 140, 70) }, modelo)
				musgo.CFrame = ombro.CFrame * CFrame.new(0, 0.6, 0)
				soldar(ombro, musgo)
			end
		end
		if cfg.estilo == "guardiao" then
			for _, nome in { "RightHand", "LeftHand" } do
				local mao = modelo:FindFirstChild(nome) :: BasePart
				local punho = peca({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.5, 1.5, 1.5), Material = Enum.Material.Slate, Color = est.pele }, modelo)
				punho.CFrame = mao.CFrame
				soldar(mao, punho)
			end
			local nucleo = peca({ Size = Vector3.new(0.7, 0.7, 0.2), Material = Enum.Material.Neon, Color = est.olhos }, modelo)
			nucleo.CFrame = tronco.CFrame * CFrame.new(0, 0.2, -tronco.Size.Z / 2 - 0.05)
			soldar(tronco, nucleo)
		end
	elseif cfg.estilo == "espectro" then
		for _, nome in { "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot" } do
			local p = modelo:FindFirstChild(nome)
			if p and p:IsA("BasePart") then
				p.Transparency = 1
			end
		end
		local veu = Instance.new("ParticleEmitter")
		veu.Texture = "rbxasset://textures/particles/smoke_main.dds"
		veu.Color = ColorSequence.new(Color3.fromRGB(220, 240, 255))
		veu.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0.4) })
		veu.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		veu.Lifetime = NumberRange.new(0.6, 1)
		veu.Speed = NumberRange.new(1, 3)
		veu.Rate = 30
		veu.EmissionDirection = Enum.NormalId.Bottom
		veu.Parent = modelo:FindFirstChild("LowerTorso")
		for _, nome in { "RightHand", "LeftHand" } do
			local mao = modelo:FindFirstChild(nome) :: BasePart
			mao.Material = Enum.Material.Neon
			mao.Color = Color3.fromRGB(200, 240, 255)
		end
	elseif cfg.estilo == "tempestor" then
		for i = 0, 6 do
			local a = i / 7 * math.pi * 2
			local espinho = peca({ Size = Vector3.new(0.2, 0.7 + (i % 2) * 0.4, 0.2), Material = Enum.Material.Metal, Color = Color3.fromRGB(150, 130, 80) }, modelo)
			espinho.CFrame = cabeca.CFrame * CFrame.new(math.cos(a) * 0.5, 0.8, math.sin(a) * 0.5)
			soldar(cabeca, espinho)
		end
		local capa = peca({ Size = Vector3.new(2.3, 3.8, 0.12), Material = Enum.Material.Fabric, Color = Color3.fromRGB(70, 30, 40) }, modelo)
		capa.CFrame = tronco.CFrame * CFrame.new(0, -1.2, tronco.Size.Z / 2 + 0.1) * CFrame.Angles(math.rad(-6), 0, 0)
		soldar(tronco, capa)
		local faiscas = Instance.new("ParticleEmitter")
		faiscas.Name = "Faiscas"
		faiscas.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		faiscas.Color = ColorSequence.new(Color3.fromRGB(150, 220, 255))
		faiscas.LightEmission = 1
		faiscas.Size = NumberSequence.new(0.3)
		faiscas.Lifetime = NumberRange.new(0.2, 0.5)
		faiscas.Speed = NumberRange.new(4, 8)
		faiscas.Rate = 10
		faiscas.SpreadAngle = Vector2.new(180, 180)
		faiscas.Parent = tronco
	end
	equiparArma(modelo, est.arma)
	if est.escudo then
		equiparEscudo(modelo, Color3.fromRGB(90, 92, 100))
	end
	-- barra de vida por cima da cabeça (só aparece depois de levar dano)
	local bb = Instance.new("BillboardGui")
	bb.Name = "BarraVida"
	bb.Size = UDim2.fromOffset(110, 8)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 90
	bb.Enabled = false
	local fundo = Instance.new("Frame")
	fundo.Size = UDim2.fromScale(1, 1)
	fundo.BackgroundColor3 = Color3.fromRGB(20, 16, 16)
	fundo.BackgroundTransparency = 0.3
	fundo.BorderSizePixel = 0
	fundo.Parent = bb
	local valor = Instance.new("Frame")
	valor.Name = "Valor"
	valor.Size = UDim2.fromScale(1, 1)
	valor.BackgroundColor3 = Color3.fromRGB(170, 40, 30)
	valor.BorderSizePixel = 0
	valor.Parent = fundo
	bb.Parent = cabeca

	modelo:SetAttribute("Tipo", tipo)
	if cfg.escala ~= 1 then
		modelo:ScaleTo(cfg.escala)
	end
	-- altura das ancas calculada a partir dos pés (garante que os pés tocam no chão depois de escalar)
	local raiz = modelo:FindFirstChild("HumanoidRootPart") :: BasePart
	local pe = modelo:FindFirstChild("LeftFoot") :: BasePart?
	if raiz and pe then
		hum.HipHeight = (raiz.Position.Y - raiz.Size.Y / 2) - (pe.Position.Y - pe.Size.Y / 2)
	end
	if cfg.flutua then
		hum.HipHeight += 1.6
	end
	modelo:SetAttribute("Escala", cfg.escala)
	return modelo
end

return Personagens
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="14">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">40</float>
      <bool name="EnableMouseLockOption">false</bool>
      <token name="GameSettingsAvatar">1</token>
    </Properties>
    <Item class="StarterCharacterScripts" referent="15">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="LocalScript" referent="16">
        <Properties>
          <string name="Name">Animate</string>
          <string name="Source"><![CDATA[-- Substitui as animações padrão do Roblox: as animações deste jogo são feitas por código (Cliente/Animador).
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="17">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Substitui a regeneração automática de vida do Roblox: aqui só se cura com o Orvalho Celeste ou nos faróis.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="18">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Cliente</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Animador</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Animação procedural de todas as personagens (jogadores e inimigos), feita no cliente.
-- Lê o estado de cada personagem (atributos Acao/AcaoT0/AcaoDur, velocidade, bloqueio, planar)
-- e escreve diretamente nas articulações Motor6D do esqueleto R15.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Poses = require(ReplicatedStorage:WaitForChild("Compartilhado"):WaitForChild("Poses"))

local Animador = {}
local rigs = setmetatable({}, { __mode = "k" })
local estadoLocal -- tabela partilhada com o Main (previsão das ações do próprio jogador)

local function suave(t)
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function obterRig(modelo)
	local r = rigs[modelo]
	if r then
		return r
	end
	local motores = {}
	for _, d in modelo:GetDescendants() do
		if d:IsA("Motor6D") then
			motores[d.Name] = d
		end
	end
	if not motores.Root then
		return nil
	end
	r = { motores = motores, atual = {}, y = 0, piv = 0, fase = math.random() * 6, bloqueio = 0, planar = 0, ar = 0 }
	for nome in motores do
		r.atual[nome] = Vector3.zero
	end
	modelo:GetAttributeChangedSignal("AcaoT0"):Connect(function()
		r.chegadaAtributo = os.clock()
	end)
	rigs[modelo] = r
	return r
end

-- devolve a ação a mostrar e o tempo normalizado (ou nil)
local function acaoAtual(modelo, r, local_)
	local nome = modelo:GetAttribute("Acao")
	local t0 = modelo:GetAttribute("AcaoT0")
	local dur = modelo:GetAttribute("AcaoDur")
	local manter = modelo:GetAttribute("AcaoManter")
	local tAttr = nil
	if nome and t0 and dur and dur > 0 then
		tAttr = (workspace:GetServerTimeNow() - t0) / dur
	end
	-- previsão local do próprio jogador (resposta imediata ao botão)
	if local_ and estadoLocal and estadoLocal.acao then
		local a = estadoLocal.acao
		local chegada = r.chegadaAtributo or 0
		local mesmaAcao = nome == a.nome and math.abs(chegada - a.inicio) < 0.6
		if a.inicio >= chegada - 0.05 or mesmaAcao then
			local t = (os.clock() - a.inicio) / a.dur
			if t < 1 then
				return a.nome, t
			end
			if not mesmaAcao and a.inicio > chegada then
				return nil, nil
			end
		end
	end
	if tAttr then
		if tAttr < 1 then
			return nome, tAttr
		elseif manter then
			return nome, 1
		end
	end
	return nil, nil
end

local function mostrarPlanador(modelo, visivel)
	local p = modelo:FindFirstChild("Planador")
	if not p then
		return
	end
	for _, d in p:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Barra" then
			d.Transparency = if visivel then 0.05 else 1
		elseif d:IsA("BasePart") then
			d.Transparency = if visivel then 0 else 1
		end
	end
end

local function animar(modelo, dt, local_)
	local r = obterRig(modelo)
	if not r then
		return
	end
	local raiz = modelo:FindFirstChild("HumanoidRootPart")
	if not raiz then
		return
	end
	local escala = modelo:GetAttribute("Escala") or 1
	local vel = raiz.AssemblyLinearVelocity
	local v = Vector3.new(vel.X, 0, vel.Z).Magnitude / escala
	local alvo = {}
	for n, val in Poses.POSTURA do
		alvo[n] = val
	end

	-- locomoção
	local k = math.min(1.4, v / 14)
	local corrida = if v > 19 then 1 else 0
	r.fase += dt * (if v > 0.8 then 4 + v * 0.38 else 0)
	local s, c = math.sin(r.fase), math.cos(r.fase)
	local amp = 0.55 * k + corrida * 0.25
	local joelho = 0.9 * k + corrida * 0.5
	alvo.LeftHip = Vector3.new(s * amp, 0, 0)
	alvo.RightHip = Vector3.new(-s * amp, 0, 0)
	alvo.LeftKnee = Vector3.new(-(0.08 + math.max(0, c) * joelho), 0, 0)
	alvo.RightKnee = Vector3.new(-(0.08 + math.max(0, -c) * joelho), 0, 0)
	alvo.LeftAnkle = Vector3.new(-s * amp * 0.25, 0, 0)
	alvo.RightAnkle = Vector3.new(s * amp * 0.25, 0, 0)
	alvo.Waist = alvo.Waist + Vector3.new(-(0.05 * k + corrida * 0.28), s * 0.08 * k, 0)
	alvo.LeftShoulder = alvo.LeftShoulder + Vector3.new(-s * (0.12 * k + corrida * 0.6), 0, 0)
	alvo.RightShoulder = alvo.RightShoulder + Vector3.new(s * (0.12 * k + corrida * 0.6), 0, 0)
	if corrida > 0 then
		alvo.RightElbow = Vector3.new(1.1, 0, 0)
	end
	local y = -math.abs(c) * 0.1 * k
	if v < 0.8 then
		y -= 0.03 + math.sin(os.clock() * 1.2) * 0.025
	end
	local piv = 0

	-- no ar e a planar
	local planando = modelo:GetAttribute("Planando") == true
	r.planar += ((if planando then 1 else 0) - r.planar) * math.min(1, dt * 10)
	if r.planarVisivel ~= planando then
		r.planarVisivel = planando
		mostrarPlanador(modelo, planando)
	end
	local noAr = math.abs(vel.Y) > 10 and not planando
	r.ar += ((if noAr then 1 else 0) - r.ar) * math.min(1, dt * 8)
	if r.ar > 0.01 then
		local w = r.ar
		alvo.LeftHip = alvo.LeftHip:Lerp(Vector3.new(0.5, 0, 0), w)
		alvo.RightHip = alvo.RightHip:Lerp(Vector3.new(0.2, 0, 0), w)
		alvo.LeftKnee = alvo.LeftKnee:Lerp(Vector3.new(-0.9, 0, 0), w)
		alvo.RightKnee = alvo.RightKnee:Lerp(Vector3.new(-0.5, 0, 0), w)
	end
	if r.planar > 0.01 then
		local w = r.planar
		alvo.RightShoulder = alvo.RightShoulder:Lerp(Vector3.new(2.9, 0, -0.35), w)
		alvo.LeftShoulder = alvo.LeftShoulder:Lerp(Vector3.new(2.9, 0, 0.35), w)
		alvo.RightElbow = alvo.RightElbow:Lerp(Vector3.new(0.2, 0, 0), w)
		alvo.LeftElbow = alvo.LeftElbow:Lerp(Vector3.new(0.2, 0, 0), w)
		alvo.Waist = alvo.Waist:Lerp(Vector3.new(-0.25, 0, 0), w)
		alvo.LeftHip = alvo.LeftHip:Lerp(Vector3.new(-0.25, 0, 0), w)
		alvo.RightHip = alvo.RightHip:Lerp(Vector3.new(-0.15, 0, 0), w)
		alvo.LeftKnee = alvo.LeftKnee:Lerp(Vector3.new(-0.4, 0, 0), w)
		alvo.RightKnee = alvo.RightKnee:Lerp(Vector3.new(-0.3, 0, 0), w)
	end

	-- bloqueio com escudo
	local bloq = modelo:GetAttribute("Bloqueando") == true or (local_ and estadoLocal and estadoLocal.bloqueando)
	r.bloqueio += ((if bloq then 1 else 0) - r.bloqueio) * math.min(1, dt * 14)
	if r.bloqueio > 0.01 then
		for n, val in Poses.BLOQUEIO do
			alvo[n] = (alvo[n] or Vector3.zero):Lerp(val, r.bloqueio)
		end
	end

	-- ação (ataques, rolar, beber, atordoado, morrer…)
	local rolo = 0
	local nome, t = acaoAtual(modelo, r, local_)
	if nome then
		local pose, ay, ap = Poses.avaliar(nome, t)
		for n, val in pose do
			alvo[n] = val
		end
		y += ay
		piv = ap
		if nome == "rolar" then
			rolo = -suave((t - 0.1) / 0.68) * math.pi * 2
		end
	end

	-- aplicar com suavização
	local alfa = 1 - math.exp(-dt * 18)
	for n, m in r.motores do
		local alvoN = alvo[n]
		if alvoN then
			local atual = r.atual[n] or Vector3.zero
			atual = atual:Lerp(alvoN, alfa)
			r.atual[n] = atual
			if n ~= "Root" then
				m.Transform = CFrame.Angles(atual.X, atual.Y, atual.Z)
			end
		end
	end
	r.y += (y - r.y) * alfa
	r.piv += (piv - r.piv) * alfa
	local raizM = r.motores.Root
	if raizM then
		raizM.Transform = CFrame.new(0, r.y * escala, 0) * CFrame.Angles(r.piv + rolo, 0, 0)
	end
end

function Animador.iniciar(estado)
	estadoLocal = estado
	local camara = workspace.CurrentCamera
	RunService.PreSimulation:Connect(function(dt)
		local foco = camara.CFrame.Position
		local eu = Players.LocalPlayer.Character
		for _, plr in Players:GetPlayers() do
			local ch = plr.Character
			if ch and ch.Parent then
				local raiz = ch:FindFirstChild("HumanoidRootPart")
				if raiz and (raiz.Position - foco).Magnitude < 400 then
					animar(ch, dt, ch == eu)
				end
			end
		end
		local pasta = workspace:FindFirstChild("Inimigos")
		if pasta then
			for _, m in pasta:GetChildren() do
				local raiz = m:FindFirstChild("HumanoidRootPart")
				if raiz and (raiz.Position - foco).Magnitude < 350 then
					animar(m, dt, false)
				end
			end
		end
	end)
end

return Animador
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Camara</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Câmara em terceira pessoa: rato/manípulo/toque, colisão com o cenário, fixar alvo e tremor.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Camara = {}
local jogador = Players.LocalPlayer
local cam = workspace.CurrentCamera

local yaw = 0
local pitch = 0.25
local distAtual = 13
local foco = Vector3.zero
local tremor = 0
local estado -- tabela partilhada
local sensibilidade = 0.0032
local direitoX, direitoY = 0, 0
local trocou = false

local filtro = RaycastParams.new()
filtro.FilterType = Enum.RaycastFilterType.Exclude

function Camara.tremer(i)
	tremor = math.min(1.2, tremor + i)
end

function Camara.yaw()
	return yaw
end

function Camara.definirYaw(v)
	yaw = v
end

-- candidatos a alvo: inimigos vivos à frente da câmara
local function candidatos()
	local r = {}
	local pasta = workspace:FindFirstChild("Inimigos")
	local c = jogador.Character
	local raizJ = c and c:FindFirstChild("HumanoidRootPart")
	if not pasta or not raizJ then
		return r
	end
	local frente = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	for _, m in pasta:GetChildren() do
		local raiz = m:FindFirstChild("HumanoidRootPart")
		if raiz and (m:GetAttribute("Vida") or 0) > 0 then
			local d = raiz.Position - raizJ.Position
			local dist = Vector3.new(d.X, 0, d.Z).Magnitude
			if dist < 90 and math.abs(d.Y) < 40 then
				local u = Vector3.new(d.X, 0, d.Z).Unit
				local ang = math.acos(math.clamp(u:Dot(frente), -1, 1))
				if ang < 1.1 then
					table.insert(r, { m = m, raiz = raiz, dist = dist, ang = ang, lado = u:Dot(Vector3.new(math.cos(yaw), 0, -math.sin(yaw))) })
				end
			end
		end
	end
	return r
end

function Camara.alternarAlvo()
	if estado.alvo then
		estado.alvo = nil
		return
	end
	local lista = candidatos()
	table.sort(lista, function(a, b)
		return a.ang * 8 + a.dist * 0.04 < b.ang * 8 + b.dist * 0.04
	end)
	if lista[1] then
		estado.alvo = lista[1].m
	else
		-- sem alvo: centra a câmara atrás da personagem
		local c = jogador.Character
		local raiz = c and c:FindFirstChild("HumanoidRootPart")
		if raiz then
			local lv = raiz.CFrame.LookVector
			yaw = math.atan2(-lv.X, -lv.Z)
		end
	end
end

local function trocarAlvo(dir)
	local atual = estado.alvo
	if not atual then
		return
	end
	local lista = candidatos()
	local raizA = atual:FindFirstChild("HumanoidRootPart")
	if not raizA then
		return
	end
	local melhor, md = nil, math.huge
	for _, cnd in lista do
		if cnd.m ~= atual then
			if (dir > 0 and cnd.lado > 0) or (dir < 0 and cnd.lado < 0) then
				if cnd.ang < md then
					melhor, md = cnd.m, cnd.ang
				end
			end
		end
	end
	if melhor then
		estado.alvo = melhor
	end
end

function Camara.iniciar(est)
	estado = est
	cam.CameraType = Enum.CameraType.Scriptable
	UserInputService.InputChanged:Connect(function(input, processado)
		if input.UserInputType == Enum.UserInputType.Gamepad1 and input.KeyCode == Enum.KeyCode.Thumbstick2 then
			direitoX = if math.abs(input.Position.X) > 0.15 then input.Position.X else 0
			direitoY = if math.abs(input.Position.Y) > 0.15 then input.Position.Y else 0
		elseif input.UserInputType == Enum.UserInputType.Touch and not processado then
			yaw -= input.Delta.X * 0.006
			pitch += input.Delta.Y * 0.006
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and estado.alvo then
			trocarAlvo(if input.Position.Z > 0 then 1 else -1)
		end
	end)

	RunService:BindToRenderStep("CeuPartidoCamara", Enum.RenderPriority.Camera.Value + 1, function(dt)
		cam.CameraType = Enum.CameraType.Scriptable
		local c = jogador.Character
		local raiz = c and c:FindFirstChild("HumanoidRootPart")
		local hum = c and c:FindFirstChildOfClass("Humanoid")
		if not raiz or not hum then
			return
		end
		-- rato bloqueado ao centro enquanto se joga
		if estado.menu then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		else
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			UserInputService.MouseIconEnabled = false
		end
		local delta = if estado.menu then Vector2.zero else UserInputService:GetMouseDelta()
		local alvo = estado.alvo
		if alvo then
			local raizA = alvo:FindFirstChild("HumanoidRootPart")
			if not raizA or (alvo:GetAttribute("Vida") or 0) <= 0 or (raizA.Position - raiz.Position).Magnitude > 110 then
				estado.alvo = nil
				alvo = nil
			end
		end
		if alvo then
			local raizA = alvo:FindFirstChild("HumanoidRootPart")
			local d = raizA.Position - raiz.Position
			local yAlvo = math.atan2(-d.X, -d.Z)
			local dif = math.atan2(math.sin(yAlvo - yaw), math.cos(yAlvo - yaw))
			yaw += dif * math.min(1, dt * 7)
			local escalaA = alvo:GetAttribute("Escala") or 1
			local pAlvo = math.clamp(0.22 + (escalaA - 1) * 0.06, 0.12, 0.5)
			pitch += (pAlvo - pitch) * math.min(1, dt * 4)
			-- trocar de alvo com um movimento rápido
			if math.abs(delta.X) > 30 and not trocou then
				trocarAlvo(if delta.X > 0 then 1 else -1)
				trocou = true
			elseif math.abs(direitoX) > 0.85 and not trocou then
				trocarAlvo(if direitoX > 0 then 1 else -1)
				trocou = true
			elseif math.abs(delta.X) < 5 and math.abs(direitoX) < 0.3 then
				trocou = false
			end
		else
			yaw -= delta.X * sensibilidade * estado.sensibilidade
			pitch += delta.Y * sensibilidade * estado.sensibilidade * (if estado.inverterY then -1 else 1)
			yaw -= direitoX * dt * 3.2
			pitch -= direitoY * dt * 2.2
		end
		pitch = math.clamp(pitch, -0.6, 1.25)

		local altura = if hum.RigType == Enum.HumanoidRigType.R15 then 2.4 else 2
		local destino = raiz.Position + Vector3.new(0, altura, 0)
		foco = foco:Lerp(destino, math.min(1, dt * 16))
		if (foco - destino).Magnitude > 30 then
			foco = destino
		end
		local escalaAlvo = alvo and (alvo:GetAttribute("Escala") or 1) or 1
		local distBase = (if alvo then 15 + (escalaAlvo - 1) * 4 else 13) + (if estado.planando then 4 else 0)
		local dir = Vector3.new(-math.sin(yaw) * math.cos(pitch), -math.sin(pitch), -math.cos(yaw) * math.cos(pitch)) -- direção do olhar
		-- colisão com o cenário
		local ignorar = { workspace:FindFirstChild("Inimigos"), workspace:FindFirstChild("Correntes"), workspace:FindFirstChild("Ecos") }
		for _, p in Players:GetPlayers() do
			if p.Character then
				table.insert(ignorar, p.Character)
			end
		end
		filtro.FilterDescendantsInstances = ignorar
		local dist = distBase
		local hit = workspace:Raycast(foco, -dir * (distBase + 0.5), filtro)
		if hit then
			dist = math.max(1.5, (hit.Position - foco).Magnitude - 0.8)
		end
		distAtual += (dist - distAtual) * math.min(1, dt * (if dist < distAtual then 25 else 5))
		local pos = foco - dir * distAtual
		local olhar = foco
		if alvo then
			local raizA = alvo:FindFirstChild("HumanoidRootPart")
			olhar = foco:Lerp(raizA.Position + Vector3.new(0, 1.5 * escalaAlvo, 0), 0.3)
		end
		local cf = CFrame.lookAt(pos, olhar)
		-- tremor
		tremor = math.max(0, tremor - dt * 1.8)
		if tremor > 0 then
			local k = tremor * tremor
			local t = os.clock()
			cf = cf * CFrame.new(math.sin(t * 61) * 0.35 * k, math.sin(t * 53 + 1) * 0.3 * k, 0) * CFrame.Angles(0, 0, math.sin(t * 47) * 0.03 * k)
		end
		cam.CFrame = cf
	end)
end

return Camara
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Controles</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Controlos e movimento local: ataques, esquiva, corrida, bloqueio, Orvalho, troca de arma, fixar alvo,
-- planar e correntes de vento. As ações são enviadas ao servidor (que decide o dano) e mostradas já no cliente.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Compartilhado"):WaitForChild("Config"))

local Controles = {}
local jogador = Players.LocalPlayer
local estado
local R
local Camara
local J = Config.JOGADOR

local pendente = nil -- ação carregada um pouco antes do fim da anterior
local combo = 0
local fimUltimoAtaque = 0
local shiftDesde = nil
local impulso -- LinearVelocity para esquiva, avanço dos golpes e empurrões

local function agora()
	return os.clock()
end

local function energia()
	return jogador:GetAttribute("Energia") or 0
end

local function personagem()
	local c = jogador.Character
	if not c then
		return nil
	end
	local hum = c:FindFirstChildOfClass("Humanoid")
	local raiz = c:FindFirstChild("HumanoidRootPart")
	if not hum or not raiz or hum.Health <= 0 then
		return nil
	end
	return c, hum, raiz
end

local function mostrarAcao(nome, dur)
	estado.acao = { nome = nome, inicio = agora(), dur = dur }
end

local function mudarLocal(e, dur)
	estado.local_ = e
	estado.desde = agora()
	estado.ate = agora() + (dur or math.huge)
end
Controles.mudarLocal = mudarLocal
Controles.mostrarAcao = mostrarAcao

local function podeAgir()
	local t = agora()
	if estado.local_ == "livre" then
		return true
	end
	if estado.local_ == "ataque" and estado.golpe and t >= estado.desde + estado.golpe.fim then
		return true
	end
	if estado.local_ == "rolar" and t >= estado.ate - 0.15 then
		return true
	end
	return false
end

local function noAr(hum)
	return hum.FloorMaterial == Enum.Material.Air
end

local function virarPara(raiz, dir)
	local d = Vector3.new(dir.X, 0, dir.Z)
	if d.Magnitude > 0.05 then
		raiz.CFrame = CFrame.lookAt(raiz.Position, raiz.Position + d)
	end
end

local function direcaoDesejada(hum)
	local m = hum.MoveDirection
	return Vector3.new(m.X, 0, m.Z)
end

-- ---------------------------------------------------------------- ações

local function atacar(forte)
	local c, hum, raiz = personagem()
	if not c or noAr(hum) or energia() <= 0 then
		return false
	end
	local arma = Config.ARMAS[jogador:GetAttribute("Arma") or Config.ARMA_INICIAL] or Config.ARMAS[Config.ARMA_INICIAL]
	if estado.local_ ~= "ataque" and agora() - fimUltimoAtaque > 0.6 then
		combo = 0
	end
	local def = if forte then arma.forte else arma.leve[(combo % #arma.leve) + 1]
	combo += 1
	fimUltimoAtaque = agora() + def.dur
	R.Acao:FireServer(if forte then "forte" else "leve")
	mudarLocal("ataque", def.dur)
	estado.golpe = def
	estado.golpeForte = forte
	mostrarAcao(def.anim, def.dur)
	-- orientação no início do golpe
	if estado.alvo then
		local raizA = estado.alvo:FindFirstChild("HumanoidRootPart")
		if raizA then
			virarPara(raiz, raizA.Position - raiz.Position)
		end
	else
		local d = direcaoDesejada(hum)
		if d.Magnitude > 0.2 then
			virarPara(raiz, d)
		end
	end
	return true
end

local function rolar()
	local c, hum, raiz = personagem()
	if not c or noAr(hum) or energia() <= 0 then
		return false
	end
	local d = direcaoDesejada(hum)
	local tras = d.Magnitude < 0.2
	R.Acao:FireServer("rolar", if tras then "tras" else nil)
	mudarLocal("rolar", J.durRolar)
	estado.rolTras = tras
	if tras then
		estado.dirRolar = -Vector3.new(raiz.CFrame.LookVector.X, 0, raiz.CFrame.LookVector.Z).Unit
		mostrarAcao("recuar", J.durRolar)
	else
		estado.dirRolar = d.Unit
		virarPara(raiz, d)
		mostrarAcao("rolar", J.durRolar)
	end
	return true
end

local function beber()
	local c, hum = personagem()
	if not c or noAr(hum) or estado.local_ ~= "livre" then
		return false
	end
	if (jogador:GetAttribute("Orvalho") or 0) <= 0 then
		R.Acao:FireServer("beber") -- o servidor mostra o aviso
		return true
	end
	R.Acao:FireServer("beber")
	mudarLocal("beber", 1.35)
	mostrarAcao("beber", 1.35)
	return true
end

local function definirPlanar(v)
	if estado.planando == v then
		return
	end
	estado.planando = v
	R.Acao:FireServer("planar", v)
end

local function tentar(acao)
	local c, hum = personagem()
	if estado.menu or not c then
		return
	end
	-- no ar, a esquiva fecha o planador
	if acao == "rolar" and estado.planando and noAr(hum) then
		definirPlanar(false)
		return
	end
	if not podeAgir() then
		pendente = { acao = acao, ate = agora() + 0.4 }
		return
	end
	local ok = false
	if acao == "leve" then
		ok = atacar(false)
	elseif acao == "forte" then
		ok = atacar(true)
	elseif acao == "rolar" then
		ok = rolar()
	elseif acao == "beber" then
		ok = beber()
	end
	if ok then
		pendente = nil
	end
end

local function definirCorrida(v)
	if estado.correndo == v then
		return
	end
	estado.correndo = v
	R.Acao:FireServer("correr", v)
end

-- ---------------------------------------------------------------- ligações

local function ligarAcoes()
	local function acao(nome, fn, toque, ...)
		ContextActionService:BindAction(nome, function(_, inputState, input)
			if estado.menu then
				return Enum.ContextActionResult.Pass
			end
			fn(inputState, input)
			return Enum.ContextActionResult.Sink
		end, toque, ...)
	end
	acao("CP_Leve", function(s)
		if s == Enum.UserInputState.Begin then
			tentar("leve")
		end
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR1)
	acao("CP_Forte", function(s)
		if s == Enum.UserInputState.Begin then
			tentar("forte")
		end
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonR2)
	acao("CP_Bloquear", function(s)
		local v = s == Enum.UserInputState.Begin or s == Enum.UserInputState.Change
		if estado.bloqueando ~= v then
			estado.bloqueando = v
			R.Acao:FireServer("bloquear", v)
		end
	end, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL1)
	-- Shift / B: tocar = esquivar, manter = correr
	acao("CP_Esquivar", function(s, input)
		if input.UserInputType == Enum.UserInputType.Touch then
			if s == Enum.UserInputState.Begin then
				tentar("rolar")
			end
			return
		end
		if s == Enum.UserInputState.Begin then
			shiftDesde = agora()
		elseif s == Enum.UserInputState.End or s == Enum.UserInputState.Cancel then
			if shiftDesde and agora() - shiftDesde < 0.24 then
				tentar("rolar")
			end
			shiftDesde = nil
			definirCorrida(false)
		end
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonB)
	acao("CP_Beber", function(s)
		if s == Enum.UserInputState.Begin then
			tentar("beber")
		end
	end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
	acao("CP_Alvo", function(s)
		if s == Enum.UserInputState.Begin then
			Camara.alternarAlvo()
		end
	end, true, Enum.KeyCode.Q, Enum.UserInputType.MouseButton3, Enum.KeyCode.ButtonR3)
	acao("CP_Arma", function(s)
		if s == Enum.UserInputState.Begin and estado.local_ == "livre" then
			R.Acao:FireServer("trocarArma")
		end
	end, false, Enum.KeyCode.X, Enum.KeyCode.DPadUp)
	-- no ecrã tátil: botão para correr (alternar)
	if UserInputService.TouchEnabled then
		ContextActionService:BindAction("CP_Correr", function(_, s)
			if s == Enum.UserInputState.Begin then
				definirCorrida(not estado.correndo)
			end
			return Enum.ContextActionResult.Sink
		end, true)
		local botoes = {
			CP_Leve = { "Atacar", UDim2.new(1, -95, 1, -95) },
			CP_Forte = { "Forte", UDim2.new(1, -165, 1, -60) },
			CP_Bloquear = { "Escudo", UDim2.new(1, -165, 1, -130) },
			CP_Esquivar = { "Rolar", UDim2.new(1, -95, 1, -165) },
			CP_Beber = { "Orvalho", UDim2.new(1, -235, 1, -95) },
			CP_Alvo = { "Alvo", UDim2.new(1, -235, 1, -165) },
			CP_Correr = { "Correr", UDim2.new(1, -25 - 70, 1, -235) },
		}
		for nome, b in botoes do
			ContextActionService:SetTitle(nome, b[1])
			ContextActionService:SetPosition(nome, b[2])
		end
	end
	-- saltar no ar abre (ou fecha) o planador
	UserInputService.JumpRequest:Connect(function()
		local c, hum = personagem()
		if not c or estado.menu then
			return
		end
		if noAr(hum) then
			if not estado.planando and estado.saltoT and agora() - estado.saltoT > 0.3 then
				definirPlanar(true)
			end
		else
			estado.saltoT = agora()
		end
	end)
end

-- ---------------------------------------------------------------- ciclo por fotograma

local function correnteEm(pos)
	local pasta = workspace:FindFirstChild("Correntes")
	if not pasta then
		return nil
	end
	for _, z in pasta:GetChildren() do
		local raio = z:GetAttribute("Raio")
		local base = z:GetAttribute("Base")
		local topo = z:GetAttribute("Topo")
		if raio and base and topo then
			local d = Vector2.new(pos.X - z.Position.X, pos.Z - z.Position.Z).Magnitude
			if d < raio and pos.Y > base - 3 and pos.Y < topo + 12 then
				return z, topo
			end
		end
	end
	return nil
end

local function garantirImpulso(raiz)
	if impulso and impulso.Parent and impulso.Attachment0 and impulso.Attachment0.Parent == raiz then
		return impulso
	end
	local a = Instance.new("Attachment")
	a.Name = "AnexoImpulso"
	a.Parent = raiz
	impulso = Instance.new("LinearVelocity")
	impulso.Name = "Impulso"
	impulso.Attachment0 = a
	impulso.RelativeTo = Enum.ActuatorRelativeTo.World
	impulso.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	impulso.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	impulso.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	impulso.MaxForce = 1e6
	impulso.Enabled = false
	impulso.Parent = raiz
	return impulso
end

function Controles.empurrar(dir, forca)
	estado.empurraoAte = agora() + 0.18
	estado.empurraoVel = Vector3.new(dir.X, 0, dir.Z) * forca
end

local function atualizar(dt)
	local c, hum, raiz = personagem()
	if not c then
		return
	end
	local t = agora()
	local imp = garantirImpulso(raiz)

	-- atordoamento decidido pelo servidor
	local atordoado = c:GetAttribute("AtordoadoAte")
	if atordoado and atordoado > workspace:GetServerTimeNow() and estado.local_ ~= "atordoado" and estado.local_ ~= "sentado" then
		mudarLocal("atordoado", atordoado - workspace:GetServerTimeNow())
		estado.acao = nil
		pendente = nil
	end
	-- fim dos estados temporários
	if estado.local_ ~= "livre" and estado.local_ ~= "sentado" and t >= estado.ate then
		mudarLocal("livre")
	end
	-- ação carregada antes do tempo
	if pendente then
		if t > pendente.ate then
			pendente = nil
		elseif podeAgir() then
			tentar(pendente.acao)
		end
	end
	-- corrida (manter Shift)
	if shiftDesde and t - shiftDesde >= 0.24 and estado.local_ == "livre" then
		definirCorrida(energia() > 1)
	end

	-- velocidade de andar conforme o estado
	local livre = estado.local_ == "livre"
	local velAndar = 0
	if livre and not estado.menu then
		if estado.bloqueando then
			velAndar = J.velBloquear
		elseif estado.correndo and energia() > 1 then
			velAndar = J.velCorrer
		else
			velAndar = J.velAndar
		end
	elseif estado.local_ == "beber" then
		velAndar = J.velBeber
	end
	hum.WalkSpeed = velAndar
	hum.UseJumpPower = false
	hum.JumpHeight = if livre and not estado.menu then 7.5 else 0

	-- orientação: com alvo fixo, a personagem encara-o
	local alvo = estado.alvo
	local raizA = alvo and alvo:FindFirstChild("HumanoidRootPart")
	if raizA and (livre or estado.local_ == "beber") and not estado.correndo and not noAr(hum) then
		hum.AutoRotate = false
		local d = raizA.Position - raiz.Position
		local alvoCF = CFrame.lookAt(raiz.Position, raiz.Position + Vector3.new(d.X, 0, d.Z))
		raiz.CFrame = raiz.CFrame:Lerp(alvoCF, math.min(1, dt * 12))
	else
		hum.AutoRotate = livre or estado.local_ == "beber"
	end

	-- impulsos (esquiva, avanço do golpe, empurrão)
	local vel = nil
	if estado.empurraoAte and t < estado.empurraoAte then
		vel = estado.empurraoVel
	elseif estado.local_ == "rolar" then
		local k = (t - estado.desde) / J.durRolar
		local v = if estado.rolTras then (if k < 0.5 then 22 else 4) else (if k < 0.62 then 30 elseif k < 0.85 then 11 else 3)
		vel = estado.dirRolar * v
	elseif estado.local_ == "ataque" and estado.golpe then
		local tt = t - estado.desde
		if tt > estado.golpe.ini - 0.12 and tt < estado.golpe.ini + 0.06 then
			local perto = raizA and (raizA.Position - raiz.Position).Magnitude < 7 + (alvo:GetAttribute("Escala") or 1) * 2
			local v = if perto then 0 elseif estado.golpeForte then 13 else 10
			local lv = raiz.CFrame.LookVector
			vel = Vector3.new(lv.X, 0, lv.Z).Unit * v
		else
			vel = Vector3.zero
		end
	elseif estado.local_ == "atordoado" then
		vel = Vector3.zero
	end
	if vel then
		imp.Enabled = true
		imp.PlaneVelocity = Vector2.new(vel.X, vel.Z)
	else
		imp.Enabled = false
	end

	-- planar e correntes de vento
	local zona, topo = correnteEm(raiz.Position)
	local v = raiz.AssemblyLinearVelocity
	if zona then
		local alvoVy = if raiz.Position.Y < topo then 70 else 8
		raiz.AssemblyLinearVelocity = Vector3.new(v.X, v.Y + (alvoVy - v.Y) * math.min(1, dt * 4), v.Z)
		v = raiz.AssemblyLinearVelocity
		if hum:GetState() ~= Enum.HumanoidStateType.Freefall then
			hum:ChangeState(Enum.HumanoidStateType.Freefall)
		end
	end
	if estado.planando then
		if not noAr(hum) then
			definirPlanar(false)
		else
			local desejo = direcaoDesejada(hum)
			local frente = Vector3.new(raiz.CFrame.LookVector.X, 0, raiz.CFrame.LookVector.Z)
			local dirH = if desejo.Magnitude > 0.1 then desejo.Unit else frente.Unit
			local h = Vector3.new(v.X, 0, v.Z):Lerp(dirH * 34, math.min(1, dt * 2.5))
			local vy = if zona then v.Y else math.max(v.Y, -9)
			raiz.AssemblyLinearVelocity = Vector3.new(h.X, vy, h.Z)
			hum.AutoRotate = false
			if h.Magnitude > 1 then
				raiz.CFrame = raiz.CFrame:Lerp(CFrame.lookAt(raiz.Position, raiz.Position + h), math.min(1, dt * 6))
			end
		end
	end
	if not noAr(hum) then
		estado.saltoT = estado.saltoT or t
	end
end

function Controles.iniciar(est, remotos, camara)
	estado = est
	R = remotos
	Camara = camara
	ligarAcoes()
	RunService.Heartbeat:Connect(atualizar)
end

function Controles.reiniciar()
	pendente = nil
	combo = 0
	shiftDesde = nil
	impulso = nil
	estado.planando = false
	estado.correndo = false
	estado.bloqueando = false
	estado.acao = nil
end

return Controles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Efeitos</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Efeitos visuais no cliente: impactos, faíscas, ondas de choque, avisos de raio, relâmpagos,
-- cura, Éter, morte de inimigos e o ambiente da tempestade.

local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Compartilhado"):WaitForChild("Config"))

local Efeitos = {}
local Camara
local pasta

local TEX = {
	brilho = "rbxasset://textures/particles/sparkles_main.dds",
	fumo = "rbxasset://textures/particles/smoke_main.dds",
	fogo = "rbxasset://textures/particles/fire_main.dds",
}

local function ancora(pos)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.Position = pos
	p.Parent = pasta
	return p
end

local function rajada(pos, props, n, vida)
	local p = ancora(pos)
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.Texture = props.textura or TEX.brilho
	e.Color = ColorSequence.new(props.cor or Color3.new(1, 1, 1), props.cor2 or props.cor or Color3.new(1, 1, 1))
	e.LightEmission = props.luz or 0.8
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, props.tam or 0.5), NumberSequenceKeypoint.new(1, (props.tam or 0.5) * (props.tamFim or 0.3)) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, props.transp or 0), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new((props.vida or 0.5) * 0.6, props.vida or 0.5)
	e.Speed = NumberRange.new((props.vel or 10) * 0.4, props.vel or 10)
	e.SpreadAngle = Vector2.new(props.espalhar or 180, props.espalhar or 180)
	e.Acceleration = props.gravidade or Vector3.new(0, -20, 0)
	e.Drag = props.atrito or 2
	e.EmissionDirection = props.direcao or Enum.NormalId.Top
	e.Parent = p
	e:Emit(n)
	Debris:AddItem(p, vida or 3)
	return p
end

local function anel(pos, raioMax, dur, cor, neon)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.Color = cor
	p.Transparency = 0.25
	p.Size = Vector3.new(0.4, 1, 1)
	p.CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = pasta
	TweenService:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.4, raioMax * 2, raioMax * 2), Transparency = 1,
	}):Play()
	Debris:AddItem(p, dur + 0.1)
end

local function som(pos, id, volume, tom)
	local p = ancora(pos)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.PlaybackSpeed = tom or 1
	s.RollOffMaxDistance = 200
	s.Parent = p
	s:Play()
	Debris:AddItem(p, 4)
end

local function distanciaAoJogador(pos)
	local c = Players.LocalPlayer.Character
	local raiz = c and c:FindFirstChild("HumanoidRootPart")
	if not raiz then
		return math.huge
	end
	return (raiz.Position - pos).Magnitude
end

-- relâmpago: segmentos de néon do céu até ao chão
local function relampago(pos)
	local topo = pos + Vector3.new(math.random(-20, 20), 140, math.random(-20, 20))
	local anterior = topo
	local n = 9
	for i = 1, n do
		local k = i / n
		local p = topo:Lerp(pos, k)
		if i < n then
			p += Vector3.new(math.random(-60, 60) / 10, 0, math.random(-60, 60) / 10)
		end
		local seg = Instance.new("Part")
		seg.Anchored = true
		seg.CanCollide = false
		seg.CanQuery = false
		seg.Material = Enum.Material.Neon
		seg.Color = Color3.fromRGB(200, 235, 255)
		local comp = (p - anterior).Magnitude
		seg.Size = Vector3.new(0.6, 0.6, comp)
		seg.CFrame = CFrame.lookAt((p + anterior) / 2, p)
		seg.Parent = pasta
		TweenService:Create(seg, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		Debris:AddItem(seg, 0.4)
		anterior = p
	end
	local luz = ancora(pos + Vector3.new(0, 6, 0))
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(190, 225, 255)
	l.Range = 60
	l.Brightness = 8
	l.Parent = luz
	TweenService:Create(l, TweenInfo.new(0.4), { Brightness = 0 }):Play()
	Debris:AddItem(luz, 0.5)
	rajada(pos, { cor = Color3.fromRGB(200, 235, 255), vel = 30, vida = 0.5, tam = 0.6 }, 30)
	som(pos, "rbxasset://sounds/electronicpingshort.wav", 0.8, 0.35)
	local d = distanciaAoJogador(pos)
	if d < 120 then
		Camara.tremer(0.5 * (1 - d / 120))
		local cc = Lighting:FindFirstChild("Cor")
		if cc and cc:IsA("ColorCorrectionEffect") then
			cc.Brightness = 0.35
			TweenService:Create(cc, TweenInfo.new(0.35), { Brightness = 0 }):Play()
		end
	end
end
Efeitos.relampago = relampago

function Efeitos.tratar(tipo, pos, a, b, c)
	if typeof(pos) ~= "Vector3" then
		return
	end
	if distanciaAoJogador(pos) > 500 then
		return
	end
	if tipo == "golpe" then
		local cores = {
			carne = Color3.fromRGB(120, 20, 20), eter = Color3.fromRGB(170, 120, 255), pedra = Color3.fromRGB(170, 160, 140), vento = Color3.fromRGB(220, 240, 255),
		}
		rajada(pos, { cor = cores[a] or cores.eter, vel = 18, vida = 0.45, tam = 0.45, luz = if a == "carne" then 0 else 0.6 }, 16)
		rajada(pos, { cor = Color3.fromRGB(255, 245, 220), vel = 0, vida = 0.12, tam = 3, tamFim = 1 }, 1)
		som(pos, "rbxasset://sounds/swordslash.wav", 0.35, 0.6)
	elseif tipo == "faisca" then
		rajada(pos, { cor = Color3.fromRGB(255, 200, 120), vel = 30, vida = 0.35, tam = 0.25, gravidade = Vector3.new(0, -60, 0) }, 22)
		rajada(pos, { cor = Color3.fromRGB(255, 240, 200), vel = 0, vida = 0.1, tam = 3.5, tamFim = 1 }, 1)
	elseif tipo == "onda" then
		anel(pos, a or 10, 0.45, if b == "pedra" then Color3.fromRGB(190, 175, 150) else Color3.fromRGB(220, 230, 255), false)
		rajada(pos + Vector3.new(0, 1, 0), { textura = TEX.fumo, cor = Color3.fromRGB(170, 158, 140), vel = 25, vida = 1.2, tam = 6, tamFim = 2.5, transp = 0.3, luz = 0, gravidade = Vector3.new(0, 4, 0), espalhar = 80 }, 18)
	elseif tipo == "anel" then
		anel(pos, a or 30, b or 1, if c == "raio" then Color3.fromRGB(150, 210, 255) else Color3.fromRGB(255, 130, 60), true)
	elseif tipo == "aviso" then
		local raio = a or 9
		local dur = b or 1
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Shape = Enum.PartType.Cylinder
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(150, 200, 255)
		p.Transparency = 0.9
		p.Size = Vector3.new(0.25, raio * 2, raio * 2)
		p.CFrame = CFrame.new(pos + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90))
		p.Parent = pasta
		TweenService:Create(p, TweenInfo.new(dur), { Transparency = 0.35 }):Play()
		Debris:AddItem(p, dur + 0.05)
	elseif tipo == "raio" then
		relampago(pos)
	elseif tipo == "tremor" then
		local d = distanciaAoJogador(pos)
		if d < 120 then
			Camara.tremer((a or 0.5) * (1 - d / 120))
		end
	elseif tipo == "cura" then
		rajada(pos, { cor = Color3.fromRGB(255, 200, 120), cor2 = Color3.fromRGB(160, 255, 200), vel = 6, vida = 1.2, tam = 0.4, gravidade = Vector3.new(0, 10, 0) }, 30)
	elseif tipo == "eter" then
		rajada(pos + Vector3.new(0, 2, 0), { cor = Color3.fromRGB(210, 230, 255), vel = 14, vida = 1.4, tam = 0.4, gravidade = Vector3.new(0, 6, 0) }, 30)
	elseif tipo == "morte" then
		rajada(pos, { textura = TEX.fumo, cor = Color3.fromRGB(80, 70, 100), vel = 8, vida = 1.6, tam = 3, tamFim = 2, transp = 0.4, luz = 0, gravidade = Vector3.new(0, 5, 0) }, 14)
	elseif tipo == "nevoeiro" then
		rajada(pos, { textura = TEX.fumo, cor = Color3.fromRGB(230, 245, 255), vel = 12, vida = 1, tam = 4, transp = 0.3, luz = 0.3, gravidade = Vector3.zero }, 20)
	elseif tipo == "grito" then
		rajada(pos + Vector3.new(0, 4, 0), { cor = Color3.fromRGB(255, 120, 80), vel = 4, vida = 0.6, tam = 0.3 }, 6)
	end
end

-- ambiente local da tempestade quando se está perto do Olho
local function ambienteTempestade()
	local olho
	for _, ilha in Config.ILHAS do
		if ilha.tempestade then
			olho = ilha
		end
	end
	if not olho then
		return
	end
	local proximoRaio = 0
	local cc
	RunService.Heartbeat:Connect(function()
		cc = cc or Lighting:FindFirstChild("Cor")
		local c = Players.LocalPlayer.Character
		local raiz = c and c:FindFirstChild("HumanoidRootPart")
		if not raiz or not cc then
			return
		end
		local d = Vector2.new(raiz.Position.X - olho.centro.X, raiz.Position.Z - olho.centro.Z).Magnitude
		local k = math.clamp(1 - (d - olho.raio) / 220, 0, 1)
		cc.TintColor = Color3.fromRGB(255, 249, 242):Lerp(Color3.fromRGB(170, 180, 210), k)
		cc.Saturation = 0.08 - 0.3 * k
		if k > 0.3 and os.clock() > proximoRaio then
			proximoRaio = os.clock() + math.random(4, 9)
			local a = math.random() * math.pi * 2
			local r = olho.raio * (0.9 + math.random() * 0.8)
			relampago(Vector3.new(olho.centro.X + math.cos(a) * r, olho.centro.Y - 20, olho.centro.Z + math.sin(a) * r))
		end
	end)
end

function Efeitos.iniciar(remotos, camara)
	Camara = camara
	pasta = Instance.new("Folder")
	pasta.Name = "EfeitosLocais"
	pasta.Parent = workspace
	remotos.Efeito.OnClientEvent:Connect(Efeitos.tratar)
	ambienteTempestade()
end

return Efeitos
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Interface: barras de vida e energia, Orvalho, arma, Éter, barra do chefe, faixas de mensagem,
-- nome das ilhas, menu do farol (subir de nível, viajar), inscrições e ajuda dos controlos.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Compartilhado"):WaitForChild("Config"))

local Hud = {}
local jogador = Players.LocalPlayer
local estado
local R
local Controles

local OURO = Color3.fromRGB(226, 200, 140)
local TEXTO = Color3.fromRGB(236, 228, 210)
local FONTE = Enum.Font.Garamond
local FONTE_TITULO = Enum.Font.Fantasy

local gui
local el: { [string]: any } = {}
local chefeModelo = nil
local vidaVisivel = 0
local eterMostrado = 0
local ganho = 0
local ganhoAte = 0

local function novo(classe, props, filhos)
	local o = Instance.new(classe)
	for k, v in props do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	for _, f in filhos or {} do
		f.Parent = o
	end
	if props.Parent then
		o.Parent = props.Parent
	end
	return o
end

local function texto(props)
	local t = novo("TextLabel", {
		BackgroundTransparency = 1, Font = FONTE, TextColor3 = TEXTO, TextScaled = false, TextSize = 20,
		TextStrokeTransparency = 0.6, TextStrokeColor3 = Color3.new(0, 0, 0),
	})
	for k, v in props do
		t[k] = v
	end
	return t
end

local function botao(props)
	local b = novo("TextButton", {
		BackgroundColor3 = Color3.fromRGB(28, 24, 20), BackgroundTransparency = 0.2, BorderSizePixel = 0, AutoButtonColor = true,
		Font = FONTE, TextColor3 = TEXTO, TextSize = 22, Size = UDim2.fromOffset(260, 40), Selectable = true,
	}, { novo("UIStroke", { Color = Color3.fromRGB(120, 100, 64), Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) })
	for k, v in props do
		b[k] = v
	end
	return b
end

local function barra(nome, cor, pai, pos)
	local fundo = novo("Frame", {
		Name = nome, Parent = pai, Position = pos, Size = UDim2.fromOffset(250, 12), BackgroundColor3 = Color3.fromRGB(10, 8, 8),
		BackgroundTransparency = 0.25, BorderSizePixel = 0,
	}, { novo("UIStroke", { Color = Color3.fromRGB(90, 80, 60), Thickness = 1 }) })
	novo("Frame", { Name = "Perda", Parent = fundo, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(232, 214, 160), BorderSizePixel = 0 })
	novo("Frame", { Name = "Valor", Parent = fundo, Size = UDim2.fromScale(1, 1), BackgroundColor3 = cor, BorderSizePixel = 0 }, {
		novo("UIGradient", { Color = ColorSequence.new(cor:Lerp(Color3.new(1, 1, 1), 0.2), cor:Lerp(Color3.new(0, 0, 0), 0.35)), Rotation = 90 }),
	})
	return fundo
end

local function painel(nome, tamanho, posicao)
	return novo("Frame", {
		Name = nome, Parent = gui, Size = tamanho, Position = posicao, AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(12, 10, 9), BackgroundTransparency = 0.12, BorderSizePixel = 0, Visible = false,
	}, {
		novo("UIStroke", { Color = Color3.fromRGB(110, 92, 60), Thickness = 1 }),
		novo("UIPadding", { PaddingLeft = UDim.new(0, 22), PaddingRight = UDim.new(0, 22), PaddingTop = UDim.new(0, 18), PaddingBottom = UDim.new(0, 18) }),
	})
end

local function listaCsv(attr)
	local s = jogador:GetAttribute(attr)
	local r = {}
	if type(s) == "string" and #s > 0 then
		for p in string.gmatch(s, "[^,]+") do
			r[p] = true
		end
	end
	return r
end

-- ---------------------------------------------------------------- mensagens

local function mostrarTexto(rotulo, dur)
	rotulo.TextTransparency = 1
	rotulo.TextStrokeTransparency = 1
	rotulo.Visible = true
	TweenService:Create(rotulo, TweenInfo.new(0.6), { TextTransparency = 0, TextStrokeTransparency = 0.5 }):Play()
	task.delay(dur, function()
		TweenService:Create(rotulo, TweenInfo.new(1.2), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
end

function Hud.aviso(t, dur)
	el.aviso.Text = t
	mostrarTexto(el.aviso, dur or 3)
end

function Hud.faixa(titulo, sub, cor, dur)
	el.faixa.Visible = true
	el.faixaTitulo.Text = titulo
	el.faixaTitulo.TextColor3 = cor or OURO
	el.faixaSub.Text = sub or ""
	el.faixa.BackgroundTransparency = 1
	TweenService:Create(el.faixa, TweenInfo.new(0.8), { BackgroundTransparency = 0.35 }):Play()
	mostrarTexto(el.faixaTitulo, dur or 3.5)
	mostrarTexto(el.faixaSub, dur or 3.5)
	task.delay((dur or 3.5) + 0.2, function()
		TweenService:Create(el.faixa, TweenInfo.new(1.2), { BackgroundTransparency = 1 }):Play()
	end)
end

function Hud.area(nome)
	el.area.Text = nome
	mostrarTexto(el.area, 3)
end

function Hud.fade(v, dur)
	TweenService:Create(el.fade, TweenInfo.new(dur or 0.8), { BackgroundTransparency = if v then 0 else 1 }):Play()
end

local function tratarAviso(tipo, t)
	if tipo == "farol" then
		Hud.faixa("FAROL ACESO", t, Color3.fromRGB(255, 210, 140), 3)
	elseif tipo == "morte" then
		Hud.faixa("MORRESTE", "O teu Éter ficou onde caíste.", Color3.fromRGB(170, 30, 24), 4)
	elseif tipo == "chefe" then
		Hud.faixa("GRANDE INIMIGO ABATIDO", t, OURO, 5)
	elseif tipo == "final" then
		Hud.faixa("O CÉU ESTÁ EM PAZ", "Tempestor caiu. Obrigado por jogares Céu Partido.", OURO, 9)
	elseif tipo == "banner" then
		Hud.faixa(t, "", OURO, 3)
	elseif tipo == "item" then
		Hud.aviso("Obtiveste: " .. t, 4)
	elseif tipo == "eter" then
		local n = tonumber(t) or 0
		ganho = if os.clock() < ganhoAte then ganho + n else n
		ganhoAte = os.clock() + 2.5
	else
		Hud.aviso(t, 3)
	end
end

-- ---------------------------------------------------------------- menu do farol

local function fecharPaineis()
	for _, nome in { "menuFarol", "menuNivel", "menuViajar", "leitura", "ajuda" } do
		el[nome].Visible = false
	end
	GuiService.SelectedObject = nil
end

local function abrir(nome)
	fecharPaineis()
	el[nome].Visible = true
	estado.menu = true
	local primeiro = el[nome]:FindFirstChildWhichIsA("TextButton", true)
	if primeiro and UserInputService.GamepadEnabled then
		GuiService.SelectedObject = primeiro
	end
end

local function fecharTudo()
	fecharPaineis()
	estado.menu = false
end

local function desenharNivel()
	local p = el.menuNivel
	local custo = jogador:GetAttribute("CustoNivel") or 0
	local eter = jogador:GetAttribute("Eter") or 0
	p.Info.Text = string.format("Nível %d     Éter %d     Custo %d", jogador:GetAttribute("Nivel") or 1, eter, custo)
	p.Info.TextColor3 = if eter >= custo then TEXTO else Color3.fromRGB(220, 110, 90)
	for _, a in Config.ATRIBUTOS do
		local linha = p.Lista:FindFirstChild(a.id)
		if linha then
			linha.Valor.Text = tostring(jogador:GetAttribute(string.upper(string.sub(a.id, 1, 1)) .. string.sub(a.id, 2)) or 10)
			linha.Mais.Active = eter >= custo
			linha.Mais.TextTransparency = if eter >= custo then 0 else 0.6
		end
	end
	local hum = jogador.Character and jogador.Character:FindFirstChildOfClass("Humanoid")
	local arma = Config.ARMAS[jogador:GetAttribute("Arma") or Config.ARMA_INICIAL]
	local forca = jogador:GetAttribute("Forca") or 10
	p.Stats.Text = string.format("Vida %d     Energia %d     Dano %d",
		hum and hum.MaxHealth or 0, jogador:GetAttribute("EnergiaMax") or 0, math.floor(arma.dano * (1 + (forca - 10) * arma.escala)))
end

local function desenharViajar()
	local lista = el.menuViajar.Lista
	for _, f in lista:GetChildren() do
		if f:IsA("TextButton") then
			f:Destroy()
		end
	end
	local acesos = listaCsv("Farois")
	for i, f in Config.FAROIS do
		if acesos[f.id] then
			local b = botao({ Text = f.nome .. (if f.id == estado.farolAtual then "  (aqui)" else ""), LayoutOrder = i, Size = UDim2.new(1, 0, 0, 38), Parent = lista })
			b.Activated:Connect(function()
				if f.id == estado.farolAtual then
					return
				end
				fecharPaineis()
				Hud.fade(true, 0.6)
				task.delay(0.7, function()
					R.Menu:FireServer("viajar", f.id)
					task.delay(0.6, function()
						Hud.fade(false, 0.8)
					end)
				end)
			end)
		end
	end
end

function Hud.abrirFarol(id)
	estado.farolAtual = id
	Controles.mudarLocal("sentado")
	for _, f in Config.FAROIS do
		if f.id == id then
			el.menuFarol.Titulo.Text = f.nome
		end
	end
	abrir("menuFarol")
end

local function partir()
	fecharTudo()
	R.Menu:FireServer("partir")
	Controles.mudarLocal("levantar", 1.1)
	Controles.mostrarAcao("levantar", 1.1)
end

-- ---------------------------------------------------------------- construção

local function construir()
	gui = novo("ScreenGui", { Name = "CeuPartidoHud", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = jogador:WaitForChild("PlayerGui") })

	-- barras
	el.hp = barra("Vida", Color3.fromRGB(176, 34, 26), gui, UDim2.fromOffset(34, 34))
	el.en = barra("Energia", Color3.fromRGB(70, 140, 60), gui, UDim2.fromOffset(34, 52))
	el.en.Perda.Visible = false

	-- Orvalho e arma
	el.orvalho = novo("Frame", { Parent = gui, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 34, 1, -40), Size = UDim2.fromOffset(64, 64),
		BackgroundColor3 = Color3.fromRGB(20, 16, 12), BackgroundTransparency = 0.25, BorderSizePixel = 0 }, {
		novo("UIStroke", { Color = Color3.fromRGB(110, 92, 60) }),
		novo("Frame", { Name = "Icone", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(24, 34),
			BackgroundColor3 = Color3.fromRGB(255, 170, 70), BorderSizePixel = 0 }, { novo("UICorner", { CornerRadius = UDim.new(0.5, 0) }) }),
		texto({ Name = "Num", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, 0), Size = UDim2.fromOffset(30, 24), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 22, Text = "3" }),
		texto({ Name = "Nome", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 2), Size = UDim2.fromOffset(150, 20), TextSize = 16, Text = "Orvalho Celeste" }),
	})
	el.arma = texto({ Parent = gui, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 120, 1, -52), Size = UDim2.fromOffset(240, 26), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 20, Text = "" })

	-- Éter
	el.eter = texto({ Parent = gui, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -40, 1, -40), Size = UDim2.fromOffset(240, 34),
		TextXAlignment = Enum.TextXAlignment.Right, TextSize = 28, Font = FONTE_TITULO, Text = "0" })
	el.ganho = texto({ Parent = gui, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -40, 1, -74), Size = UDim2.fromOffset(240, 24),
		TextXAlignment = Enum.TextXAlignment.Right, TextSize = 20, TextColor3 = Color3.fromRGB(200, 220, 255), Text = "" })

	-- chefe
	el.chefe = novo("Frame", { Parent = gui, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -110), Size = UDim2.new(0.6, 0, 0, 46), BackgroundTransparency = 1, Visible = false })
	texto({ Name = "Nome", Parent = el.chefe, Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 24, Font = FONTE_TITULO })
	local bc = barra("Barra", Color3.fromRGB(150, 30, 22), el.chefe, UDim2.fromOffset(0, 30))
	bc.Size = UDim2.new(1, 0, 0, 12)

	-- textos grandes
	el.faixa = novo("Frame", { Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.new(1, 0, 0, 150),
		BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false })
	el.faixaTitulo = texto({ Parent = el.faixa, Size = UDim2.new(1, 0, 0, 90), Position = UDim2.fromOffset(0, 10), TextSize = 72, Font = FONTE_TITULO, TextTransparency = 1 })
	el.faixaSub = texto({ Parent = el.faixa, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 100), TextSize = 24, TextTransparency = 1 })
	el.area = texto({ Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.new(1, 0, 0, 60), TextSize = 44, Font = FONTE_TITULO, TextTransparency = 1 })
	el.aviso = texto({ Parent = gui, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.13), Size = UDim2.new(1, 0, 0, 30), TextSize = 24, TextTransparency = 1 })
	el.fade = novo("Frame", { Parent = gui, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 50 })

	-- menu do farol
	el.menuFarol = painel("MenuFarol", UDim2.fromOffset(320, 250), UDim2.new(0, 220, 0.5, 0))
	texto({ Name = "Titulo", Parent = el.menuFarol, Size = UDim2.new(1, 0, 0, 34), TextSize = 26, Font = FONTE_TITULO, TextColor3 = OURO, Text = "Farol" })
	local lf = novo("Frame", { Name = "Botoes", Parent = el.menuFarol, Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 1, -50), BackgroundTransparency = 1 }, {
		novo("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local bNivel = botao({ Text = "Subir de nível", LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 42), Parent = lf })
	local bViajar = botao({ Text = "Viajar", LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 42), Parent = lf })
	local bPartir = botao({ Text = "Partir", LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 42), Parent = lf })
	bNivel.Activated:Connect(function()
		desenharNivel()
		abrir("menuNivel")
	end)
	bViajar.Activated:Connect(function()
		desenharViajar()
		abrir("menuViajar")
	end)
	bPartir.Activated:Connect(partir)

	-- subir de nível
	el.menuNivel = painel("MenuNivel", UDim2.fromOffset(520, 360), UDim2.fromScale(0.5, 0.5))
	texto({ Parent = el.menuNivel, Size = UDim2.new(1, 0, 0, 34), TextSize = 26, Font = FONTE_TITULO, TextColor3 = OURO, Text = "Subir de nível" })
	texto({ Name = "Info", Parent = el.menuNivel, Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 26), TextSize = 21 })
	local lista = novo("Frame", { Name = "Lista", Parent = el.menuNivel, Position = UDim2.fromOffset(0, 80), Size = UDim2.new(1, 0, 0, 170), BackgroundTransparency = 1 }, {
		novo("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, a in Config.ATRIBUTOS do
		local linha = novo("Frame", { Name = a.id, Parent = lista, LayoutOrder = i, Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1 })
		texto({ Parent = linha, Size = UDim2.new(0.6, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 22, Text = a.nome })
		texto({ Parent = linha, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(0.6, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 16,
			TextColor3 = Color3.fromRGB(170, 160, 140), Text = a.descricao })
		texto({ Name = "Valor", Parent = linha, Position = UDim2.new(0.6, 0, 0, 0), Size = UDim2.new(0.2, 0, 0, 40), TextSize = 26, Text = "10" })
		local mais = botao({ Name = "Mais", Parent = linha, Text = "+", Position = UDim2.new(1, -50, 0, 2), Size = UDim2.fromOffset(46, 38), TextSize = 28 })
		mais.Activated:Connect(function()
			R.Menu:FireServer("subir", a.id)
			task.delay(0.35, desenharNivel)
		end)
	end
	texto({ Name = "Stats", Parent = el.menuNivel, Position = UDim2.new(0, 0, 1, -90), Size = UDim2.new(1, 0, 0, 26), TextSize = 20, TextColor3 = Color3.fromRGB(200, 190, 170) })
	local voltarN = botao({ Parent = el.menuNivel, Text = "Voltar", AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(140, 38) })
	voltarN.Activated:Connect(function()
		abrir("menuFarol")
	end)

	-- viajar
	el.menuViajar = painel("MenuViajar", UDim2.fromOffset(420, 420), UDim2.fromScale(0.5, 0.5))
	texto({ Parent = el.menuViajar, Size = UDim2.new(1, 0, 0, 34), TextSize = 26, Font = FONTE_TITULO, TextColor3 = OURO, Text = "Viajar para…" })
	novo("Frame", { Name = "Lista", Parent = el.menuViajar, Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 1, -100), BackgroundTransparency = 1 }, {
		novo("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local voltarV = botao({ Parent = el.menuViajar, Text = "Voltar", AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(140, 38) })
	voltarV.Activated:Connect(function()
		abrir("menuFarol")
	end)

	-- inscrições
	el.leitura = painel("Leitura", UDim2.fromOffset(560, 230), UDim2.fromScale(0.5, 0.5))
	el.leitura.BackgroundColor3 = Color3.fromRGB(20, 26, 34)
	texto({ Parent = el.leitura, Size = UDim2.new(1, 0, 0, 30), TextSize = 22, Font = FONTE_TITULO, TextColor3 = Color3.fromRGB(150, 215, 255), Text = "Inscrição" })
	texto({ Name = "Texto", Parent = el.leitura, Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 1, -90), TextSize = 24, TextWrapped = true, Font = Enum.Font.Garamond })
	local fecharL = botao({ Parent = el.leitura, Text = "Fechar", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), Size = UDim2.fromOffset(160, 38) })
	fecharL.Activated:Connect(fecharTudo)

	-- ajuda dos controlos
	el.ajuda = painel("Ajuda", UDim2.fromOffset(620, 470), UDim2.fromScale(0.5, 0.5))
	texto({ Parent = el.ajuda, Size = UDim2.new(1, 0, 0, 30), TextSize = 26, Font = FONTE_TITULO, TextColor3 = OURO, Text = "Controlos" })
	local linhas = {
		{ "Mover / saltar", "WASD / Espaço", "Manípulo esq. / A" },
		{ "Planar (no ar)", "Espaço outra vez", "A outra vez" },
		{ "Ataque leve", "Botão esquerdo", "RB" },
		{ "Ataque forte", "F", "RT" },
		{ "Bloquear", "Botão direito", "LB" },
		{ "Esquivar / correr", "Shift (tocar / manter)", "B (tocar / manter)" },
		{ "Orvalho (curar)", "R", "X" },
		{ "Fixar alvo", "Q / botão do meio", "R3" },
		{ "Trocar de arma", "X", "Cruz para cima" },
		{ "Interagir", "E", "Y" },
		{ "Esta ajuda", "H", "—" },
	}
	for i, l in linhas do
		local y = 40 + (i - 1) * 32
		texto({ Parent = el.ajuda, Position = UDim2.fromOffset(0, y), Size = UDim2.new(0.36, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, Text = l[1] })
		texto({ Parent = el.ajuda, Position = UDim2.new(0.36, 0, 0, y), Size = UDim2.new(0.34, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = OURO, Text = l[2] })
		texto({ Parent = el.ajuda, Position = UDim2.new(0.7, 0, 0, y), Size = UDim2.new(0.3, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = OURO, Text = l[3] })
	end
	local fecharA = botao({ Parent = el.ajuda, Text = "Fechar", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), Size = UDim2.fromOffset(160, 38) })
	fecharA.Activated:Connect(fecharTudo)

	-- mira do alvo fixo
	el.mira = novo("BillboardGui", { Name = "Mira", Parent = gui, Size = UDim2.fromOffset(18, 18), AlwaysOnTop = true, Enabled = false }, {
		novo("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.1, BorderSizePixel = 0 }, {
			novo("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
			novo("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.5, Thickness = 1.5 }),
		}),
	})
end

-- ---------------------------------------------------------------- atualização

local function tamanhoBarra(fundo, larg)
	fundo.Size = UDim2.fromOffset(larg, fundo.Size.Y.Offset)
end

local ultimaIlha = nil
local tIlha = 0
local tPrompts = 0

local function ajustarPrompts()
	-- textos e visibilidade dos prompts conforme o progresso deste jogador
	local acesos = listaCsv("Farois")
	local abertos = listaCsv("Relicarios")
	local mundo = workspace:FindFirstChild("Mundo")
	local inter = mundo and mundo:FindFirstChild("Interativos")
	if inter then
		for _, p in inter:GetDescendants() do
			if p:IsA("ProximityPrompt") then
				local f = p:GetAttribute("Farol")
				local r = p:GetAttribute("Relicario")
				if f then
					p.ActionText = if acesos[f] then "Descansar" else "Acender"
				elseif r then
					p.Enabled = not abertos[r]
					local tampa = p.Parent and p.Parent.Parent and p.Parent.Parent:FindFirstChild("Tampa")
					if tampa and abertos[r] then
						tampa.Transparency = 1
						local brilho = tampa:FindFirstChildWhichIsA("ParticleEmitter")
						if brilho then
							brilho.Enabled = false
						end
					end
				end
			end
		end
	end
	local ecos = workspace:FindFirstChild("Ecos")
	if ecos then
		for _, p in ecos:GetDescendants() do
			if p:IsA("ProximityPrompt") then
				p.Enabled = p:GetAttribute("Dono") == jogador.UserId
			end
		end
	end
end

local function atualizar(dt)
	local c = jogador.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	local vp = workspace.CurrentCamera.ViewportSize
	if hum then
		local larg = math.min(vp.X * 0.45, hum.MaxHealth * 0.62)
		tamanhoBarra(el.hp, larg)
		local f = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
		el.hp.Valor.Size = UDim2.fromScale(f, 1)
		vidaVisivel = if hum.Health > vidaVisivel then hum.Health else vidaVisivel + (hum.Health - vidaVisivel) * math.min(1, dt * 2.5)
		el.hp.Perda.Size = UDim2.fromScale(math.clamp(vidaVisivel / hum.MaxHealth, 0, 1), 1)
	end
	local enMax = jogador:GetAttribute("EnergiaMax") or 100
	tamanhoBarra(el.en, math.min(vp.X * 0.4, enMax * 1.9))
	el.en.Valor.Size = UDim2.fromScale(math.clamp((jogador:GetAttribute("Energia") or 0) / enMax, 0, 1), 1)
	local orv = jogador:GetAttribute("Orvalho") or 0
	el.orvalho.Num.Text = tostring(orv)
	el.orvalho.Icone.BackgroundColor3 = if orv > 0 then Color3.fromRGB(255, 170, 70) else Color3.fromRGB(80, 70, 60)
	local arma = Config.ARMAS[jogador:GetAttribute("Arma") or Config.ARMA_INICIAL]
	el.arma.Text = if arma then arma.nome else ""

	-- Éter a contar
	local eter = jogador:GetAttribute("Eter") or 0
	if eterMostrado ~= eter then
		local d = eter - eterMostrado
		local passo = math.max(1, math.ceil(math.abs(d) * math.min(1, dt * 4)))
		eterMostrado += math.sign(d) * passo
		if math.sign(eter - eterMostrado) ~= math.sign(d) then
			eterMostrado = eter
		end
	end
	el.eter.Text = tostring(eterMostrado)
	el.ganho.Text = if os.clock() < ganhoAte then "+" .. ganho else ""

	-- chefe
	if chefeModelo and chefeModelo.Parent and (chefeModelo:GetAttribute("Vida") or 0) > 0 then
		el.chefe.Visible = true
		el.chefe.Nome.Text = chefeModelo.Name
		local v = chefeModelo:GetAttribute("Vida") or 0
		local m = chefeModelo:GetAttribute("VidaMax") or 1
		el.chefe.Barra.Valor.Size = UDim2.fromScale(math.clamp(v / m, 0, 1), 1)
		local perda = el.chefe.Barra.Perda
		local alvoP = math.clamp(v / m, 0, 1)
		perda.Size = UDim2.fromScale(perda.Size.X.Scale + (alvoP - perda.Size.X.Scale) * math.min(1, dt * 2.5), 1)
	else
		el.chefe.Visible = false
	end

	-- barras dos inimigos (só depois de levarem dano, ou com o alvo fixo)
	local pasta = workspace:FindFirstChild("Inimigos")
	if pasta then
		local agoraS = workspace:GetServerTimeNow()
		for _, m in pasta:GetChildren() do
			local cabeca = m:FindFirstChild("Head")
			local bb = cabeca and cabeca:FindFirstChild("BarraVida")
			if bb then
				local vida = m:GetAttribute("Vida") or 0
				local recente = agoraS - (m:GetAttribute("UltimoDano") or -100) < 4
				bb.Enabled = vida > 0 and not m:GetAttribute("Chefe") and (recente or estado.alvo == m)
				if bb.Enabled then
					local fr = bb:FindFirstChildWhichIsA("Frame")
					local valor = fr and fr:FindFirstChild("Valor")
					if valor then
						valor.Size = UDim2.fromScale(math.clamp(vida / (m:GetAttribute("VidaMax") or 1), 0, 1), 1)
					end
				end
			end
		end
	end

	-- mira
	local alvo = estado.alvo
	local raizA = alvo and alvo:FindFirstChild("UpperTorso")
	el.mira.Adornee = raizA
	el.mira.Enabled = raizA ~= nil

	-- nome da ilha
	tIlha -= dt
	if tIlha <= 0 and c then
		tIlha = 0.5
		local raiz = c:FindFirstChild("HumanoidRootPart")
		if raiz then
			local atual = nil
			for _, ilha in Config.ILHAS do
				local d = Vector2.new(raiz.Position.X - ilha.centro.X, raiz.Position.Z - ilha.centro.Z).Magnitude
				if d < ilha.raio * 1.05 and math.abs(raiz.Position.Y - ilha.centro.Y) < 60 then
					atual = ilha.nome
				end
			end
			if atual and atual ~= ultimaIlha then
				Hud.area(atual)
			end
			if atual then
				ultimaIlha = atual
			end
		end
	end
	tPrompts -= dt
	if tPrompts <= 0 then
		tPrompts = 1
		ajustarPrompts()
	end
end

function Hud.personagemNova(personagem)
	vidaVisivel = 0
	Hud.fade(false, 1.2)
	local hum = personagem:WaitForChild("Humanoid", 10)
	if hum then
		hum.Died:Connect(function()
			estado.alvo = nil
			fecharTudo()
			task.delay(4.6, function()
				Hud.fade(true, 0.9)
			end)
		end)
	end
end

function Hud.iniciar(est, remotos, controles)
	estado = est
	R = remotos
	Controles = controles
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)
	construir()
	R.Aviso.OnClientEvent:Connect(tratarAviso)
	R.Farol.OnClientEvent:Connect(Hud.abrirFarol)
	R.Chefe.OnClientEvent:Connect(function(m)
		chefeModelo = m
		if m then
			el.chefe.Barra.Perda.Size = UDim2.fromScale(1, 1)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt.Name == "Inscricao" then
			el.leitura.Texto.Text = "«" .. tostring(prompt:GetAttribute("Texto")) .. "»"
			abrir("leitura")
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processado)
		if processado then
			return
		end
		if input.KeyCode == Enum.KeyCode.H then
			if el.ajuda.Visible then
				fecharTudo()
			elseif not estado.menu then
				abrir("ajuda")
			end
		elseif input.KeyCode == Enum.KeyCode.ButtonB and estado.menu then
			if el.menuFarol.Visible then
				partir()
			elseif el.menuNivel.Visible or el.menuViajar.Visible then
				abrir("menuFarol")
			else
				fecharTudo()
			end
		end
	end)
	RunService.RenderStepped:Connect(atualizar)
	-- mostra a ajuda na primeira entrada
	task.delay(2, function()
		if not estado.menu then
			abrir("ajuda")
			task.delay(14, function()
				if el.ajuda.Visible then
					fecharTudo()
				end
			end)
		end
	end)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="25">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Céu Partido — arranque do cliente.

local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local jogador = Players.LocalPlayer

-- ecrã de espera enquanto o servidor ergue as ilhas
local espera = Instance.new("ScreenGui")
espera.Name = "Espera"
espera.IgnoreGuiInset = true
espera.DisplayOrder = 100
espera.ResetOnSpawn = false
local fundo = Instance.new("Frame")
fundo.Size = UDim2.fromScale(1, 1)
fundo.BackgroundColor3 = Color3.fromRGB(14, 18, 28)
fundo.BorderSizePixel = 0
fundo.Parent = espera
local titulo = Instance.new("TextLabel")
titulo.BackgroundTransparency = 1
titulo.Size = UDim2.new(1, 0, 0, 90)
titulo.Position = UDim2.fromScale(0, 0.38)
titulo.Font = Enum.Font.Fantasy
titulo.TextSize = 72
titulo.TextColor3 = Color3.fromRGB(226, 200, 140)
titulo.Text = "CÉU PARTIDO"
titulo.Parent = fundo
local sub = Instance.new("TextLabel")
sub.BackgroundTransparency = 1
sub.Size = UDim2.new(1, 0, 0, 30)
sub.Position = UDim2.fromScale(0, 0.52)
sub.Font = Enum.Font.Garamond
sub.TextSize = 24
sub.TextColor3 = Color3.fromRGB(200, 205, 220)
sub.Text = "A erguer as ilhas…"
sub.Parent = fundo
espera.Parent = jogador:WaitForChild("PlayerGui")
pcall(function()
	ReplicatedFirst:RemoveDefaultLoadingScreen()
end)

local pastaRemotos = ReplicatedStorage:WaitForChild("Remotos")
while not ReplicatedStorage:GetAttribute("MundoPronto") do
	task.wait(0.2)
end
local R = {}
for _, r in pastaRemotos:GetChildren() do
	R[r.Name] = r
end

local pastaModulos = script.Parent
local Camara = require(pastaModulos:WaitForChild("Camara"))
local Animador = require(pastaModulos:WaitForChild("Animador"))
local Controles = require(pastaModulos:WaitForChild("Controles"))
local Efeitos = require(pastaModulos:WaitForChild("Efeitos"))
local Hud = require(pastaModulos:WaitForChild("Hud"))

-- estado partilhado entre os módulos do cliente
local estado = {
	local_ = "livre", desde = 0, ate = 0, acao = nil, golpe = nil, menu = false, alvo = nil,
	sensibilidade = 1, inverterY = false, planando = false, correndo = false, bloqueando = false,
}

Camara.iniciar(estado)
Animador.iniciar(estado)
Controles.iniciar(estado, R, Camara)
Efeitos.iniciar(R, Camara)
Hud.iniciar(estado, R, Controles)

R.Impacto.OnClientEvent:Connect(function(dir, forca, tremor)
	if typeof(dir) == "Vector3" and type(forca) == "number" and forca > 0 then
		Controles.empurrar(dir, forca)
	end
	if type(tremor) == "number" then
		Camara.tremer(tremor)
	end
end)

local function aoPersonagem(personagem)
	Controles.reiniciar()
	estado.alvo = nil
	estado.menu = false
	Controles.mudarLocal("levantar", 1.6)
	Hud.personagemNova(personagem)
	local raiz = personagem:WaitForChild("HumanoidRootPart", 10)
	if raiz then
		task.wait()
		local lv = raiz.CFrame.LookVector
		Camara.definirYaw(math.atan2(-lv.X, -lv.Z))
	end
	if espera.Parent then
		espera:Destroy()
	end
end

jogador.CharacterAdded:Connect(aoPersonagem)
if jogador.Character then
	task.spawn(aoPersonagem, jogador.Character)
end
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="26">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-500</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>